#!/usr/bin/env python3
"""needs-you: tell your human they have to do something.

  needs-you add --key KEY --title TITLE [--context work|personal] [--priority urgent|normal|low]
                [--body TEXT | --body-file PATH|-] [--link "Label=https://..."]...
                [--step "Text" | --step "Text=https://..."]... [--steps-json JSON|@PATH]
                [--agent NAME] [--project NAME] [--host NAME] [--kind needs|done|info]
                [--expires-in HOURS]
  needs-you done  --key KEY --title TITLE [...]     same as add --kind done (expires in 24 h)
  needs-you info  --key KEY --title TITLE [...]     same as add --kind info (expires in 24 h)
  needs-you resolve (--key KEY | --id ID)
  needs-you run [--key KEY] [--title TITLE] [--done-after SECONDS] [--no-output] [...] -- CMD [ARGS...]
                                                     run CMD with its output and exit code passed
                                                     through; on failure post a card (exit code and
                                                     the last stderr lines), on success resolve it,
                                                     and after a long run post a `done` FYI
  needs-you flush                                    send anything queued in the outbox, and
                                                     resolve Claude Code cards whose session ended
  needs-you health                                   check each configured hub and the token
  needs-you doctor [--json]                          check config, PATH, hubs, outbox, hooks,
                                                     schedule (read-only; never posts)

Config: ~/.config/needs-you/env (KEY=VALUE lines), overridden by the environment:
  NEEDS_YOU_URLS    comma-separated hub URLs, tried in order (failover); preferred
  NEEDS_YOU_URL     a hub URL (or comma-separated list); used when NEEDS_YOU_URLS is unset
  NEEDS_YOU_TOKEN   this machine's sender token
  NEEDS_YOU_TIMEOUT seconds per hub attempt (default 3)
  NEEDS_YOU_DEFAULT_CONTEXT  work | personal: --context when not given (default work)
  NEEDS_YOU_OUTBOX_MAX       max queued requests kept (default 500)
  NEEDS_YOU_OUTBOX_MAX_DAYS  queued requests older than this are dropped (default 7)

  needs-you update [--check] [--rollback] [--allow-downgrade]
                                                     update the CLI, Claude Code hook (and its
                                                     settings entries), skill and Orca snippet
                                                     installed here, from the hub this machine
                                                     was invited by (the first in NEEDS_YOU_URLS,
                                                     or NEEDS_YOU_UPDATE_HUB; https, loopback or
                                                     tailnet only), sha256-checked against its
                                                     /dl/manifest.json and, with gh, the GitHub
                                                     release. --check only reports. With
                                                     NEEDS_YOU_AUTO_UPDATE=1, `flush` runs it daily,
                                                     and a hub's "update requested" (the Mac app's
                                                     Request update) starts it in the background;
                                                     without it, that request prints a reminder
                                                     to stderr once a day
  needs-you self-update                              same as `update` (the old name)

If no hub answers, the request is written to ~/.local/state/needs-you/outbox/ and the
command still exits 0. Every invocation sends the outbox first. The outbox is capped
(oldest dropped, with a warning), so a hub that is gone for weeks can't fill the disk.

Steps are a checklist of what the person has to do, in order (at most 10; text <= 200
chars, limited markdown). `--step "Text=URL"` gives the step a link button labelled
"Open"; the split is at the first "=" followed by a URL (scheme://, or orca:, slack: ...),
so "Set FOO=bar" stays plain text. `--steps-json` takes the full form,
'[{"text": "...", "link": {"label": "...", "url": "..."}, "done": false}]', inline or
from a file (@PATH); --step entries are appended after it.

Exit codes: 0 sent or queued; 2 the hub rejected the request (bad input, bad token,
volume guard) or usage error; 1 `health` found no healthy hub, or `doctor` found a FAIL.

Python 3.9+ standard library only.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import socket
import sys
import time
import urllib.error
import urllib.request
from typing import Any, Dict, List, Optional, Sequence, Tuple

VERSION = "0.1.2"
OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}))


# ---------------------------------------------------------------------------
# Config and paths
# ---------------------------------------------------------------------------

def config_path() -> str:
    if os.environ.get("NEEDS_YOU_CONFIG"):
        return os.environ["NEEDS_YOU_CONFIG"]
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return os.path.join(base, "needs-you", "env")


def outbox_dir() -> str:
    if os.environ.get("NEEDS_YOU_OUTBOX"):
        return os.environ["NEEDS_YOU_OUTBOX"]
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
    return os.path.join(base, "needs-you", "outbox")


def read_env_file(path: str) -> Dict[str, str]:
    out: Dict[str, str] = {}
    try:
        with open(path, "r", encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                if line.startswith("export "):
                    line = line[len("export "):].strip()
                k, v = line.split("=", 1)
                v = v.strip()
                if len(v) >= 2 and v[0] == v[-1] and v[0] in "'\"":
                    v = v[1:-1]
                out[k.strip()] = v
    except OSError:
        pass
    return out


class Config:
    def __init__(self) -> None:
        f = read_env_file(config_path())
        get = lambda k, d="": os.environ.get(k) or f.get(k) or d  # noqa: E731
        # Precedence: env NEEDS_YOU_URLS, env NEEDS_YOU_URL, file NEEDS_YOU_URLS, file NEEDS_YOU_URL.
        raw = (os.environ.get("NEEDS_YOU_URLS") or os.environ.get("NEEDS_YOU_URL")
               or f.get("NEEDS_YOU_URLS") or f.get("NEEDS_YOU_URL") or "")
        self.urls = [u.strip().rstrip("/") for u in raw.split(",") if u.strip()]
        self.token = get("NEEDS_YOU_TOKEN")
        try:
            self.timeout = float(get("NEEDS_YOU_TIMEOUT", "3"))
        except ValueError:
            self.timeout = 3.0
        self.host = get("NEEDS_YOU_HOST") or socket.gethostname().split(".")[0]
        ctx = get("NEEDS_YOU_DEFAULT_CONTEXT", "work").strip().lower()
        self.default_context = ctx if ctx in ("work", "personal") else "work"

    @property
    def ok(self) -> bool:
        return bool(self.urls and self.token)


def warn(msg: str) -> None:
    sys.stderr.write("needs-you: %s\n" % msg)


def clean(value: Any) -> str:
    """Text a hub sent us, made safe to print: control characters (terminal escape
    sequences included) and bidi overrides shown as \\x.. / \\u.... instead of acting."""
    out = []
    for c in str(value):
        o = ord(c)
        if o < 0x20 or 0x7f <= o < 0xa0:
            out.append("\\x%02x" % o)
        elif 0x202a <= o <= 0x202e or 0x2066 <= o <= 0x2069:
            out.append("\\u%04x" % o)
        else:
            out.append(c)
    return "".join(out)


# ---------------------------------------------------------------------------
# HTTP with failover
# ---------------------------------------------------------------------------

class Unreachable(Exception):
    pass


class Rejected(Exception):
    def __init__(self, status: int, body: Dict[str, Any]) -> None:
        super().__init__("%s %s" % (status, clean(body.get("message") or body.get("error") or "")))
        self.status = status
        self.body = body


def _call(url: str, token: str, method: str, path: str, body: Optional[Dict[str, Any]],
          timeout: float) -> Tuple[int, Dict[str, Any]]:
    data = json.dumps(body).encode("utf-8") if body is not None else None
    req = urllib.request.Request(url + path, data=data, method=method)
    if token:
        req.add_header("Authorization", "Bearer " + token)
    req.add_header("Accept", "application/json")
    req.add_header("User-Agent", "needs-you-cli/" + VERSION)
    req.add_header("X-Needs-You-Client", client_header())
    if data is not None:
        req.add_header("Content-Type", "application/json")
    try:
        with OPENER.open(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8") or "{}"
            return resp.status, json.loads(raw)
    except urllib.error.HTTPError as e:
        try:
            parsed = json.loads(e.read().decode("utf-8") or "{}")
        except ValueError:
            parsed = {}
        return e.code, parsed if isinstance(parsed, dict) else {}


# ---------------------------------------------------------------------------
# Installed pieces and their versions
# ---------------------------------------------------------------------------

def _home(*parts: str) -> str:
    return os.path.join(os.path.expanduser("~"), *parts)


def installed_paths() -> Dict[str, str]:
    """Where each /dl file lives on this machine, if it is installed here (the CLI always)."""
    conf = os.path.dirname(config_path())
    return {
        "needs-you": cli_path(),
        "needs-you-hook.sh": _home(".claude", "hooks", "needs-you-hook.sh"),
        "SKILL.md": _home(".claude", "skills", "needs-you", "SKILL.md"),
        "orca-snippet.md": os.path.join(conf, "orca-snippet.md"),
    }


def cli_path() -> str:
    return os.path.realpath(sys.argv[0] if sys.argv and sys.argv[0] else __file__)


def _stamp(path: str) -> Optional[str]:
    """The version stamp in an installed file ("needs-you-version: X.Y.Z"), "unknown" for a
    file from before stamps, None when it isn't installed."""
    import re
    try:
        with open(path, "rb") as fh:
            head = fh.read(4096).decode("utf-8", "replace")
    except OSError:
        return None
    m = re.search(r'needs[-_]you[-_]version"?\s*:\s*"?(\d+\.\d+\.\d+)', head)
    return m.group(1) if m else "unknown"


_CLIENT_HEADER: Optional[str] = None


def client_header() -> str:
    """X-Needs-You-Client: what this machine runs, so the owner sees who is behind."""
    global _CLIENT_HEADER
    if _CLIENT_HEADER is None:
        paths = installed_paths()
        parts = ["cli=" + (VERSION if _vtuple(VERSION) else "unknown")]
        for name, key in (("needs-you-hook.sh", "hook"), ("SKILL.md", "skill"), ("orca-snippet.md", "orca")):
            parts.append("%s=%s" % (key, _stamp(paths[name]) or "none"))
        _CLIENT_HEADER = "; ".join(parts)
    return _CLIENT_HEADER


def _vtuple(v: Any) -> Optional[Tuple[int, int, int]]:
    import re
    m = re.match(r"^(\d+)\.(\d+)\.(\d+)", str(v or ""))
    return (int(m.group(1)), int(m.group(2)), int(m.group(3))) if m else None


def _sha256_file(path: str) -> Optional[str]:
    try:
        with open(path, "rb") as fh:
            return hashlib.sha256(fh.read()).hexdigest()
    except OSError:
        return None


# The hub URL (from this machine's config) whose response said `update_requested`, if any.
_UPDATE_REQUESTED_BY: Optional[str] = None


def send(cfg: Config, method: str, path: str, body: Optional[Dict[str, Any]]) -> Tuple[str, int, Dict[str, Any]]:
    """Try each hub in order. 2xx -> result. 4xx -> Rejected (no failover: every hub
    would say the same), except 421. Network errors, timeouts, 421 and 5xx -> next hub;
    none -> Unreachable."""
    errors = []
    for url in cfg.urls:
        try:
            status, parsed = _call(url, cfg.token, method, path, body, cfg.timeout)
        except (OSError, ValueError) as e:  # URLError, timeouts, refused, bad JSON
            errors.append("%s: %s" % (url, getattr(e, "reason", e)))
            continue
        if 200 <= status < 300:
            if parsed.get("update_requested") is True:
                global _UPDATE_REQUESTED_BY
                _UPDATE_REQUESTED_BY = url
            return url, status, parsed
        # 421: that hub doesn't answer to this URL's host name (its DNS-rebinding check);
        # a URL problem, not a request problem, so the next hub may well take it.
        if 400 <= status < 500 and status != 421:
            raise Rejected(status, parsed)
        errors.append("%s: HTTP %d" % (url, status))
    raise Unreachable("; ".join(errors) or "no hub URL configured")


# ---------------------------------------------------------------------------
# Outbox
# ---------------------------------------------------------------------------

def queue(method: str, path: str, body: Optional[Dict[str, Any]]) -> str:
    d = outbox_dir()
    os.makedirs(d, mode=0o700, exist_ok=True)
    name = "%020d-%05d.json" % (time.time_ns(), os.getpid() % 100000)
    tmp = os.path.join(d, "." + name + ".tmp")
    entry = {"method": method, "path": path, "body": body,
             "queued_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump(entry, fh)
    final = os.path.join(d, name)
    os.replace(tmp, final)
    prune()
    return final


def _env_number(name: str, default: float) -> float:
    try:
        return float(os.environ.get(name) or default)
    except ValueError:
        return default


def _prune_dir(d: str, max_files: int, max_age_s: float) -> int:
    """Drop entries older than max_age_s, then the oldest beyond max_files. Names start
    with time_ns, so sorting by name is oldest first. Returns how many were dropped."""
    try:
        names = sorted(n for n in os.listdir(d) if n.endswith(".json") and not n.startswith("."))
    except OSError:
        return 0
    cutoff_ns = (time.time() - max_age_s) * 1e9
    drop = []
    keep = []
    for n in names:
        try:
            ts = int(n.split("-", 1)[0])
        except ValueError:  # not our naming: judge it by its mtime instead
            try:
                ts = int(os.path.getmtime(os.path.join(d, n)) * 1e9)
            except OSError:
                continue
        (drop if ts < cutoff_ns else keep).append(n)
    if len(keep) > max_files:
        drop += keep[:len(keep) - max_files]
    for n in drop:
        try:
            os.remove(os.path.join(d, n))
        except OSError:
            pass
    return len(drop)


def prune() -> int:
    max_files = int(_env_number("NEEDS_YOU_OUTBOX_MAX", 500))
    max_age = _env_number("NEEDS_YOU_OUTBOX_MAX_DAYS", 7) * 86400
    d = outbox_dir()
    dropped = _prune_dir(d, max_files, max_age)
    _prune_dir(os.path.join(d, "failed"), min(max_files, 100), max_age)
    if dropped:
        warn("outbox over its cap (%d requests / %g days): dropped the %d oldest"
             % (max_files, max_age / 86400, dropped))
    return dropped


def pending() -> List[str]:
    d = outbox_dir()
    try:
        names = sorted(n for n in os.listdir(d) if n.endswith(".json") and not n.startswith("."))
    except OSError:
        return []
    return [os.path.join(d, n) for n in names]


def _lock():  # type: ignore[no-untyped-def]
    """Non-blocking exclusive lock on the outbox, so two invocations don't double-send."""
    d = outbox_dir()
    try:
        os.makedirs(d, mode=0o700, exist_ok=True)
        import fcntl
        fh = open(os.path.join(d, ".lock"), "a")
        try:
            fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            fh.close()
            return None
        return fh
    except (OSError, ImportError):
        return None


def flush(cfg: Config, verbose: bool = False) -> Tuple[int, int, int]:
    """Send queued entries oldest first. Stops at the first unreachable attempt.
    Returns (sent, dropped, remaining)."""
    files = pending()
    if files:
        prune()
        files = pending()
    if not files or not cfg.ok:
        return 0, 0, len(files)
    lock = _lock()
    if lock is None:
        return 0, 0, len(pending())
    sent = dropped = 0
    try:
        for path in pending():
            try:
                with open(path, "r", encoding="utf-8") as fh:
                    entry = json.load(fh)
            except (OSError, ValueError):
                _move_failed(path)
                dropped += 1
                continue
            try:
                url, _status, _body = send(cfg, entry["method"], entry["path"], entry.get("body"))
                os.remove(path)
                sent += 1
                if verbose:
                    warn("sent queued %s %s via %s" % (entry["method"], entry["path"], url))
            except Rejected as e:
                if e.status == 404 and entry["path"].endswith("/resolve"):
                    os.remove(path)  # nothing open with that key: the resolve is moot
                    sent += 1
                    continue
                warn("hub rejected a queued request (%s); moved it to outbox/failed/" % e)
                _move_failed(path)
                dropped += 1
            except Unreachable:
                break
    finally:
        lock.close()
    return sent, dropped, len(pending())


# ---------------------------------------------------------------------------
# Claude Code hook leases
# ---------------------------------------------------------------------------

def leases_dir() -> str:
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
    return os.path.join(base, "needs-you", "claude-hooks")


def _read_lease(path: str) -> Dict[str, str]:
    out: Dict[str, str] = {}
    try:
        with open(path, "r", encoding="utf-8") as fh:
            for line in fh:
                k, sep, v = line.rstrip("\n").partition("=")
                if sep:
                    out[k] = v
    except (OSError, UnicodeDecodeError):
        pass
    return out


def _process_start(pid: int) -> Optional[str]:
    """The process's start time as `ps -o lstart=` prints it (the hook records the
    same), "" if there is no such process, None if we can't tell."""
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return ""
    except PermissionError:
        pass  # alive, owned by someone else
    except OSError:
        return None
    import subprocess
    try:
        r = subprocess.run(["ps", "-o", "lstart=", "-p", str(pid)], stdin=subprocess.DEVNULL,
                           capture_output=True, text=True, timeout=5,
                           env=dict(os.environ, LC_ALL="C"))
    except (OSError, subprocess.SubprocessError):
        return None
    return " ".join(r.stdout.split())


def reap_leases(cfg: Config, verbose: bool = False) -> int:
    """Resolve the card of every hook lease whose Claude process is gone (or whose pid
    now belongs to a newer process). The hook writes one marker per session:
    key=, pid=, start=. Markers without a pid (older hooks) are left alone."""
    d = leases_dir()
    try:
        names = sorted(n for n in os.listdir(d) if not n.startswith("."))
    except OSError:
        return 0
    reaped = 0
    for name in names:
        path = os.path.join(d, name)
        lease = _read_lease(path)
        key, pid, start = lease.get("key", ""), lease.get("pid", ""), lease.get("start", "")
        if not key.startswith("agent:") or not pid.isdigit() or not start:
            continue
        now_start = _process_start(int(pid))
        if now_start is None or now_start == " ".join(start.split()):
            continue  # alive, or unknown: leave it
        if _read_lease(path) != lease:
            continue  # the hook just re-posted from a new session
        try:
            os.remove(path)
        except OSError:
            continue
        deliver(cfg, "POST", "/v1/items/resolve", {"key": key}, True, False)
        reaped += 1
        if verbose:
            warn("session %s ended; resolved %s" % (pid, key))
    return reaped


def _move_failed(path: str) -> None:
    d = os.path.join(os.path.dirname(path), "failed")
    os.makedirs(d, mode=0o700, exist_ok=True)
    try:
        os.replace(path, os.path.join(d, os.path.basename(path)))
    except OSError:
        pass


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

def deliver(cfg: Config, method: str, path: str, body: Dict[str, Any], quiet: bool,
            as_json: bool) -> int:
    if not cfg.ok:
        f = queue(method, path, body)
        warn("NEEDS_YOU_URLS / NEEDS_YOU_TOKEN not set (%s); queued %s" % (config_path(), f))
        return 0
    try:
        url, status, resp = send(cfg, method, path, body)
    except Unreachable as e:
        f = queue(method, path, body)
        warn("no hub reachable (%s); queued %s" % (e, os.path.basename(f)))
        return 0
    except Rejected as e:
        if e.status == 404 and path.endswith("/resolve"):
            if not quiet:
                warn("nothing open with that key/id (already resolved?)")
            return 0
        warn("hub rejected the request: HTTP %d %s" % (e.status, clean(e.body.get("message") or e.body.get("error") or "")))
        return 2
    if as_json:
        print(json.dumps(resp, sort_keys=True))
    elif not quiet:
        if path.endswith("/resolve"):
            ids = [clean(i.get("id")) for i in resp.get("items", [])]
            if ids:
                print("resolved %s via %s" % (", ".join(ids), url))
            else:
                print("nothing open to resolve (already resolved?) via %s" % url)
        else:
            state = "created" if resp.get("created") else ("updated" if resp.get("changed") else "unchanged")
            print("%s %s via %s" % (state, clean(resp.get("id")), url))
    return 0


def parse_link(raw: str) -> Dict[str, str]:
    """'Label=URL'. A bare URL (or one whose only '=' is in its query) gets the label 'Link'."""
    label, sep, url = raw.partition("=")
    if not sep or "://" in label or not label.strip():
        return {"label": "Link", "url": raw.strip()}
    return {"label": label.strip(), "url": url.strip()}


MAX_STEPS = 10
# Where a step's URL starts: "=" then scheme:// or one of the hub's schemes (the hub
# enforces the allow-list; this only finds the split).
_STEP_URL_RE = re.compile(r"=\s*(?=(?:[A-Za-z][A-Za-z0-9+.-]*://|(?:https|slack|vscode|cursor|figma"
                          r"|msteams|discord|linear|needsyou):\S))", re.I)


def parse_step(raw: str) -> Dict[str, Any]:
    """'Text' or 'Text=URL'. Splits at the first '=' that starts a URL, so '=' in the text
    (and in the URL's query) is kept."""
    m = _STEP_URL_RE.search(raw)
    if not m:
        return {"text": raw.strip()}
    return {"text": raw[:m.start()].strip(), "link": {"label": "Open", "url": raw[m.end():].strip()}}


def parse_steps_json(raw: str) -> List[Any]:
    if raw.startswith("@"):
        with open(raw[1:], "r", encoding="utf-8") as fh:
            raw = fh.read()
    steps = json.loads(raw)
    if not isinstance(steps, list):
        raise ValueError("must be a JSON array")
    return steps


def build_item(args: argparse.Namespace, cfg: Config, kind: str) -> Dict[str, Any]:
    body = args.body
    if args.body_file:
        if args.body_file == "-":
            body = sys.stdin.read()
        else:
            with open(args.body_file, "r", encoding="utf-8") as fh:
                body = fh.read()
    item: Dict[str, Any] = {"key": args.key, "title": args.title, "kind": kind,
                            "context": args.context or cfg.default_context, "priority": args.priority}
    if body:
        item["body"] = body
    if args.link:
        item["links"] = args.link
    steps = list(args.steps_json or []) + list(args.step or [])
    if steps:
        item["steps"] = steps
    source = {"host": args.host or cfg.host}
    if args.agent:
        source["agent"] = args.agent
    if args.project:
        source["project"] = args.project
    item["source"] = source
    if args.expires_in is not None:
        exp = time.time() + args.expires_in * 3600
        item["expires_at"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(exp))
    return item


def main(argv: Optional[List[str]] = None) -> int:
    global _QUIET
    _QUIET = False
    code = _main(argv)
    if _UPDATE_REQUESTED_BY:
        on_update_requested(_UPDATE_REQUESTED_BY, _QUIET)
    return code


_QUIET = False


def _main(argv: Optional[List[str]] = None) -> int:
    global _QUIET
    p = argparse.ArgumentParser(prog="needs-you", description=__doc__.split("\n")[0],
                                epilog="See docs/AGENT-GUIDE.md for when and how to post.")
    p.add_argument("--version", action="version", version="needs-you " + VERSION)
    p.add_argument("-q", "--quiet", action="store_true", help="no output on success")
    p.add_argument("--json", action="store_true", help="print the hub's JSON response")
    sub = p.add_subparsers(dest="cmd")

    def item_parser(name: str, help_: str, aliases: Sequence[str] = ()) -> argparse.ArgumentParser:
        sp = sub.add_parser(name, help=help_, aliases=list(aliases))
        sp.add_argument("--key", required=True, help="stable dedupe key, e.g. work:ACME-123:redo-blocked")
        sp.add_argument("--title", required=True, help="the action needed, <= 100 chars")
        sp.add_argument("--body", help="markdown, <= 2000 chars")
        sp.add_argument("--body-file", help="read the body from a file ('-' for stdin)")
        sp.add_argument("--context", choices=("work", "personal"), default=None,
                        help="default: $NEEDS_YOU_DEFAULT_CONTEXT, else work")
        sp.add_argument("--priority", choices=("urgent", "normal", "low"), default="normal")
        sp.add_argument("--link", action="append", type=parse_link, metavar="LABEL=URL",
                        help="repeatable, at most 6")
        sp.add_argument("--step", action="append", type=parse_step, metavar="TEXT[=URL]",
                        help="a step the person has to do, in order; repeatable, at most %d" % MAX_STEPS)
        sp.add_argument("--steps-json", metavar="JSON|@PATH",
                        help='steps as a JSON array of {"text", "link": {"label", "url"}, "done"}')
        sp.add_argument("--agent", help="source agent, e.g. orca:redo-fixer")
        sp.add_argument("--project", help="source project")
        sp.add_argument("--host", help="source host (default: this machine's hostname)")
        sp.add_argument("--expires-in", type=float, metavar="HOURS",
                        help="expiry (done/info default to 24 h on the hub)")
        if name == "add":
            sp.add_argument("--kind", choices=("needs", "done", "info"), default="needs")
        return sp

    item_parser("add", "add or update an item (kind needs by default)", aliases=("post",))
    item_parser("done", "FYI: something finished (expires in 24 h, never counted)")
    item_parser("info", "FYI: information (expires in 24 h, never counted)")
    rp = sub.add_parser("resolve", help="mark an item handled")
    g = rp.add_mutually_exclusive_group(required=True)
    g.add_argument("--key")
    g.add_argument("--id")
    add_run_parser(sub)
    sub.add_parser("flush", help="send queued items now")
    sub.add_parser("health", help="check hubs and token")
    for name in ("update", "self-update"):
        up = sub.add_parser(name, help="update the CLI, hook, skill and Orca snippet installed here from the first hub that answers"
                            if name == "update" else "same as update")
        up.add_argument("--check", action="store_true", help="report what would change; change nothing")
        up.add_argument("--auto", action="store_true",
                        help="quiet, never fails (what flush runs once a day with NEEDS_YOU_AUTO_UPDATE=1)")
        up.add_argument("--rollback", action="store_true", help="put back the files the last update replaced")
        up.add_argument("--allow-downgrade", action="store_true", help="install the hub's files even if they're older")
    dp = sub.add_parser("doctor", help="check this machine's setup (read-only; never posts)")
    dp.add_argument("--json", dest="doctor_json", action="store_true",
                    help="machine-readable: {ok, version, checks: [{check, status, detail, hint}]}")

    args = p.parse_args(argv)
    if args.cmd == "post":  # the docs say "post an item"; agents guess it
        args.cmd = "add"
    _QUIET = bool(args.quiet or args.json)
    if not args.cmd:
        p.print_help()
        return 2
    cfg = Config()
    if args.cmd in ("update", "self-update"):
        if args.rollback:
            return rollback(args.quiet, args.json)
        return update(cfg, check=args.check, auto=args.auto, quiet=args.quiet or args.auto, as_json=args.json,
                      allow_downgrade=args.allow_downgrade)
    if args.cmd == "doctor":  # before the flush below: doctor changes nothing
        return doctor(cfg, args.json or args.doctor_json)
    if args.cmd == "run":  # the command starts at once; the outbox is sent after it
        return run_command(cfg, args)

    # Every invocation drains the outbox first, so queued items go out in order.
    sent, dropped, remaining = flush(cfg, verbose=not args.quiet and args.cmd == "flush")

    if args.cmd == "flush":
        reaped = reap_leases(cfg, verbose=not args.quiet)
        if not args.quiet:
            print("sent %d, dropped %d, %d still queued" % (sent, dropped, remaining)
                  + (", resolved %d from ended sessions" % reaped if reaped else ""))
        auto_update(cfg)
        return 0
    if args.cmd == "health":
        return health(cfg, remaining)
    if args.cmd == "resolve":
        body = {"key": args.key} if args.key else {"id": args.id}
        return deliver(cfg, "POST", "/v1/items/resolve", body, args.quiet, args.json)
    kind = args.kind if args.cmd == "add" else args.cmd
    if args.link and len(args.link) > 6:
        warn("at most 6 links")
        return 2
    if args.steps_json:
        try:
            args.steps_json = parse_steps_json(args.steps_json)
        except (OSError, ValueError) as e:
            warn("--steps-json: %s" % e)
            return 2
    if len(args.steps_json or []) + len(args.step or []) > MAX_STEPS:
        warn("at most %d steps" % MAX_STEPS)
        return 2
    return deliver(cfg, "POST", "/v1/items", build_item(args, cfg, kind), args.quiet, args.json)


