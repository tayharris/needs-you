        hook = os.path.join(home, "hooks", "needs-you-hook.sh")
        installer = _rerun("--cursor-hooks user")
        if not os.path.isdir(home) and not (shutil.which("cursor") or shutil.which("cursor-agent")):
            return
        doc: Any = {}
        try:
            with open(conf, "r", encoding="utf-8", errors="replace") as fh:
                text = fh.read()
            referenced = "needs-you-hook.sh" in text
            try:
                doc = json.loads(text) if text.strip() else {}
            except ValueError:
                doc = None
        except OSError:
            referenced = False
        if not referenced and not os.path.isfile(hook):
            self.add("cursor hooks", "INFO", "not installed (optional: a card when a Cursor agent finishes its turn)",
                     "to install: " + _installer("--cursor-hooks user --alerts"))
            return
        problems = []
        if doc is None:
            problems.append("%s isn't valid JSON, so Cursor loads none of its hooks" % _tilde(conf))
        elif not referenced:
            problems.append("%s doesn't reference the hook" % _tilde(conf))
        problems += self._hook_copy_problems(hook, "cursor_card", "Cursor")
        # Cursor blocks the action when a permission hook prints nothing: never one of ours there.
        hooks = doc.get("hooks") if isinstance(doc, dict) else None
        for ev in ("preToolUse", "beforeShellExecution", "beforeMCPExecution", "beforeReadFile",
                   "beforeTabFileRead", "subagentStart"):
            entries = hooks.get(ev) if isinstance(hooks, dict) else None
            if isinstance(entries, list) and any("needs-you-hook.sh" in json.dumps(e) for e in entries):
                problems.append("a needs-you entry under %s, which would block every %s" % (ev, ev))
        parts = [_tilde(conf), self._alerts_part()]
        if problems:
            self.add("cursor hooks", "WARN", "; ".join(problems + parts), installer)
            return
        hint = "Cursor has no approval hook: cards come when a turn finishes, not when it asks"
        if parts[-1] == "alerts off until opted in":
            hint += "; for cards from every session here: echo 'NEEDS_YOU_AGENT_ALERTS=1' >> %s" % _sh(self.env_path)
