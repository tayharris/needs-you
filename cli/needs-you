#!/usr/bin/env python3
"""needs-you: tell your human they have to do something.

  needs-you add --key KEY --title TITLE [--context work|personal] [--priority urgent|normal|low]
                [--body TEXT | --body-file PATH|-] [--link "Label=https://..."]...
                [--agent NAME] [--project NAME] [--host NAME] [--kind needs|done|info]
                [--expires-in HOURS]
  needs-you done  --key KEY --title TITLE [...]     same as add --kind done (expires in 24 h)
  needs-you info  --key KEY --title TITLE [...]     same as add --kind info (expires in 24 h)
  needs-you resolve (--key KEY | --id ID)
  needs-you flush                                    send anything queued in the outbox, and
                                                     resolve Claude Code cards whose session ended
  needs-you health                                   check each configured hub and the token
  needs-you doctor [--json]                          check config, PATH, hubs, outbox, hooks,
                                                     schedule (read-only; never posts)

Config: ~/.config/needs-you/env (KEY=VALUE lines), overridden by the environment:
  NEEDS_YOU_URLS    comma-separated hub URLs, tried in order (failover); preferred
  NEEDS_YOU_URL     a hub URL (or comma-separated list); used when NEEDS_YOU_URLS is unset
  NEEDS_YOU_TOKEN   this machine's sender token
  NEEDS_YOU_TIMEOUT seconds per hub attempt (default 3)
  NEEDS_YOU_DEFAULT_CONTEXT  work | personal: --context when not given (default work)
  NEEDS_YOU_OUTBOX_MAX       max queued requests kept (default 500)
  NEEDS_YOU_OUTBOX_MAX_DAYS  queued requests older than this are dropped (default 7)

  needs-you self-update                              replace this file with the hub's /dl/needs-you

If no hub answers, the request is written to ~/.local/state/needs-you/outbox/ and the
command still exits 0. Every invocation sends the outbox first. The outbox is capped
(oldest dropped, with a warning), so a hub that is gone for weeks can't fill the disk.

Exit codes: 0 sent or queued; 2 the hub rejected the request (bad input, bad token,
volume guard) or usage error; 1 `health` found no healthy hub, or `doctor` found a FAIL.

Python 3.9+ standard library only.
"""
from __future__ import annotations

import argparse
import json
import os
import socket
import sys
import time
import urllib.error
import urllib.request
from typing import Any, Dict, List, Optional, Tuple

VERSION = "0.1.1"
OPENER = urllib.request.build_opener(urllib.request.ProxyHandler({}))


# ---------------------------------------------------------------------------
# Config and paths
# ---------------------------------------------------------------------------

def config_path() -> str:
    if os.environ.get("NEEDS_YOU_CONFIG"):
        return os.environ["NEEDS_YOU_CONFIG"]
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return os.path.join(base, "needs-you", "env")


def outbox_dir() -> str:
    if os.environ.get("NEEDS_YOU_OUTBOX"):
        return os.environ["NEEDS_YOU_OUTBOX"]
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
    return os.path.join(base, "needs-you", "outbox")


def read_env_file(path: str) -> Dict[str, str]:
    out: Dict[str, str] = {}
    try:
        with open(path, "r", encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                if line.startswith("export "):
                    line = line[len("export "):].strip()
                k, v = line.split("=", 1)
                v = v.strip()
                if len(v) >= 2 and v[0] == v[-1] and v[0] in "'\"":
                    v = v[1:-1]
                out[k.strip()] = v
    except OSError:
        pass
    return out


class Config:
    def __init__(self) -> None:
        f = read_env_file(config_path())
        get = lambda k, d="": os.environ.get(k) or f.get(k) or d  # noqa: E731
        # Precedence: env NEEDS_YOU_URLS, env NEEDS_YOU_URL, file NEEDS_YOU_URLS, file NEEDS_YOU_URL.
        raw = (os.environ.get("NEEDS_YOU_URLS") or os.environ.get("NEEDS_YOU_URL")
               or f.get("NEEDS_YOU_URLS") or f.get("NEEDS_YOU_URL") or "")
        self.urls = [u.strip().rstrip("/") for u in raw.split(",") if u.strip()]
        self.token = get("NEEDS_YOU_TOKEN")
        try:
            self.timeout = float(get("NEEDS_YOU_TIMEOUT", "3"))
        except ValueError:
            self.timeout = 3.0
        self.host = get("NEEDS_YOU_HOST") or socket.gethostname().split(".")[0]
        ctx = get("NEEDS_YOU_DEFAULT_CONTEXT", "work").strip().lower()
        self.default_context = ctx if ctx in ("work", "personal") else "work"

    @property
    def ok(self) -> bool:
        return bool(self.urls and self.token)


def warn(msg: str) -> None:
    sys.stderr.write("needs-you: %s\n" % msg)


def clean(value: Any) -> str:
    """Text a hub sent us, made safe to print: control characters (terminal escape
    sequences included) and bidi overrides shown as \\x.. / \\u.... instead of acting."""
    out = []
    for c in str(value):
        o = ord(c)
        if o < 0x20 or 0x7f <= o < 0xa0:
            out.append("\\x%02x" % o)
        elif 0x202a <= o <= 0x202e or 0x2066 <= o <= 0x2069:
            out.append("\\u%04x" % o)
        else:
            out.append(c)
    return "".join(out)


# ---------------------------------------------------------------------------
# HTTP with failover
# ---------------------------------------------------------------------------

class Unreachable(Exception):
    pass


class Rejected(Exception):
    def __init__(self, status: int, body: Dict[str, Any]) -> None:
        super().__init__("%s %s" % (status, clean(body.get("message") or body.get("error") or "")))
        self.status = status
        self.body = body


def _call(url: str, token: str, method: str, path: str, body: Optional[Dict[str, Any]],
          timeout: float) -> Tuple[int, Dict[str, Any]]:
    data = json.dumps(body).encode("utf-8") if body is not None else None
    req = urllib.request.Request(url + path, data=data, method=method)
    if token:
        req.add_header("Authorization", "Bearer " + token)
    req.add_header("Accept", "application/json")
    req.add_header("User-Agent", "needs-you-cli/" + VERSION)
    if data is not None:
        req.add_header("Content-Type", "application/json")
    try:
        with OPENER.open(req, timeout=timeout) as resp:
            raw = resp.read().decode("utf-8") or "{}"
            return resp.status, json.loads(raw)
    except urllib.error.HTTPError as e:
        try:
            parsed = json.loads(e.read().decode("utf-8") or "{}")
        except ValueError:
            parsed = {}
        return e.code, parsed if isinstance(parsed, dict) else {}


def send(cfg: Config, method: str, path: str, body: Optional[Dict[str, Any]]) -> Tuple[str, int, Dict[str, Any]]:
    """Try each hub in order. 2xx -> result. 4xx -> Rejected (no failover: every hub
    would say the same). Network errors, timeouts and 5xx -> next hub; none -> Unreachable."""
    errors = []
    for url in cfg.urls:
        try:
            status, parsed = _call(url, cfg.token, method, path, body, cfg.timeout)
        except (OSError, ValueError) as e:  # URLError, timeouts, refused, bad JSON
            errors.append("%s: %s" % (url, getattr(e, "reason", e)))
            continue
        if 200 <= status < 300:
            return url, status, parsed
        if 400 <= status < 500:
            raise Rejected(status, parsed)
        errors.append("%s: HTTP %d" % (url, status))
    raise Unreachable("; ".join(errors) or "no hub URL configured")


# ---------------------------------------------------------------------------
# Outbox
# ---------------------------------------------------------------------------

def queue(method: str, path: str, body: Optional[Dict[str, Any]]) -> str:
    d = outbox_dir()
    os.makedirs(d, mode=0o700, exist_ok=True)
    name = "%020d-%05d.json" % (time.time_ns(), os.getpid() % 100000)
    tmp = os.path.join(d, "." + name + ".tmp")
    entry = {"method": method, "path": path, "body": body,
             "queued_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump(entry, fh)
    final = os.path.join(d, name)
    os.replace(tmp, final)
    prune()
    return final


def _env_number(name: str, default: float) -> float:
    try:
        return float(os.environ.get(name) or default)
    except ValueError:
        return default


def _prune_dir(d: str, max_files: int, max_age_s: float) -> int:
    """Drop entries older than max_age_s, then the oldest beyond max_files. Names start
    with time_ns, so sorting by name is oldest first. Returns how many were dropped."""
    try:
        names = sorted(n for n in os.listdir(d) if n.endswith(".json") and not n.startswith("."))
    except OSError:
        return 0
    cutoff_ns = (time.time() - max_age_s) * 1e9
    drop = []
    keep = []
    for n in names:
        try:
            ts = int(n.split("-", 1)[0])
        except ValueError:  # not our naming: judge it by its mtime instead
            try:
                ts = int(os.path.getmtime(os.path.join(d, n)) * 1e9)
            except OSError:
                continue
        (drop if ts < cutoff_ns else keep).append(n)
    if len(keep) > max_files:
        drop += keep[:len(keep) - max_files]
    for n in drop:
        try:
            os.remove(os.path.join(d, n))
        except OSError:
            pass
    return len(drop)


def prune() -> int:
    max_files = int(_env_number("NEEDS_YOU_OUTBOX_MAX", 500))
    max_age = _env_number("NEEDS_YOU_OUTBOX_MAX_DAYS", 7) * 86400
    d = outbox_dir()
    dropped = _prune_dir(d, max_files, max_age)
    _prune_dir(os.path.join(d, "failed"), min(max_files, 100), max_age)
    if dropped:
        warn("outbox over its cap (%d requests / %g days): dropped the %d oldest"
             % (max_files, max_age / 86400, dropped))
    return dropped


def pending() -> List[str]:
    d = outbox_dir()
    try:
        names = sorted(n for n in os.listdir(d) if n.endswith(".json") and not n.startswith("."))
    except OSError:
        return []
    return [os.path.join(d, n) for n in names]


def _lock():  # type: ignore[no-untyped-def]
    """Non-blocking exclusive lock on the outbox, so two invocations don't double-send."""
    d = outbox_dir()
    try:
        os.makedirs(d, mode=0o700, exist_ok=True)
        import fcntl
        fh = open(os.path.join(d, ".lock"), "a")
        try:
            fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            fh.close()
            return None
        return fh
    except (OSError, ImportError):
        return None


def flush(cfg: Config, verbose: bool = False) -> Tuple[int, int, int]:
    """Send queued entries oldest first. Stops at the first unreachable attempt.
    Returns (sent, dropped, remaining)."""
    files = pending()
    if files:
        prune()
        files = pending()
    if not files or not cfg.ok:
        return 0, 0, len(files)
    lock = _lock()
    if lock is None:
        return 0, 0, len(pending())
    sent = dropped = 0
    try:
        for path in pending():
            try:
                with open(path, "r", encoding="utf-8") as fh:
                    entry = json.load(fh)
            except (OSError, ValueError):
                _move_failed(path)
                dropped += 1
                continue
            try:
                url, _status, _body = send(cfg, entry["method"], entry["path"], entry.get("body"))
                os.remove(path)
                sent += 1
                if verbose:
                    warn("sent queued %s %s via %s" % (entry["method"], entry["path"], url))
            except Rejected as e:
                if e.status == 404 and entry["path"].endswith("/resolve"):
                    os.remove(path)  # nothing open with that key: the resolve is moot
                    sent += 1
                    continue
                warn("hub rejected a queued request (%s); moved it to outbox/failed/" % e)
                _move_failed(path)
                dropped += 1
            except Unreachable:
                break
    finally:
        lock.close()
    return sent, dropped, len(pending())


# ---------------------------------------------------------------------------
# Claude Code hook leases
# ---------------------------------------------------------------------------

def leases_dir() -> str:
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
    return os.path.join(base, "needs-you", "claude-hooks")


def _read_lease(path: str) -> Dict[str, str]:
    out: Dict[str, str] = {}
    try:
        with open(path, "r", encoding="utf-8") as fh:
            for line in fh:
                k, sep, v = line.rstrip("\n").partition("=")
                if sep:
                    out[k] = v
    except (OSError, UnicodeDecodeError):
        pass
    return out


def _process_start(pid: int) -> Optional[str]:
    """The process's start time as `ps -o lstart=` prints it (the hook records the
    same), "" if there is no such process, None if we can't tell."""
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return ""
    except PermissionError:
        pass  # alive, owned by someone else
    except OSError:
        return None
    import subprocess
    try:
        r = subprocess.run(["ps", "-o", "lstart=", "-p", str(pid)], stdin=subprocess.DEVNULL,
                           capture_output=True, text=True, timeout=5,
                           env=dict(os.environ, LC_ALL="C"))
    except (OSError, subprocess.SubprocessError):
        return None
    return " ".join(r.stdout.split())


def reap_leases(cfg: Config, verbose: bool = False) -> int:
    """Resolve the card of every hook lease whose Claude process is gone (or whose pid
    now belongs to a newer process). The hook writes one marker per session:
    key=, pid=, start=. Markers without a pid (older hooks) are left alone."""
    d = leases_dir()
    try:
        names = sorted(n for n in os.listdir(d) if not n.startswith("."))
    except OSError:
        return 0
    reaped = 0
    for name in names:
        path = os.path.join(d, name)
        lease = _read_lease(path)
        key, pid, start = lease.get("key", ""), lease.get("pid", ""), lease.get("start", "")
        if not key.startswith("agent:") or not pid.isdigit() or not start:
            continue
        now_start = _process_start(int(pid))
        if now_start is None or now_start == " ".join(start.split()):
            continue  # alive, or unknown: leave it
        if _read_lease(path) != lease:
            continue  # the hook just re-posted from a new session
        try:
            os.remove(path)
        except OSError:
            continue
        deliver(cfg, "POST", "/v1/items/resolve", {"key": key}, True, False)
        reaped += 1
        if verbose:
            warn("session %s ended; resolved %s" % (pid, key))
    return reaped


def _move_failed(path: str) -> None:
    d = os.path.join(os.path.dirname(path), "failed")
    os.makedirs(d, mode=0o700, exist_ok=True)
    try:
        os.replace(path, os.path.join(d, os.path.basename(path)))
    except OSError:
        pass


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

def deliver(cfg: Config, method: str, path: str, body: Dict[str, Any], quiet: bool,
            as_json: bool) -> int:
    if not cfg.ok:
        f = queue(method, path, body)
        warn("NEEDS_YOU_URLS / NEEDS_YOU_TOKEN not set (%s); queued %s" % (config_path(), f))
        return 0
    try:
        url, status, resp = send(cfg, method, path, body)
    except Unreachable as e:
        f = queue(method, path, body)
        warn("no hub reachable (%s); queued %s" % (e, os.path.basename(f)))
        return 0
    except Rejected as e:
        if e.status == 404 and path.endswith("/resolve"):
            if not quiet:
                warn("nothing open with that key/id (already resolved?)")
            return 0
        warn("hub rejected the request: HTTP %d %s" % (e.status, clean(e.body.get("message") or e.body.get("error") or "")))
        return 2
    if as_json:
        print(json.dumps(resp, sort_keys=True))
    elif not quiet:
        if path.endswith("/resolve"):
            ids = [clean(i.get("id")) for i in resp.get("items", [])]
            if ids:
                print("resolved %s via %s" % (", ".join(ids), url))
            else:
                print("nothing open to resolve (already resolved?) via %s" % url)
        else:
            state = "created" if resp.get("created") else ("updated" if resp.get("changed") else "unchanged")
            print("%s %s via %s" % (state, clean(resp.get("id")), url))
    return 0


def parse_link(raw: str) -> Dict[str, str]:
    """'Label=URL'. A bare URL (or one whose only '=' is in its query) gets the label 'Link'."""
    label, sep, url = raw.partition("=")
    if not sep or "://" in label or not label.strip():
        return {"label": "Link", "url": raw.strip()}
    return {"label": label.strip(), "url": url.strip()}


def build_item(args: argparse.Namespace, cfg: Config, kind: str) -> Dict[str, Any]:
    body = args.body
    if args.body_file:
        if args.body_file == "-":
            body = sys.stdin.read()
        else:
            with open(args.body_file, "r", encoding="utf-8") as fh:
                body = fh.read()
    item: Dict[str, Any] = {"key": args.key, "title": args.title, "kind": kind,
                            "context": args.context or cfg.default_context, "priority": args.priority}
    if body:
        item["body"] = body
    if args.link:
        item["links"] = args.link
    source = {"host": args.host or cfg.host}
    if args.agent:
        source["agent"] = args.agent
    if args.project:
        source["project"] = args.project
    item["source"] = source
    if args.expires_in is not None:
        exp = time.time() + args.expires_in * 3600
        item["expires_at"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(exp))
    return item


def main(argv: Optional[List[str]] = None) -> int:
    p = argparse.ArgumentParser(prog="needs-you", description=__doc__.split("\n")[0],
                                epilog="See docs/AGENT-GUIDE.md for when and how to post.")
    p.add_argument("--version", action="version", version="needs-you " + VERSION)
    p.add_argument("-q", "--quiet", action="store_true", help="no output on success")
    p.add_argument("--json", action="store_true", help="print the hub's JSON response")
    sub = p.add_subparsers(dest="cmd")

    def item_parser(name: str, help_: str) -> argparse.ArgumentParser:
        sp = sub.add_parser(name, help=help_)
        sp.add_argument("--key", required=True, help="stable dedupe key, e.g. work:ACME-123:redo-blocked")
        sp.add_argument("--title", required=True, help="the action needed, <= 100 chars")
        sp.add_argument("--body", help="markdown, <= 2000 chars")
        sp.add_argument("--body-file", help="read the body from a file ('-' for stdin)")
        sp.add_argument("--context", choices=("work", "personal"), default=None,
                        help="default: $NEEDS_YOU_DEFAULT_CONTEXT, else work")
        sp.add_argument("--priority", choices=("urgent", "normal", "low"), default="normal")
        sp.add_argument("--link", action="append", type=parse_link, metavar="LABEL=URL",
                        help="repeatable, at most 6")
        sp.add_argument("--agent", help="source agent, e.g. orca:redo-fixer")
        sp.add_argument("--project", help="source project")
        sp.add_argument("--host", help="source host (default: this machine's hostname)")
        sp.add_argument("--expires-in", type=float, metavar="HOURS",
                        help="expiry (done/info default to 24 h on the hub)")
        if name == "add":
            sp.add_argument("--kind", choices=("needs", "done", "info"), default="needs")
        return sp

    item_parser("add", "add or update an item (kind needs by default)")
    item_parser("done", "FYI: something finished (expires in 24 h, never counted)")
    item_parser("info", "FYI: information (expires in 24 h, never counted)")
    rp = sub.add_parser("resolve", help="mark an item handled")
    g = rp.add_mutually_exclusive_group(required=True)
    g.add_argument("--key")
    g.add_argument("--id")
    sub.add_parser("flush", help="send queued items now")
    sub.add_parser("health", help="check hubs and token")
    sub.add_parser("self-update", help="replace this CLI with the copy served by the first healthy hub")
    dp = sub.add_parser("doctor", help="check this machine's setup (read-only; never posts)")
    dp.add_argument("--json", dest="doctor_json", action="store_true",
                    help="machine-readable: {ok, version, checks: [{check, status, detail, hint}]}")

    args = p.parse_args(argv)
    if not args.cmd:
        p.print_help()
        return 2
    cfg = Config()
    if args.cmd == "self-update":
        return self_update(cfg, args.quiet)
    if args.cmd == "doctor":  # before the flush below: doctor changes nothing
        return doctor(cfg, args.json or args.doctor_json)

    # Every invocation drains the outbox first, so queued items go out in order.
    sent, dropped, remaining = flush(cfg, verbose=not args.quiet and args.cmd == "flush")

    if args.cmd == "flush":
        reaped = reap_leases(cfg, verbose=not args.quiet)
        if not args.quiet:
            print("sent %d, dropped %d, %d still queued" % (sent, dropped, remaining)
                  + (", resolved %d from ended sessions" % reaped if reaped else ""))
        return 0
    if args.cmd == "health":
        return health(cfg, remaining)
    if args.cmd == "resolve":
        body = {"key": args.key} if args.key else {"id": args.id}
        return deliver(cfg, "POST", "/v1/items/resolve", body, args.quiet, args.json)
    kind = args.kind if args.cmd == "add" else args.cmd
    if args.link and len(args.link) > 6:
        warn("at most 6 links")
        return 2
    return deliver(cfg, "POST", "/v1/items", build_item(args, cfg, kind), args.quiet, args.json)


def self_update(cfg: Config, quiet: bool) -> int:
    """Fetch /dl/needs-you from the first healthy hub and atomically replace this file."""
    target = os.path.realpath(sys.argv[0] if sys.argv and sys.argv[0] else __file__)
    if not cfg.urls:
        warn("NEEDS_YOU_URLS is not set (%s)" % config_path())
        return 1
    errors = []
    for url in cfg.urls:
        try:
            status, body = _call(url, "", "GET", "/v1/health", None, cfg.timeout)
            if status != 200 or not body.get("ok"):
                raise ValueError("HTTP %d" % status)
            req = urllib.request.Request(url + "/dl/needs-you", method="GET")
            req.add_header("User-Agent", "needs-you-cli/" + VERSION)
            with OPENER.open(req, timeout=max(cfg.timeout, 10)) as resp:
                data = resp.read()
        except (OSError, ValueError) as e:
            errors.append("%s: %s" % (url, getattr(e, "reason", e)))
            continue
        try:
            src = data.decode("utf-8")
            if not src.startswith("#!") or "def main(" not in src:
                raise ValueError("not the needs-you CLI")
            compile(src, "needs-you", "exec")
        except (UnicodeDecodeError, ValueError, SyntaxError) as e:
            errors.append("%s: bad download (%s)" % (url, e))
            continue
        import re
        m = re.search(r'^VERSION = "([^"]+)"', src, re.M)
        new_version = m.group(1) if m else "?"
        try:
            with open(target, "rb") as fh:
                if fh.read() == data:
                    if not quiet:
                        print("needs-you %s is already up to date (%s)" % (VERSION, url))
                    return 0
        except OSError:
            pass
        d = os.path.dirname(target)
        tmp = os.path.join(d, ".needs-you.%d.tmp" % os.getpid())
        try:
            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o755)
            with os.fdopen(fd, "wb") as fh:
                fh.write(data)
            os.chmod(tmp, 0o755)
            os.replace(tmp, target)
        except OSError as e:
            try:
                os.remove(tmp)
            except OSError:
                pass
            warn("cannot replace %s: %s" % (target, e))
            return 1
        if not quiet:
            print("updated %s: %s -> %s (from %s)" % (target, VERSION, new_version, url))
        return 0
    warn("no hub could serve an update: %s" % "; ".join(errors))
    return 1


def health(cfg: Config, queued: int) -> int:
    if not cfg.urls:
        warn("NEEDS_YOU_URLS is not set (%s)" % config_path())
        return 1
    healthy = 0
    for url in cfg.urls:
        try:
            status, body = _call(url, cfg.token, "GET", "/v1/health", None, cfg.timeout)
        except (OSError, ValueError) as e:
            print("%s  DOWN  %s" % (url, getattr(e, "reason", e)))
            continue
        if status == 200 and body.get("token_error"):
            print("%s  UP    hub=%s but the token was rejected: %s" % (url, clean(body.get("hub_id")),
                                                                    clean(body["token_error"])))
        elif status == 200:
            tok = body.get("token") or {}
            print("%s  OK    hub=%s token=%s role=%s" % (url, clean(body.get("hub_id")), clean(tok.get("name", "-")),
                                                        clean(tok.get("role", "-"))))
            healthy += 1
        else:
            print("%s  HTTP %d  %s" % (url, status, clean(body.get("message") or body.get("error") or "")))
    print("outbox: %d queued" % queued)
    return 0 if healthy else 1


# ---------------------------------------------------------------------------
# doctor: read-only self-diagnosis. Never writes a file, never posts, never
# prints a token (only "set" and its length).
# ---------------------------------------------------------------------------

FLUSH_LABEL = "io.needs-you.flush"
CRON_TAG = "# needs-you-flush"
HOOK_MARKER = "orca terminal switch"  # present in every hook since agent cards name the Orca terminal
_ON = ("1", "true", "yes", "on")
_OFF = ("0", "false", "no", "off")


def _tilde(path: str) -> str:
    home = os.path.expanduser("~")
    if path == home or path.startswith(home + os.sep):
        return "~" + path[len(home):]
    return path


def _age(seconds: float) -> str:
    s = max(0, int(seconds))
    if s < 120:
        return "%ds" % s
    if s < 7200:
        return "%dm" % (s // 60)
    if s < 172800:
        return "%dh" % (s // 3600)
    return "%dd" % (s // 86400)


def _entry_time(d: str, name: str) -> Optional[float]:
    try:
        return int(name.split("-", 1)[0]) / 1e9
    except ValueError:
        try:
            return os.path.getmtime(os.path.join(d, name))
        except OSError:
            return None


def _list_json(d: str) -> List[str]:
    """Like pending(), but read-only: never creates the directory or prunes."""
    try:
        return sorted(n for n in os.listdir(d) if n.endswith(".json") and not n.startswith("."))
    except OSError:
        return []


def crontab_has_flush(text: str) -> bool:
    return any(CRON_TAG in line and not line.lstrip().startswith("#") for line in text.splitlines())


def _is_loopback(url: str) -> bool:
    import urllib.parse
    host = (urllib.parse.urlsplit(url).hostname or "").lower()
    return host in ("127.0.0.1", "localhost", "::1")


class Doctor:
    def __init__(self, cfg: Config) -> None:
        self.cfg = cfg
        self.checks: List[Dict[str, str]] = []
        self.home = os.path.expanduser("~")
        self.env_path = config_path()
        self.file = read_env_file(self.env_path)

    def add(self, check: str, status: str, detail: str, hint: str = "") -> None:
        self.checks.append({"check": check, "status": status, "detail": detail, "hint": hint})

    def setting(self, name: str) -> Tuple[str, str]:
        """(value, where): the environment wins over the env file, like the CLI and the hooks."""
        if os.environ.get(name):
            return os.environ[name], "env"
        if self.file.get(name):
            return self.file[name], "env file"
        return "", ""

    def run(self) -> List[Dict[str, str]]:
        for step in (self.config, self.path, self.hubs, self.outbox, self.hooks, self.skill,
                     self.orca, self.schedule):
            try:
                step()
            except Exception as e:  # a broken check must not hide the others
                self.add(step.__name__, "WARN", "check crashed: %s" % type(e).__name__,
                         "report this as a needs-you bug")
        return self.checks

    # -- config ------------------------------------------------------------
    def config(self) -> None:
        p = self.env_path
        shown = _tilde(p)
        status, hint, parts = "OK", "", []
        try:
            st = os.stat(p)
        except OSError:
            st = None
        if st is None:
            parts.append("%s not found" % shown)
            if not self.cfg.ok:
                status, hint = "FAIL", "set this machine up with an invite link from the Mac app (or scripts/setup-sender.sh)"
            else:
                status = "WARN"
                hint = "the settings come from the environment only; cron, LaunchAgents and hooks won't see them"
        else:
            mode = st.st_mode & 0o777
            parts.append("%s (mode %o)" % (shown, mode))
            if mode & 0o077:
                status, hint = "WARN", "chmod 600 %s" % shown
        hooks_file = os.environ.get("NEEDS_YOU_ENV_FILE")
        if hooks_file and os.path.abspath(os.path.expanduser(hooks_file)) != os.path.abspath(p):
            parts.append("hooks read NEEDS_YOU_ENV_FILE=%s instead" % _tilde(hooks_file))
            if status == "OK":
                status, hint = "WARN", "point NEEDS_YOU_ENV_FILE and the CLI at the same file, or unset it"
        urls, where = self.setting("NEEDS_YOU_URLS")
        if not urls:
            urls, where = self.setting("NEEDS_YOU_URL")
            name = "NEEDS_YOU_URL"
        else:
            name = "NEEDS_YOU_URLS"
        if self.cfg.urls:
            parts.append("%s: %d hub URL%s (%s)" % (name, len(self.cfg.urls),
                                                    "" if len(self.cfg.urls) == 1 else "s", where))
        else:
            parts.append("NEEDS_YOU_URLS not set")
            status = "FAIL"
            hint = hint if st is None else "add NEEDS_YOU_URLS=<hub url>[,<hub url>...] to %s" % shown
        tok, where = self.setting("NEEDS_YOU_TOKEN")
        if tok:
            parts.append("NEEDS_YOU_TOKEN set (%d chars, %s)" % (len(tok), where))
        else:
            parts.append("NEEDS_YOU_TOKEN not set")
            status = "FAIL"
            if st is not None:
                hint = "re-run the invite installer with --force to get a token for this machine"
        self.add("config", status, "; ".join(parts), hint)

    # -- PATH --------------------------------------------------------------
    def path(self) -> None:
        import shutil
        local_bin = os.path.join(self.home, ".local", "bin")
        entries = [os.path.realpath(os.path.expanduser(e)) for e in os.environ.get("PATH", "").split(os.pathsep) if e]
        on_path = os.path.realpath(local_bin) in entries
        found = shutil.which("needs-you")
        installed = os.path.join(local_bin, "needs-you")
        hint_line = 'add export PATH="$HOME/.local/bin:$PATH" to your shell profile'
        if found:
            detail = "needs-you -> %s" % _tilde(found)
            me = os.path.realpath(sys.argv[0]) if sys.argv and sys.argv[0] else ""
            if me and os.path.realpath(found) != me:
                detail += " (this run: %s)" % _tilde(me)
            detail += "; ~/.local/bin %s PATH" % ("on" if on_path else "not on")
            self.add("path", "OK", detail)
        elif os.path.exists(installed):
            self.add("path", "WARN", "needs-you is not on PATH; ~/.local/bin/needs-you exists",
                     hint_line + "; until then call ~/.local/bin/needs-you by its full path")
        else:
            self.add("path", "WARN", "needs-you is not on PATH%s" % ("" if on_path else "; ~/.local/bin not on PATH"),
                     "install the CLI to ~/.local/bin (the invite installer does) and " + hint_line)

    # -- hubs --------------------------------------------------------------
    def hubs(self) -> None:
        urls = self.cfg.urls
        if not urls:
            self.add("hubs", "FAIL", "no hub URL configured", "set NEEDS_YOU_URLS in %s" % _tilde(self.env_path))
            return
        timeout = min(self.cfg.timeout, 3.0)
        answered: List[int] = []
        usable: List[int] = []
        for i, url in enumerate(urls):
            name = "hub %d" % (i + 1)
            try:
                status, body = _call(url, self.cfg.token, "GET", "/v1/health", None, timeout)
            except (OSError, ValueError) as e:
                self.add(name, "WARN", "%s unreachable (%s)" % (url, getattr(e, "reason", e)),
                         "is the hub up, and this machine on the tailnet? see docs/guides/troubleshooting.md")
                continue
            if status != 200:
                self.add(name, "WARN", "%s answered HTTP %d" % (url, status), "is that a needs-you hub URL?")
                continue
            answered.append(i)
            hub_v = clean(body.get("version") or "?")
            base = "%s hub=%s version %s" % (url, clean(body.get("hub_id", "?")), hub_v)
            vhint = ""
            if hub_v not in ("?", VERSION):
                vhint = "CLI is %s; needs-you self-update fetches the hub's copy" % VERSION
            tok = body.get("token")
            if body.get("token_error") or not isinstance(tok, dict):
                why = (clean(body["token_error"]) if body.get("token_error")
                       else "no token sent" if not self.cfg.token else "token not recognised")
                self.add(name, "FAIL", "%s; token rejected: %s" % (base, why),
                         "get a new invite link and re-run its installer with --force")
                continue
            role = clean(tok.get("role", "?"))
            detail = "%s token=%s role=%s" % (base, clean(tok.get("name", "?")), role)
            if role not in ("sender", "owner"):
                self.add(name, "WARN", detail + " (this role can't post)", "use a sender token on this machine")
                continue
            usable.append(i)
            self.add(name, "OK", detail, vhint)
        n = len(urls)
        summary = "%d configured, %d answered, %d accept the token" % (n, len(answered), len(usable))
        if not usable:
            self.add("hubs", "FAIL", summary,
                     "items will queue in the outbox until a hub accepts the token; see docs/guides/troubleshooting.md")
        elif 0 not in usable:
            self.add("hubs", "WARN", summary + "; only a fallback hub works (%s)" % urls[usable[0]],
                     "check the first hub %s; every post waits for it to time out first" % urls[0])
        else:
            self.add("hubs", "OK", summary)
        if sys.platform == "darwin":
            loop = [i for i, u in enumerate(urls) if _is_loopback(u)]
            if loop and loop[0] != 0:
                self.add("hub order", "WARN", "%s is #%d in NEEDS_YOU_URLS" % (urls[loop[0]], loop[0] + 1),
                         "on the Mac that runs the hub, list %s first so local agents don't depend on Tailscale"
                         % urls[loop[0]])

    # -- outbox ------------------------------------------------------------
    def outbox(self) -> None:
        d = outbox_dir()
        now = time.time()
        queued = _list_json(d)
        failed = _list_json(os.path.join(d, "failed"))
        parts = ["%d queued" % len(queued)]
        if queued:
            t = _entry_time(d, queued[0])
            if t is not None:
                parts[0] += ", oldest %s" % _age(now - t)
        parts.append("%d failed" % len(failed))
        status, hints = "OK", []
        if queued:
            status = "WARN"
            hints.append("needs-you flush (sends them once a hub answers)")
        if failed:
            status = "WARN"
            hints.append("a hub rejected the entries in %s; read them, then delete them"
                         % _tilde(os.path.join(d, "failed")))
        self.add("outbox", status, "%s (%s)" % (", ".join(parts), _tilde(d)), "; ".join(hints))

    # -- Claude Code hooks -------------------------------------------------
    def hooks(self) -> None:
        claude = os.path.join(self.home, ".claude")
        hook = os.path.join(claude, "hooks", "needs-you-hook.sh")
        settings = os.path.join(claude, "settings.json")
        installer = "integrations/claude-code/install-hooks.sh (or the invite installer with --claude-hooks user)"
        if not os.path.isdir(claude):
            self.add("claude hooks", "INFO", "~/.claude not found; Claude Code isn't set up for this user")
            return
        try:
            with open(settings, "r", encoding="utf-8") as fh:
                referenced = "needs-you-hook.sh" in fh.read()
        except OSError:
            referenced = False
        exists = os.path.isfile(hook)
        if not exists and not referenced:
            self.add("claude hooks", "INFO", "not installed (optional: cards when a session waits on you)",
                     "run " + installer)
            return
        problems, parts = [], []
        if not exists:
            problems.append("~/.claude/settings.json references the hook but %s is missing" % _tilde(hook))
        else:
            parts.append(_tilde(hook))
            if not os.access(hook, os.X_OK):
                problems.append("%s is not executable" % _tilde(hook))
            if not referenced:
                problems.append("~/.claude/settings.json doesn't reference it")
            try:
                with open(hook, "r", encoding="utf-8", errors="replace") as fh:
                    current = HOOK_MARKER in fh.read()
            except OSError:
                current = False
            if not current:
                problems.append("old hook")
        alerts, where = self.setting("NEEDS_YOU_AGENT_ALERTS")
        if alerts.lower() in _OFF:
            parts.append("alerts off (NEEDS_YOU_AGENT_ALERTS=%s in %s)" % (alerts, where))
        elif alerts.lower() in _ON:
            parts.append("alerts on (NEEDS_YOU_AGENT_ALERTS=%s in %s)" % (alerts, where))
        elif os.environ.get("ORCA_TERMINAL_HANDLE"):
            parts.append("alerts on (Orca session)")
        else:
            parts.append("alerts off until opted in")
        if problems:
            hint = "re-run the installer: " + installer
            self.add("claude hooks", "WARN", "; ".join(problems + parts), hint)
        else:
            hint = ""
            if parts[-1] == "alerts off until opted in":
                hint = "to get cards from every session here: echo 'NEEDS_YOU_AGENT_ALERTS=1' >> %s" % _tilde(self.env_path)
            self.add("claude hooks", "OK", "installed in ~/.claude/settings.json; " + "; ".join(parts), hint)

    # -- skill -------------------------------------------------------------
    def skill(self) -> None:
        p = os.path.join(self.home, ".claude", "skills", "needs-you", "SKILL.md")
        if os.path.isfile(p):
            self.add("claude skill", "OK", _tilde(p))
        else:
            self.add("claude skill", "INFO", "%s not installed (optional)" % _tilde(p),
                     "copy integrations/claude-code/skill/needs-you to ~/.claude/skills/ (or the invite installer's --skill)")

    # -- Orca --------------------------------------------------------------
    def orca(self) -> None:
        import shutil
        handle = os.environ.get("ORCA_TERMINAL_HANDLE")
        if not handle and not shutil.which("orca"):
            return
        parts = ["ORCA_TERMINAL_HANDLE %s" % ("set" if handle else "not set (not an Orca terminal)"),
                 "ORCA_WORKTREE_ID %s" % ("set" if os.environ.get("ORCA_WORKTREE_ID") else "not set")]
        env_name, where = self.setting("NEEDS_YOU_ORCA_ENVIRONMENT")
        hint = ""
        if env_name:
            parts.append("NEEDS_YOU_ORCA_ENVIRONMENT=%s (%s)" % (env_name, where))
        else:
            parts.append("NEEDS_YOU_ORCA_ENVIRONMENT not set")
            hint = ("on a paired Orca server, set NEEDS_YOU_ORCA_ENVIRONMENT in %s to the name "
                    "`orca environment list` shows on the Mac" % _tilde(self.env_path))
        self.add("orca", "INFO", "; ".join(parts), hint)

    # -- flush schedule ----------------------------------------------------
    def schedule(self) -> None:
        if sys.platform == "darwin":
            plist = os.path.join(self.home, "Library", "LaunchAgents", FLUSH_LABEL + ".plist")
            try:
                import plistlib
                with open(plist, "rb") as fh:
                    data = plistlib.load(fh)
            except OSError:
                self.add("flush schedule", "WARN", "no LaunchAgent %s" % _tilde(plist),
                         "re-run the invite installer (without --no-schedule) so queued items go out every 5 minutes")
                return
            except Exception:
                self.add("flush schedule", "WARN", "%s is not a valid plist" % _tilde(plist),
                         "re-run the invite installer")
                return
            args = data.get("ProgramArguments") or []
            prog = args[0] if args else ""
            if prog and not os.path.exists(prog):
                self.add("flush schedule", "WARN", "%s runs %s, which doesn't exist" % (_tilde(plist), _tilde(prog)),
                         "re-run the invite installer")
                return
            self.add("flush schedule", "OK", "LaunchAgent %s (every %ss)" % (FLUSH_LABEL, data.get("StartInterval", "?")))
            return
        import shutil
        import subprocess
        if not shutil.which("crontab"):
            self.add("flush schedule", "WARN", "no crontab on this machine",
                     "run `needs-you -q flush` every few minutes some other way (e.g. a systemd timer)")
            return
        try:
            r = subprocess.run(["crontab", "-l"], capture_output=True, text=True, timeout=5)
            text = r.stdout if r.returncode == 0 else ""
        except (OSError, subprocess.SubprocessError):
            text = ""
        if crontab_has_flush(text):
            self.add("flush schedule", "OK", "crontab line tagged %s" % CRON_TAG)
        else:
            self.add("flush schedule", "WARN", "no crontab line tagged %s" % CRON_TAG,
                     "re-run the invite installer (without --no-schedule) so queued items go out every 5 minutes")


def doctor(cfg: Config, as_json: bool) -> int:
    checks = Doctor(cfg).run()
    ok = not any(c["status"] == "FAIL" for c in checks)
    if as_json:
        print(json.dumps({"ok": ok, "version": VERSION, "checks": checks}, indent=1))
    else:
        print("needs-you doctor (CLI %s)" % VERSION)
        width = max(len(c["check"]) for c in checks)
        for c in checks:
            print("%-4s  %-*s  %s" % (c["status"], width, c["check"], c["detail"]))
            if c["hint"]:
                print("      %-*s  -> %s" % (width, "", c["hint"]))
        print("ok" if ok else "problems found (FAIL above)")
    return 0 if ok else 1


