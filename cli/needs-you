def deliver(cfg: Config, method: str, path: str, body: Dict[str, Any], quiet: bool,
            as_json: bool) -> int:
    """Send one request in order: it joins the outbox and goes out behind everything queued
    before it, so a `resolve K` can never overtake a queued `add K`, also when another run is
    sending the outbox right now (we wait for it up to LOCK_WAIT_SECONDS, then leave ours
    queued behind its entries and exit 0)."""
    if not cfg.ok:
        try:
            f = queue(method, path, body)
        except OSError as e:
            warn("NEEDS_YOU_URLS / NEEDS_YOU_TOKEN not set (%s), and the outbox can't be written (%s): dropped"
                 % (config_path(), e))
            return 0
        warn("NEEDS_YOU_URLS / NEEDS_YOU_TOKEN not set (%s); queued %s" % (config_path(), f))
        return 0
    try:
        import fcntl  # noqa: F401  (the outbox lock)
        mine: Optional[str] = queue(method, path, body)
    except (OSError, ImportError):
        mine = None  # no usable outbox here: send directly, as there's nothing to keep order with
    if mine is None:
        if pending():
            # Ours can't join the queue, so at least don't overtake it: a `resolve K` sent
            # before a queued `add K` would leave the item open for good.
            lock = _lock(wait=LOCK_WAIT_SECONDS)
            if lock is not None:
                try:
                    _flush_locked(cfg)
                finally:
                    lock.close()
        try:
            result: Any = send(cfg, method, path, body)
            _after_sent(path, body, result[2])
        except Unreachable as e:
            warn("no hub reachable (%s), and the outbox can't be written: dropped" % e)
            return 0
        except Rejected as e:
            result = e
    else:
        lock = _lock(wait=LOCK_WAIT_SECONDS)
        if lock is None:
            warn("another needs-you run is sending the outbox; queued %s behind it" % os.path.basename(mine))
            return 0
        try:
            out = _flush_locked(cfg, mine=mine)
        finally:
            lock.close()
        _catch_stragglers(cfg, out)
        result = out.results.get(mine)
        if result is None:
            if os.path.exists(mine):
                warn("no hub reachable (%s); queued %s" % (out.unreachable, os.path.basename(mine)))
                return 0
            # Another run's flush took our entry between queue() and the lock: it moves a
            # refused one to outbox/failed/ and deletes a sent one.
            if os.path.exists(os.path.join(os.path.dirname(mine), "failed", os.path.basename(mine))):
                warn("hub rejected the request (sent by another needs-you run); it is in outbox/failed/")
                return 2
            if not quiet:
                warn("sent by another needs-you run that was sending the outbox")
            return 0
    if isinstance(result, Rejected):
        e = result
        warn("hub rejected the request: HTTP %d %s" % (e.status, clean(e.body.get("message") or e.body.get("error") or "")))
        return 2
    url, status, resp = result
    if as_json:
        print(json.dumps(resp, sort_keys=True))
    elif not quiet:
        if path.endswith("/resolve"):
            ids = [clean(i.get("id")) for i in resp.get("items", [])]
            if ids:
                print("resolved %s via %s" % (", ".join(ids), url))
            else:
                print("nothing open to resolve (already resolved?) via %s" % url)
        else:
            state = "created" if resp.get("created") else ("updated" if resp.get("changed") else "unchanged")
            print("%s %s via %s" % (state, clean(resp.get("id")), url))
    return 0


ANSWER_EXIT_TIMEOUT = 3
ANSWER_EXIT_NONE = 4
ANSWER_POLL_SECONDS = 25  # the hub holds a GET /v1/items/answer at most this long


def answer_wait(cfg: Config, key: str, timeout: float, quiet: bool) -> int:
    """Long-poll GET /v1/items/answer?key= until the person answers (print the answer as
    JSON, exit 0), the time runs out (3) or no answer will come (4: the item closed, its
    question expired or isn't answerable). A hub that can't be reached, or doesn't know the
    item yet (a post still queued or replicating), is asked again until the time runs out.
    Never answers anything itself."""
    if not cfg.ok:
        warn("NEEDS_YOU_URLS / NEEDS_YOU_TOKEN not set (%s)" % config_path())
        return 2
    key = key.strip()
    deadline = time.monotonic() + max(0.0, timeout)
    last_note = ""
    while True:
        left = deadline - time.monotonic()
        wait = int(max(0, min(ANSWER_POLL_SECONDS, left)))
        path = "/v1/items/answer?" + urllib.parse.urlencode({"key": key, "wait": wait})
        got: Optional[Tuple[int, Dict[str, Any]]] = None
        for url in cfg.urls:
            try:
                status, body = _call(url, cfg.token, "GET", path, None, wait + cfg.timeout)
            except (OSError, ValueError) as e:
                last_note = "%s: %s" % (url, getattr(e, "reason", e))
                continue
            if status == 421 or status >= 500:
                last_note = "%s: HTTP %d" % (url, status)
                continue
            got = (status, body)
            if status != 404:
                break
        if got is not None:
            status, body = got
            if status == 200 and isinstance(body.get("answers"), list):
                print(json.dumps(body, sort_keys=True))
                return 0
            if status == 409:
                if not quiet:
                    warn("no answer will come: %s" % clean(body.get("message") or body.get("error") or ""))
                return ANSWER_EXIT_NONE
            if status in (400, 401, 403):
                warn("hub refused: HTTP %d %s" % (status, clean(body.get("message") or body.get("error") or "")))
                return 2
            if status == 404:
                last_note = "no item %r from this token yet" % key
        left = deadline - time.monotonic()
        if left <= 0:
            if not quiet:
                warn("no answer within %gs%s" % (timeout, " (%s)" % clean(last_note) if last_note else ""))
            return ANSWER_EXIT_TIMEOUT
        if got is None or got[0] != 204:
            time.sleep(min(2.0, left))  # unreachable, or not there yet: don't spin


def hours_arg(raw: str) -> float:
    """--expires-in: hours, a finite number within a century (the hub takes dates to 9999)."""
    try:
        h = float(raw)
    except ValueError:
        raise argparse.ArgumentTypeError("not a number of hours: %r" % raw)
    if h != h or abs(h) > 876000:
        raise argparse.ArgumentTypeError("hours must be a finite number up to 876000 (100 years)")
    return h


def parse_link(raw: str) -> Dict[str, str]:
    """'Label=URL'. A bare URL (or one whose only '=' is in its query) gets the label 'Link'."""
    label, sep, url = raw.partition("=")
    if not sep or "://" in label or not label.strip():
        return {"label": "Link", "url": raw.strip()}
    return {"label": label.strip(), "url": url.strip()}


MAX_STEPS = 10
# Where a step's URL starts: "=" then scheme:// or one of the hub's schemes (the hub
# enforces the allow-list; this only finds the split).
_STEP_URL_RE = re.compile(r"=\s*(?=(?:[A-Za-z][A-Za-z0-9+.-]*://|(?:https|slack|vscode|cursor|figma"
                          r"|msteams|discord|linear|needsyou):\S))", re.I)


def parse_step(raw: str) -> Dict[str, Any]:
    """'Text' or 'Text=URL'. Splits at the first '=' that starts a URL, so '=' in the text
    (and in the URL's query) is kept."""
    m = _STEP_URL_RE.search(raw)
    if not m:
        return {"text": raw.strip()}
    return {"text": raw[:m.start()].strip(), "link": {"label": "Open", "url": raw[m.end():].strip()}}


def parse_question_json(raw: str) -> Dict[str, Any]:
    if raw.startswith("@"):
        with open(raw[1:], "r", encoding="utf-8") as fh:
            raw = fh.read()
    question = json.loads(raw)
    if not isinstance(question, dict):
        raise ValueError("must be a JSON object")
    return question


def parse_steps_json(raw: str) -> List[Any]:
    if raw.startswith("@"):
        with open(raw[1:], "r", encoding="utf-8") as fh:
            raw = fh.read()
    steps = json.loads(raw)
    if not isinstance(steps, list):
        raise ValueError("must be a JSON array")
    return steps


def build_item(args: argparse.Namespace, cfg: Config, kind: str) -> Dict[str, Any]:
    body = args.body
    if args.body_file:
        if args.body_file == "-":
            body = sys.stdin.read()
        else:
            with open(args.body_file, "r", encoding="utf-8") as fh:
                body = fh.read()
    item: Dict[str, Any] = {"key": args.key, "title": args.title, "kind": kind,
                            "context": args.context or cfg.default_context, "priority": args.priority}
    if body:
        item["body"] = body
    if args.link:
        item["links"] = args.link
    steps = list(args.steps_json or []) + list(args.step or [])
    if steps:
        item["steps"] = steps
    if getattr(args, "question_json", None):
        item["question"] = args.question_json
    source = {"host": args.host or cfg.host}
    if args.agent:
        source["agent"] = args.agent
    if args.project:
        source["project"] = args.project
    item["source"] = source
    if args.expires_in is not None:
        exp = time.time() + args.expires_in * 3600
        item["expires_at"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(exp))
    return item


def main(argv: Optional[List[str]] = None) -> int:
    global _QUIET
    _QUIET = False
    code = _main(argv)
    if _UPDATE_REQUESTED_BY:
        on_update_requested(_UPDATE_REQUESTED_BY, _QUIET)
    return code


_QUIET = False


def _main(argv: Optional[List[str]] = None) -> int:
    global _QUIET
    p = argparse.ArgumentParser(prog="needs-you", description=__doc__.split("\n")[0],
                                epilog="See docs/AGENT-GUIDE.md for when and how to post.")
    p.add_argument("--version", action="version", version="needs-you " + VERSION)
    p.add_argument("-q", "--quiet", action="store_true", help="no output on success")
    p.add_argument("--json", action="store_true", help="print the hub's JSON response")
    sub = p.add_subparsers(dest="cmd")

    def item_parser(name: str, help_: str, aliases: Sequence[str] = ()) -> argparse.ArgumentParser:
        sp = sub.add_parser(name, help=help_, aliases=list(aliases))
        sp.add_argument("--key", required=True, help="stable dedupe key, e.g. work:ACME-123:redo-blocked")
        sp.add_argument("--title", required=True, help="the action needed, <= 100 chars")
        sp.add_argument("--body", help="markdown, <= 2000 chars")
        sp.add_argument("--body-file", help="read the body from a file ('-' for stdin)")
        sp.add_argument("--context", choices=("work", "personal"), default=None,
                        help="default: $NEEDS_YOU_DEFAULT_CONTEXT, else work")
        sp.add_argument("--priority", choices=("urgent", "normal", "low"), default="normal")
        sp.add_argument("--link", action="append", type=parse_link, metavar="LABEL=URL",
                        help="repeatable, at most 6")
        sp.add_argument("--step", action="append", type=parse_step, metavar="TEXT[=URL]",
                        help="a step the person has to do, in order; repeatable, at most %d" % MAX_STEPS)
        sp.add_argument("--question-json", metavar="JSON|@PATH",
                        help='what an agent asked, read-only: {"items": [{"text", "options": [{"label", '
                             '"description"}], "multi_select"}]}')
        sp.add_argument("--steps-json", metavar="JSON|@PATH",
                        help='steps as a JSON array of {"text", "link": {"label", "url"}, "done"}')
        sp.add_argument("--agent", help="source agent, e.g. orca:redo-fixer")
        sp.add_argument("--project", help="source project")
        sp.add_argument("--host", help="source host (default: this machine's hostname)")
        sp.add_argument("--expires-in", type=hours_arg, metavar="HOURS",
                        help="expiry (done/info default to 24 h on the hub)")
        if name == "add":
            sp.add_argument("--kind", choices=("needs", "done", "info"), default="needs")
        return sp

    item_parser("add", "add or update an item (kind needs by default)", aliases=("post",))
    item_parser("done", "FYI: something finished (expires in 24 h, never counted)")
    item_parser("info", "FYI: information (expires in 24 h, never counted)")
    rp = sub.add_parser("resolve", help="mark an item handled")
    g = rp.add_mutually_exclusive_group(required=True)
    g.add_argument("--key")
    g.add_argument("--id")
    ap = sub.add_parser("answer-wait", help="wait for the person's answer to the answerable question "
                        "posted under KEY; print it as JSON (exit 3: timed out, 4: none will come)")
    ap.add_argument("--key", required=True)
    ap.add_argument("--timeout", type=float, default=600.0, metavar="SECONDS",
                    help="give up after this long (default 600)")
    add_run_parser(sub)
    sub.add_parser("flush", help="send queued items now")
    sub.add_parser("health", help="check hubs and token")
    for name in ("update", "self-update"):
        up = sub.add_parser(name, help="update the CLI, hook, skill and Orca snippet installed here from the first hub that answers"
                            if name == "update" else "same as update")
        up.add_argument("--check", action="store_true", help="report what would change; change nothing")
        up.add_argument("--auto", action="store_true",
                        help="quiet, never fails (what flush runs once a day with NEEDS_YOU_AUTO_UPDATE=1)")
        up.add_argument("--rollback", action="store_true", help="put back the files the last update replaced")
        up.add_argument("--allow-downgrade", action="store_true", help="install the hub's files even if they're older")
    uh = sub.add_parser("uninstall-hooks", help="remove the agent hooks: Claude Code, Codex, Gemini CLI, "
                        "opencode, Copilot CLI, Cursor, Cline, Aider, Kimi Code, Grok Build (offline; no hub needed)")
    uh.add_argument("--user", action="store_true", help="Claude Code's user level (~/.claude)")
    uh.add_argument("--project", nargs="?", const=".", metavar="DIR",
                    help="the Claude Code project covering DIR (default: the current directory)")
    for a in UNINSTALL_AGENTS:
        uh.add_argument("--" + a, dest="un_" + a, action="store_true", help="the %s install" % a)
    uh.add_argument("--mcp", dest="un_mcp", action="store_true",
                    help="the needs-you MCP server: its registration with every agent, and needs-you-mcp")
    uh.add_argument("--instructions", dest="un_instructions", action="store_true",
                    help="the needs-you block in Codex, Gemini CLI and opencode's instruction files")
    im = sub.add_parser("install-mcp", help="register the needs-you-mcp next to this CLI with these agents "
                        "(the invite installer's --mcp runs this)")
    im.add_argument("agents", metavar="AGENTS", help="comma-separated: " + ",".join(MCP_AGENTS))
    im.add_argument("--dry-run", action="store_true", help="say what would change; change nothing")
    ii = sub.add_parser("install-instructions", help="add the needs-you rules as a marked block to these agents' "
                        "instruction files (the invite installer's --agent-instructions runs this)")
    ii.add_argument("agents", metavar="AGENTS", help="comma-separated: " + ",".join(INSTR_AGENTS))
    ii.add_argument("--from", dest="source", required=True, metavar="FILE",
                    help="the text: the hub's /dl/%s" % INSTR_DL)
    ii.add_argument("--dry-run", action="store_true", help="say what would change; change nothing")
    uh.add_argument("--dry-run", action="store_true", help="say what would change; change nothing")
    dp = sub.add_parser("doctor", help="check this machine's setup (read-only; never posts)")
    dp.add_argument("--json", dest="doctor_json", action="store_true",
                    help="machine-readable: {ok, version, checks: [{check, status, detail, hint}]}")

    args = p.parse_args(argv)
    if args.cmd == "post":  # the docs say "post an item"; agents guess it
        args.cmd = "add"
    _QUIET = bool(args.quiet or args.json)
    if not args.cmd:
        p.print_help()
        return 2
    cfg = Config()
    if args.cmd in ("update", "self-update"):
        if args.rollback:
            return rollback(args.quiet, args.json)
        return update(cfg, check=args.check, auto=args.auto, quiet=args.quiet or args.auto, as_json=args.json,
                      allow_downgrade=args.allow_downgrade)
    if args.cmd == "uninstall-hooks":  # local files only: no hub, no outbox
        return uninstall_hooks(args.user, args.project, [a for a in UNINSTALL_AGENTS + ("mcp", "instructions")
                                                         if getattr(args, "un_" + a)],
                               args.dry_run, args.quiet)
    if args.cmd == "install-mcp":  # local files only
        return install_mcp(args.agents, args.dry_run, args.quiet)
    if args.cmd == "install-instructions":
        return install_instructions(args.agents, args.source, args.dry_run, args.quiet)
    if args.cmd == "doctor":  # before the flush below: doctor changes nothing
        return doctor(cfg, args.json or args.doctor_json)
    if args.cmd == "run":  # the command starts at once; the outbox is sent after it
        return run_command(cfg, args)

    # Every invocation drains the outbox first, so queued items go out in order (add and
    # resolve do it in deliver(), holding the outbox lock until their own request is sent).
    sent = dropped = 0
    remaining = len(pending())
    if args.cmd in ("flush", "health"):
        sent, dropped, remaining = flush(cfg, verbose=not args.quiet and args.cmd == "flush")

    if args.cmd == "flush":
        reaped = reap_leases(cfg, verbose=not args.quiet)
        if not args.quiet:
            print("sent %d, dropped %d, %d still queued" % (sent, dropped, remaining)
                  + (", resolved %d from ended sessions" % reaped if reaped else ""))
        auto_update(cfg)
        return 0
    if args.cmd == "health":
        return health(cfg, remaining)
    if args.cmd == "answer-wait":
        if args.timeout != args.timeout or args.timeout < 0:
            warn("--timeout must be a number of seconds")
            return 2
        flush(cfg)  # a queued post of this item goes out first
        return answer_wait(cfg, args.key, args.timeout, args.quiet)
    if args.cmd == "resolve":
        if not (args.key if args.key is not None else args.id).strip():
            warn("resolve: --key/--id must not be empty")
            return 2
        body = {"key": args.key} if args.key is not None else {"id": args.id}
        rc = deliver(cfg, "POST", "/v1/items/resolve", body, args.quiet, args.json)
        if rc == 0 and args.key:
            note_session_item(args.key, open_=False)
        elif rc == 0:  # (also forgotten by key once the hub names what it resolved)
            forget_session_item_id(args.id)
        return rc
    kind = args.kind if args.cmd == "add" else args.cmd
    if args.link and len(args.link) > 6:
        warn("at most 6 links")
        return 2
    if args.steps_json:
        try:
            args.steps_json = parse_steps_json(args.steps_json)
        except (OSError, ValueError) as e:
            warn("--steps-json: %s" % e)
            return 2
    if getattr(args, "question_json", None):
        try:
            args.question_json = parse_question_json(args.question_json)
        except (OSError, ValueError) as e:
            warn("--question-json: %s" % e)
            return 2
    if len(args.steps_json or []) + len(args.step or []) > MAX_STEPS:
        warn("at most %d steps" % MAX_STEPS)
        return 2
    try:
        item = build_item(args, cfg, kind)
    except (OSError, UnicodeDecodeError) as e:  # --body-file
        warn("--body-file: %s" % e)
        return 2
    rc = deliver(cfg, "POST", "/v1/items", item, args.quiet, args.json)
    if rc == 0:
        note_session_item(args.key, open_=kind == "needs", expires_in=args.expires_in)
    return rc


