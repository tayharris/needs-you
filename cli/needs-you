    def _alerts_part(self) -> str:
        alerts, where = self.setting("NEEDS_YOU_AGENT_ALERTS")
        if alerts.lower() in _OFF:
            return "alerts off (NEEDS_YOU_AGENT_ALERTS=%s in %s)" % (alerts, where)
        if alerts.lower() in _ON:
            return "alerts on (NEEDS_YOU_AGENT_ALERTS=%s in %s)" % (alerts, where)
        return "alerts off until opted in"

    def _hook_copy_problems(self, hook: str, marker: str, label: str) -> List[str]:
        if not os.path.isfile(hook):
            return ["%s is missing" % _tilde(hook)]
        problems = []
        if not os.access(hook, os.X_OK):
            problems.append("%s is not executable" % _tilde(hook))
        try:
            with open(hook, "r", encoding="utf-8", errors="replace") as fh:
                if marker not in fh.read():
                    problems.append("old hook (no %s support)" % label)
        except OSError:
            pass
        return problems

