# The Cline hook files install-cline-hooks.sh writes, one per event.
CLINE_EVENTS = ("TaskComplete", "TaskError", "UserPromptSubmit", "TaskCancel", "TaskStart", "TaskResume",
                "SessionShutdown")
AIDER_BEGIN = "# needs-you (managed by install-aider-notifications.sh; do not edit between these markers)"
AIDER_END = "# end needs-you"


def _cline_stub(path: str) -> bool:
    """A Cline hook file install-cline-hooks.sh wrote (never one of the person's own)."""
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            text = fh.read(4096)
    except OSError:
        return False
    return "\n# needs-you: " in text and HOOK_FILE in text


def _rmdir_quiet(path: str, dry_run: bool) -> None:
    if not dry_run:
        try:
            os.rmdir(path)
        except OSError:
            pass


def _strip_aider_block(path: str, dry_run: bool, say: Any) -> Optional[bool]:
    """Take the needs-you block out of an Aider config file. True when it removed (or would
    remove) it, False when there was none, None when it couldn't."""
    try:
        with open(path, "r", encoding="utf-8", newline="") as fh:  # CRLF stays CRLF
            text = fh.read()
    except FileNotFoundError:
        return False
    except (OSError, UnicodeDecodeError) as e:
        warn("%s: can't read it (%s); nothing was changed" % (_tilde(path), e))
        return None
    out, inside, found = [], False, False
    for line in text.splitlines(keepends=True):
        s = line.rstrip("\r\n")
        if s == AIDER_BEGIN:
            inside = found = True
        elif inside:
            inside = s != AIDER_END
        else:
            out.append(line)
    if not found:
        return False
    if inside:
        warn("%s: the needs-you block has no end marker; remove it by hand" % _tilde(path))
        return None
    if dry_run:
        say("would remove the needs-you lines from %s" % _tilde(path))
        return True
    new = "".join(out)
    try:
        if new.strip():
            _write_atomic(path, new.encode("utf-8"), os.stat(path).st_mode & 0o777)
        else:
            os.remove(path)
    except OSError as e:
        warn("%s: couldn't write it (%s)" % (_tilde(path), e))
        return None
    say("removed the needs-you lines from %s" % _tilde(path))
    return True


def cli_path() -> str:
    return os.path.realpath(sys.argv[0] if sys.argv and sys.argv[0] else __file__)


def _stamp(path: str) -> Optional[str]:
    """The version stamp in an installed file ("needs-you-version: X.Y.Z"), "unknown" for a
    file from before stamps, None when it isn't installed."""
    import re
    try:
        with open(path, "rb") as fh:
            head = fh.read(4096).decode("utf-8", "replace")
    except OSError:
        return None
    m = re.search(r'(?:needs[-_]you[-_]version"?\s*:\s*"?|^VERSION = ")(\d+\.\d+\.\d+)', head, re.M)
    return m.group(1) if m else "unknown"


_CLIENT_HEADER: Optional[str] = None


def client_header() -> str:
    """X-Needs-You-Client: what this machine runs, so the owner sees who is behind."""
    global _CLIENT_HEADER
    if _CLIENT_HEADER is None:
        paths = installed_paths()
        parts = ["cli=" + (VERSION if _vtuple(VERSION) else "unknown")]
        for name, key in (("needs-you-hook.sh", "hook"), ("SKILL.md", "skill"), ("orca-snippet.md", "orca")):
            parts.append("%s=%s" % (key, _stamp(paths[name]) or "none"))
        _CLIENT_HEADER = "; ".join(parts)
    return _CLIENT_HEADER


def _vtuple(v: Any) -> Optional[Tuple[int, int, int]]:
    import re
    m = re.match(r"^(\d+)\.(\d+)\.(\d+)", str(v or ""))
    return (int(m.group(1)), int(m.group(2)), int(m.group(3))) if m else None


def _sha256_file(path: str) -> Optional[str]:
    try:
        with open(path, "rb") as fh:
            return hashlib.sha256(fh.read()).hexdigest()
    except OSError:
        return None


# The hub URL (from this machine's config) whose response said `update_requested`, if any.
_UPDATE_REQUESTED_BY: Optional[str] = None


def send(cfg: Config, method: str, path: str, body: Optional[Dict[str, Any]]) -> Tuple[str, int, Dict[str, Any]]:
    """Try each hub in order. 2xx -> result. 4xx -> Rejected (no failover: every hub
    would say the same), except 421. Network errors, timeouts, 421 and 5xx -> next hub;
    none -> Unreachable."""
    errors = []
    for url in cfg.urls:
        try:
            status, parsed = _call(url, cfg.token, method, path, body, cfg.timeout)
        except (OSError, ValueError) as e:  # URLError, timeouts, refused, bad JSON
            errors.append("%s: %s" % (url, getattr(e, "reason", e)))
            continue
        if 200 <= status < 300:
            if parsed.get("update_requested") is True:
                global _UPDATE_REQUESTED_BY
                _UPDATE_REQUESTED_BY = url
            return url, status, parsed
        # 421: that hub doesn't answer to this URL's host name (its DNS-rebinding check);
        # a URL problem, not a request problem, so the next hub may well take it.
        if 400 <= status < 500 and status != 421:
            raise Rejected(status, parsed)
        errors.append("%s: HTTP %d" % (url, status))
    raise Unreachable("; ".join(errors) or "no hub URL configured")


