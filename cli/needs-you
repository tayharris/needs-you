def _duration(seconds: float) -> str:
    s = int(seconds)
    if s < 60:
        return "%ds" % s
    if s < 3600:
        return "%dm %02ds" % (s // 60, s % 60)
    return "%dh %02dm" % (s // 3600, (s % 3600) // 60)


def scrub_tail(raw: bytes, lines: int = RUN_TAIL_LINES, width: int = RUN_LINE_MAX) -> List[str]:
    """The last few lines of a command's stderr, safe for a card: escape sequences and control
    characters dropped, carriage-return redraws collapsed, obvious secrets redacted, truncated."""
    text = raw.decode("utf-8", "replace")
    out: List[str] = []
    for line in text.split("\n"):
        line = _ANSI_RE.sub("", line)
        line = line.rsplit("\r", 1)[-1] if "\r" in line.rstrip("\r") else line.rstrip("\r")
        line = _INVISIBLE_RE.sub("", line.replace("\t", "    ")).rstrip()
        line = _SECRET_RAW_RE.sub("<redacted>", line)
        line = _SECRET_KV_RE.sub(lambda m: m.group(1) + m.group(2) + "<redacted>", line)
        line = _SECRET_AUTH_RE.sub(lambda m: m.group(1) + m.group(2) + "<redacted>", line)
        line = line.replace("```", "'''")
        if line.strip():
            out.append(line if len(line) <= width else line[:width - 1] + "…")
    return out[-lines:]


def run_command(cfg: Config, args: argparse.Namespace) -> int:
    import signal
    import subprocess
    cmd = list(args.command or [])
    if cmd and cmd[0] == "--":
        cmd = cmd[1:]
    if not cmd:
        warn("run: no command given (needs-you run [options] -- CMD [ARGS...])")
        return 2
    if args.link and len(args.link) > 6:
        warn("at most 6 links")
        return 2
    name = os.path.basename(cmd[0]) or cmd[0]
    key = args.key or "%s:%s:run:%s" % (args.context or cfg.default_context, cfg.host,
                                        re.sub(r"[^A-Za-z0-9._-]", "-", name)[:60])
    context = args.context or ("personal" if key.startswith("personal:") else cfg.default_context)
    start = time.monotonic()
    tail = b""
    interrupted = False
    start_error = ""
    try:
        proc = subprocess.Popen(cmd, stderr=None if args.no_output else subprocess.PIPE)
    except OSError as e:
        rc = 127 if isinstance(e, FileNotFoundError) else 126
        start_error = e.strerror or type(e).__name__
        warn("run: cannot start %s: %s" % (name, start_error))
    else:
        old_term = signal.getsignal(signal.SIGTERM)
        signal.signal(signal.SIGTERM, lambda s, f: proc.send_signal(s))  # stopping us stops the command
        # stderr is passed through (and its tail kept) by a thread, while this one waits for
        # the command itself: something the command left running in the background can hold
        # the pipe open for hours, and the command must never block on a full pipe, also
        # while we're being interrupted.
        tail_buf: List[bytes] = [b""]
        reader = None
        if proc.stderr is not None:
            import threading

            def pump(fd: int) -> None:
                while True:
                    try:
                        chunk = os.read(fd, 65536)
                    except InterruptedError:
                        continue
                    except OSError:
                        return
                    if not chunk:
                        return
                    try:
                        sys.stderr.buffer.write(chunk)
                        sys.stderr.buffer.flush()
                    except (OSError, ValueError):
                        pass
                    tail_buf[0] = (tail_buf[0] + chunk)[-16384:]

            reader = threading.Thread(target=pump, args=(proc.stderr.fileno(),), daemon=True)
            reader.start()
        try:
            rc = proc.wait()
        except KeyboardInterrupt:  # Ctrl-C reached the command too; a person is watching
            interrupted = True
            try:
                rc = proc.wait()
            except KeyboardInterrupt:
                proc.kill()
                rc = proc.wait()
        finally:
            signal.signal(signal.SIGTERM, old_term)
        if reader is not None:
            reader.join(1.0)  # what the command wrote last; not what a background child holds
            tail = tail_buf[0]
    if rc < 0:
        rc = 128 - rc
    elapsed = time.monotonic() - start
    if interrupted:
        return rc
    try:  # reporting must never change the command's result
        flush(cfg)
        _report_run(cfg, args, key, context, name, cmd, rc, elapsed, tail, start_error)
    except Exception as e:  # noqa: BLE001
        warn("run: could not report (%s)" % type(e).__name__)
    return rc


def _report_run(cfg: Config, args: argparse.Namespace, key: str, context: str, name: str, cmd: List[str],
                rc: int, elapsed: float, tail: bytes, start_error: str) -> None:
    source = {"host": cfg.host, "agent": (args.agent or "run:" + name)[:100]}
    if args.project:
        source["project"] = args.project
    if rc == 0:
        deliver(cfg, "POST", "/v1/items/resolve", {"key": key}, True, False)
        if args.done_after >= 0 and elapsed >= args.done_after:
            title = args.done_title or "%s finished on %s" % (name, cfg.host)
            item = {"key": key, "kind": "done", "context": context, "priority": "low",
                    "title": title[:100], "body": "Took %s." % _duration(elapsed), "source": source}
            if args.link:
                item["links"] = args.link
            deliver(cfg, "POST", "/v1/items", item, True, False)
        return
    title = args.title or "%s failed on %s" % (name, cfg.host)
    if start_error:
        body = "`%s` could not start on `%s`: %s." % (name, cfg.host, start_error)
    else:
        body = "`%s` exited %d on `%s` after %s." % (name, rc, cfg.host, _duration(elapsed))
    lines = [] if args.no_output else scrub_tail(tail)
    if lines:
        body += "\n\nLast lines of stderr:\n```\n%s\n```" % "\n".join(lines)
    item = {"key": key, "kind": "needs", "context": context, "priority": args.priority,
            "title": title[:100], "body": body[:2000], "source": source}
    if args.link:
        item["links"] = args.link
    if args.expires_in is not None:
        item["expires_at"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(time.time() + args.expires_in * 3600))
    deliver(cfg, "POST", "/v1/items", item, True, False)


