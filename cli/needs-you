def _tailnet_ip(ip: str) -> bool:
    import ipaddress
    try:
        a = ipaddress.ip_address(ip.split("%", 1)[0])
    except ValueError:
        return False
    if a.version == 4:
        return a in ipaddress.ip_network("100.64.0.0/10")
    return a in ipaddress.ip_network("fd7a:115c:a1e0::/48")


class UpdateTarget:
    """The update hub, parsed once. Every update request connects to `connect_host` (for
    plain http: the one address checked, so a second DNS answer can't change it) and sends
    `host_header`; redirects are never followed."""

    def __init__(self, scheme: str, host: str, port: int, base_path: str, connect_host: str, why: str) -> None:
        self.scheme, self.host, self.port, self.base_path = scheme, host, port, base_path
        self.connect_host, self.why = connect_host, why

    @property
    def host_header(self) -> str:
        h = "[%s]" % self.host if ":" in self.host else self.host
        default = 443 if self.scheme == "https" else 80
        return h if self.port == default else "%s:%d" % (h, self.port)

    @property
    def url(self) -> str:
        return "%s://%s%s" % (self.scheme, self.host_header, self.base_path)


def resolve_update_target(url: str, resolve: Any = None) -> UpdateTarget:
    """Updates are code, so they only travel over https (certificate checked against the
    name), loopback, or the tailnet (Tailscale encrypts it): an address in 100.64.0.0/10 or
    fd7a:115c:a1e0::/48, or a *.ts.net name whose one resolution lands there. Raises
    UpdateRefused for anything else, including URL forms that could mean two things."""
    import ipaddress
    import urllib.parse
    raw = url.strip()
    if any(ord(c) < 0x21 or ord(c) > 0x7e for c in raw) or "\\" in raw:
        raise UpdateRefused("the hub URL has spaces, control or non-ASCII characters")
    try:
        parts = urllib.parse.urlsplit(raw)
        port = parts.port
    except ValueError:
        raise UpdateRefused("the hub URL doesn't parse")
    scheme = parts.scheme.lower()
    if scheme not in ("http", "https"):
        raise UpdateRefused("not an http(s) URL")
    if "@" in parts.netloc or parts.username is not None or parts.password is not None:
        raise UpdateRefused("the hub URL has a user part (@)")
    if parts.query or parts.fragment:
        raise UpdateRefused("the hub URL has a query or fragment")
    host = (parts.hostname or "").lower()
    if not host or host.endswith(".") or ".." in host or host.startswith("xn--") or ".xn--" in host:
        raise UpdateRefused("the hub URL's host %r isn't a plain name or address" % host)
    port = port or (443 if scheme == "https" else 80)
    base = parts.path.rstrip("/")
    try:
        ip = ipaddress.ip_address(host)
    except ValueError:
        ip = None
    if scheme == "https":
        return UpdateTarget(scheme, host, port, base, host, "https")
    if ip is not None:
        if ip.is_loopback:
            return UpdateTarget(scheme, host, port, base, host, "loopback")
        if _tailnet_ip(str(ip)):
            return UpdateTarget(scheme, host, port, base, host, "tailnet address")
        raise UpdateRefused("plain http to %s, which isn't loopback or the tailnet" % host)
    if host == "localhost":
        return UpdateTarget(scheme, host, port, base, "127.0.0.1", "loopback")
    if not host.endswith(".ts.net"):
        raise UpdateRefused("plain http to %s, which isn't loopback or the tailnet" % host)
    try:
        addrs = (resolve or socket.getaddrinfo)(host, port, 0, socket.SOCK_STREAM)
    except OSError:
        raise UpdateRefused("%s doesn't resolve" % host)
    ips = sorted({str(a[4][0]).split("%", 1)[0] for a in addrs})
    if not ips or not all(_tailnet_ip(i) for i in ips):
        raise UpdateRefused("%s resolves outside the tailnet (%s)" % (host, ", ".join(ips) or "nothing"))
    return UpdateTarget(scheme, host, port, base, ips[0], "tailnet name (%s)" % ips[0])


def update_transport_ok(url: str, resolve: Any = None) -> Tuple[bool, str]:
    try:
        return True, resolve_update_target(url, resolve).why
    except UpdateRefused as e:
        return False, str(e)


def update_hub(cfg: Config) -> str:
    """The one hub updates come from: NEEDS_YOU_UPDATE_HUB, else the first hub in the config
    (the one the invite set up). Never a failover hub, never a URL a hub sent."""
    explicit = _setting(cfg, "NEEDS_YOU_UPDATE_HUB").strip().rstrip("/")
    return explicit or (cfg.urls[0] if cfg.urls else "")


MAX_UPDATE_BYTES = 8 * 1024 * 1024


def pinned_get(t: UpdateTarget, path: str, timeout: float, token: str = "") -> bytes:
    """GET t.base_path + path on exactly t.connect_host:t.port. Anything but 200 (a redirect
    included) raises."""
    import http.client
    import ssl
    if t.scheme == "https":
        conn: Any = http.client.HTTPSConnection(t.host, t.port, timeout=timeout, context=ssl.create_default_context())
    else:
        conn = http.client.HTTPConnection(t.connect_host, t.port, timeout=timeout)
    try:
        conn.putrequest("GET", t.base_path + path, skip_host=True, skip_accept_encoding=True)
        conn.putheader("Host", t.host_header)
        conn.putheader("User-Agent", "needs-you-cli/" + VERSION)
        conn.putheader("X-Needs-You-Client", client_header())
        if token:
            conn.putheader("Authorization", "Bearer " + token)
        conn.endheaders()
        resp = conn.getresponse()
        if resp.status != 200:
            raise UpdateRefused("%s answered HTTP %d for %s%s" % (t.url, resp.status, path,
                                " (redirects aren't followed)" if 300 <= resp.status < 400 else
                                " (hub older than 0.1.2)" if resp.status == 404 and path == "/dl/manifest.json" else ""))
        data = resp.read(MAX_UPDATE_BYTES + 1)
        if len(data) > MAX_UPDATE_BYTES:
            raise UpdateRefused("%s sent more than %d bytes for %s" % (t.url, MAX_UPDATE_BYTES, path))
        return data
    finally:
        conn.close()


def fetch_manifest(cfg: Config, errors: List[str]) -> Optional[Tuple[UpdateTarget, Dict[str, Any]]]:
    """(update hub, manifest), or None with the reason in `errors`."""
    url = update_hub(cfg)
    if not url:
        errors.append("NEEDS_YOU_URLS is not set (%s)" % config_path())
        return None
    try:
        t = resolve_update_target(url)
    except UpdateRefused as e:
        errors.append("%s: refusing to update: %s; use the hub's https or tailnet URL "
                      "(or set NEEDS_YOU_UPDATE_HUB)" % (clean(url), e))
        return None
    timeout = max(cfg.timeout, 10)
    try:
        health = json.loads(pinned_get(t, "/v1/health", cfg.timeout, cfg.token).decode("utf-8"))
        if not isinstance(health, dict) or not health.get("ok"):
            raise ValueError("not a healthy hub")
        manifest = json.loads(pinned_get(t, "/dl/manifest.json", timeout).decode("utf-8"))
        if not isinstance(manifest, dict) or not isinstance(manifest.get("files"), dict):
            raise ValueError("not a manifest")
    except UpdateRefused as e:
        errors.append(str(e))
        return None
    except (OSError, ValueError) as e:
        errors.append("%s: %s" % (t.url, clean(getattr(e, "reason", e))))
        return None
    return t, manifest


def _valid_cli(data: bytes) -> bool:
    try:
        src = data.decode("utf-8")
        if not src.startswith("#!") or "def main(" not in src:
            return False
        compile(src, "needs-you", "exec")
        return True
    except (UnicodeDecodeError, SyntaxError, ValueError):
        return False


def _write_atomic(path: str, data: bytes, mode: int) -> None:
    real = os.path.realpath(path)
    d = os.path.dirname(real)
    tmp = os.path.join(d, ".%s.%d.tmp" % (os.path.basename(real), os.getpid()))
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
        with os.fdopen(fd, "wb") as fh:
            fh.write(data)
        os.chmod(tmp, mode)
        os.replace(tmp, real)
    except OSError:
        try:
            os.remove(tmp)
        except OSError:
            pass
        raise


def plan_update(manifest: Dict[str, Any], allow_downgrade: bool = False) -> Tuple[List[Dict[str, Any]], List[str]]:
    """Which installed files differ from the hub's. Returns (changes, notes)."""
    files = manifest.get("files") or {}
    notes: List[str] = []
    changes: List[Dict[str, Any]] = []
    hub_v = _vtuple(manifest.get("version"))
    mine = _vtuple(VERSION)
    if hub_v is None:
        raise UpdateRefused("the hub's manifest has no X.Y.Z version")
    if mine is not None and hub_v < mine and not allow_downgrade:
        notes.append("the hub serves %s, this CLI is %s: not downgrading (--allow-downgrade to do it anyway)"
                     % (clean(manifest.get("version")), VERSION))
        return changes, notes
    for name, path in installed_paths().items():
        entry = files.get(name)
        if not isinstance(entry, dict):
            continue
        if name != "needs-you" and not os.path.isfile(path):
            continue  # never install a piece that isn't here
        want = str(entry.get("sha256") or "").lower()
        if len(want) != 64 or any(c not in "0123456789abcdef" for c in want):
            raise UpdateRefused("the hub's manifest has no valid checksum for %s" % name)
        have = _sha256_file(path)
        if have != want:
            changes.append({"file": name, "path": path, "sha256": want, "size": entry.get("size"),
                            "from": _stamp(path) if name != "needs-you" else VERSION,
                            "to": entry.get("version") or "?"})
    # The hook's entries in ~/.claude/settings.json: re-merged when the hook or hooks.json
    # changed since the last update (install-hooks.sh is idempotent).
    settings = _home(".claude", "settings.json")
    try:
        with open(settings, "r", encoding="utf-8") as fh:
            referenced = "needs-you-hook.sh" in fh.read()
    except OSError:
        referenced = False
    hj = files.get("hooks.json")
    if referenced and isinstance(hj, dict):
        if not isinstance(files.get("install-hooks.sh"), dict):
            raise UpdateRefused("the hub's manifest lists hooks.json without install-hooks.sh")
        applied = _read_state().get("hooks_json_sha256")
        if applied != hj.get("sha256") or any(c["file"] == "needs-you-hook.sh" for c in changes):
            changes.append({"file": "hooks.json", "path": settings, "sha256": str(hj.get("sha256") or ""),
                            "size": hj.get("size"), "from": "?", "to": hj.get("version") or "?"})
    # Codex CLI: its own copy of the hook, and its entries in <codex home>/hooks.json.
    codex_hook = os.path.join(codex_home(), "hooks", "needs-you-hook.sh")
    he = files.get("needs-you-hook.sh")
    if os.path.isfile(codex_hook) and isinstance(he, dict):
        want = str(he.get("sha256") or "").lower()
        if len(want) != 64 or any(c not in "0123456789abcdef" for c in want):
            raise UpdateRefused("the hub's manifest has no valid checksum for needs-you-hook.sh")
        if _sha256_file(codex_hook) != want:
            changes.append({"file": "needs-you-hook.sh", "label": "needs-you-hook.sh (Codex)",
                            "backup": "codex-needs-you-hook.sh", "path": codex_hook,
                            "sha256": want, "size": he.get("size"), "from": _stamp(codex_hook),
                            "to": he.get("version") or "?"})
    codex_json = os.path.join(codex_home(), "hooks.json")
    try:
        with open(codex_json, "r", encoding="utf-8") as fh:
            codex_referenced = "needs-you-hook.sh" in fh.read()
    except OSError:
        codex_referenced = False
    cj = files.get("codex-hooks.json")
    if codex_referenced and isinstance(cj, dict):
        if not isinstance(files.get("install-codex-hooks.sh"), dict):
            raise UpdateRefused("the hub's manifest lists codex-hooks.json without install-codex-hooks.sh")
        if _read_state().get("codex_hooks_json_sha256") != cj.get("sha256"):
            changes.append({"file": "codex-hooks.json", "path": codex_json, "sha256": str(cj.get("sha256") or ""),
                            "size": cj.get("size"), "from": "?", "to": cj.get("version") or "?"})
    return changes, notes


def _read_state() -> Dict[str, Any]:
    try:
        with open(os.path.join(state_dir(), "update.json"), "r", encoding="utf-8") as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def _write_state(**fields: Any) -> None:
    st = _read_state()
    st.update(fields)
    try:
        os.makedirs(state_dir(), mode=0o700, exist_ok=True)
        _write_atomic(os.path.join(state_dir(), "update.json"), json.dumps(st, sort_keys=True).encode("utf-8"), 0o600)
    except OSError:
        pass


# -- the GitHub release cross-check -------------------------------------------------

def _gh() -> Optional[str]:
    """`gh`, or NEEDS_YOU_GH (a path; "none" turns the cross-check off, as tests do)."""
    import shutil
    forced = os.environ.get("NEEDS_YOU_GH")
    if forced:
        return forced if forced != "none" and os.access(forced, os.X_OK) else None
    return shutil.which("gh")


RELEASE_WORKFLOW = RELEASE_REPO + "/.github/workflows/release.yml"
SLSA_PREDICATE = "https://slsa.dev/provenance/v1"


def check_attestation(output: str, sha256: str, v: str) -> None:
    """`gh attestation verify --format json` output must hold a verified attestation for
    exactly these bytes (subject sha256), with SLSA provenance, signed by RELEASE_REPO's
    release workflow for tag vX.Y.Z on a GitHub-hosted runner. The certificate fields come
    from GitHub's OIDC token, so the workflow can't forge them. Raises UpdateRefused otherwise
    (empty or invalid JSON included)."""
    try:
        entries = json.loads(output)
    except ValueError:
        raise UpdateRefused("gh attestation verify printed no valid JSON")
    if not isinstance(entries, list) or not entries:
        raise UpdateRefused("gh attestation verify returned no attestation")
    repo_uri = "https://github.com/" + RELEASE_REPO
    tag_ref = "refs/tags/v" + v
    reasons = []
    for e in entries:
        try:
            vr = e["verificationResult"]
            st, cert = vr["statement"], vr["signature"]["certificate"]
            digests = {str((s.get("digest") or {}).get("sha256") or "").lower() for s in st.get("subject") or []}
            checks = (
                (sha256.lower() in digests, "the attested digest isn't the downloaded file's"),
                (st.get("predicateType") == SLSA_PREDICATE, "not SLSA provenance"),
                (cert.get("sourceRepositoryURI") == repo_uri, "built from another repository"),
                (cert.get("sourceRepositoryRef") == tag_ref, "built from another ref than %s" % tag_ref),
                (str(cert.get("buildSignerURI") or "").startswith("https://github.com/%s@" % RELEASE_WORKFLOW),
                 "signed by another workflow"),
                (cert.get("runnerEnvironment") == "github-hosted", "built on a self-hosted runner"),
            )
        except (KeyError, TypeError, AttributeError):
            reasons.append("an attestation of an unexpected shape")
            continue
        bad = [why for ok, why in checks if not ok]
        if not bad:
            return
        reasons.append(", ".join(bad))
    raise UpdateRefused("release v%s's provenance doesn't fit: %s" % (v, clean("; ".join(reasons))))


def release_provenance(gh: str, v: str, tarball: str, tarball_sha: str, tmp: str) -> str:
    """Security audit #17 (c): the release's release-manifest.json must list this server
    tarball with this sha256, and carry a GitHub build-provenance attestation from
    RELEASE_REPO's release workflow for this tag (`gh attestation verify` on the downloaded
    file, then check_attestation). Each installed file is bound to that attestation through
    the chain: hub file == the tarball's copy, tarball sha256 == the attested manifest's entry
    (== SHA256SUMS). Raises UpdateRefused on any
    failure (never fails open), except that a private repo can't have attestations (GitHub
    attests public repos only on this plan, and the release workflow skips the step there):
    then it returns a note saying so. Returns what was checked."""
    import subprocess
    sub = os.path.join(tmp, "manifest")
    os.makedirs(sub)
    try:
        r = subprocess.run([gh, "release", "download", "v" + v, "--repo", RELEASE_REPO,
                            "--pattern", "release-manifest.json", "--dir", sub],
                           stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.SubprocessError) as e:
        raise UpdateRefused("gh failed (%s)" % type(e).__name__)
    if r.returncode != 0:
        raise UpdateRefused("gh couldn't download release-manifest.json of v%s (%s)"
                            % (v, clean((r.stderr.strip().splitlines() or [""])[-1])))
    path = os.path.join(sub, "release-manifest.json")
    try:
        with open(path, "r", encoding="utf-8") as fh:
            rm = json.load(fh)
        listed = {str(a.get("name")): str(a.get("sha256") or "").lower() for a in rm.get("assets") or []}
        if rm.get("version") != v:
            raise UpdateRefused("release v%s's release-manifest.json is for another version" % v)
    except (OSError, ValueError, AttributeError, TypeError):
        raise UpdateRefused("couldn't read release-manifest.json of v%s" % v)
    if listed.get(tarball) != tarball_sha:
        raise UpdateRefused("release v%s's release-manifest.json doesn't list this %s" % (v, tarball))
    manifest_sha = _sha256_file(path)
    if not manifest_sha:
        raise UpdateRefused("couldn't read release-manifest.json of v%s" % v)
    # The exact file just read, pinned to the release workflow, the tag and GitHub-hosted runners.
    try:
        r = subprocess.run([gh, "attestation", "verify", path, "--repo", RELEASE_REPO,
                            "--signer-workflow", RELEASE_WORKFLOW, "--source-ref", "refs/tags/v" + v,
                            "--predicate-type", SLSA_PREDICATE, "--deny-self-hosted-runners",
                            "--format", "json"],
                           stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=120)
        if r.returncode == 0:
            check_attestation(r.stdout, manifest_sha, v)
            return "build provenance verified"
        why = clean((r.stderr.strip().splitlines() or ["no output"])[-1])
        p = subprocess.run([gh, "api", "repos/" + RELEASE_REPO, "--jq", ".private"],
                           stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.SubprocessError) as e:
        raise UpdateRefused("gh attestation verify failed (%s)" % type(e).__name__)
    if p.returncode == 0 and p.stdout.strip() == "true":
        return "no build provenance to check (%s is private, so GitHub doesn't attest it)" % RELEASE_REPO
    raise UpdateRefused("release v%s has no valid build provenance (gh attestation verify: %s); "
                        "not updating anything" % (v, why))


def release_digests(version: str, names: List[str]) -> Tuple[Optional[Dict[str, str]], str]:
    """sha256 of each named /dl file as the GitHub release vX.Y.Z of RELEASE_REPO has it,
    from its server tarball (itself checked against the release's SHA256SUMS, its
    release-manifest.json and that manifest's build provenance). Returns (digests, what the
    provenance check found) or (None, why the cross-check couldn't run)."""
    import subprocess
    import tarfile
    import tempfile
    gh = _gh()
    if not gh:
        return None, "gh isn't installed"
    if _vtuple(version) is None:
        raise UpdateRefused("the hub's version %s isn't X.Y.Z" % clean(version))
    v = "%d.%d.%d" % _vtuple(version)  # type: ignore[str-format]
    tarball = "needs-you-server-%s.tar.gz" % v
    with tempfile.TemporaryDirectory(prefix="needs-you-release-") as tmp:
        try:
            r = subprocess.run([gh, "release", "download", "v" + v, "--repo", RELEASE_REPO,
                                "--pattern", "SHA256SUMS", "--pattern", tarball, "--dir", tmp],
                               stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=120)
        except (OSError, subprocess.SubprocessError) as e:
            raise UpdateRefused("gh failed (%s)" % type(e).__name__)
        if r.returncode != 0:
            raise UpdateRefused("gh couldn't download release v%s (%s)" % (v, clean((r.stderr.strip().splitlines() or [""])[-1])))
        sums: Dict[str, str] = {}
        try:
            with open(os.path.join(tmp, "SHA256SUMS"), "r", encoding="utf-8") as fh:
                for line in fh:
                    p = line.split()
                    if len(p) == 2:
                        sums[p[1].lstrip("*")] = p[0].lower()
            tar_path = os.path.join(tmp, tarball)
            if _sha256_file(tar_path) != sums.get(tarball):
                raise UpdateRefused("the release's %s doesn't match its SHA256SUMS" % tarball)
            note = release_provenance(gh, v, tarball, sums.get(tarball, ""), tmp)
            out: Dict[str, str] = {}
            with tarfile.open(tar_path, "r:gz") as tf:
                for name in names:
                    rel = RELEASE_PATHS.get(name)
                    if not rel:
                        continue
                    try:
                        member = tf.extractfile("needs-you-%s/%s" % (v, rel))
                    except KeyError:
                        member = None
                    if member is not None:
                        out[name] = hashlib.sha256(member.read()).hexdigest()
            return out, note
        except (OSError, ValueError, tarfile.TarError) as e:
            raise UpdateRefused("couldn't read release v%s (%s)" % (v, type(e).__name__))


def cross_check(cfg: Config, manifest: Dict[str, Any], changes: List[Dict[str, Any]], auto: bool = False) -> str:
    """Every file about to be installed must match the GitHub release of the hub's version.
    Raises UpdateRefused on a mismatch; returns a note when the check couldn't run (and
    raises instead with NEEDS_YOU_UPDATE_REQUIRE_RELEASE_MATCH=1)."""
    names = sorted({c["file"] for c in changes} | ({"install-hooks.sh", "needs-you-hook.sh"}
                                                  if any(c["file"] == "hooks.json" for c in changes) else set())
                   | ({"install-codex-hooks.sh", "needs-you-hook.sh"}
                      if any(c["file"] == "codex-hooks.json" for c in changes) else set()))
    try:
        digests, why = release_digests(str(manifest.get("version") or ""), names)
    except UpdateRefused:
        raise
    except Exception as e:  # noqa: BLE001 - any failure of the check refuses (never fail open)
        raise UpdateRefused("the GitHub release check failed (%s)" % type(e).__name__)
    if digests is None:
        # Only "gh isn't installed" gets here. Automatic updates need the match unless it
        # is explicitly turned off; a manual update goes ahead with a warning.
        req = _setting(cfg, "NEEDS_YOU_UPDATE_REQUIRE_RELEASE_MATCH").strip().lower()
        if req in _ON or (auto and req not in _OFF):
            raise UpdateRefused("can't check against the GitHub release (%s), and %s" % (
                why, "NEEDS_YOU_UPDATE_REQUIRE_RELEASE_MATCH is on" if req in _ON else
                "automatic updates need it (install and log in to gh, or set NEEDS_YOU_UPDATE_REQUIRE_RELEASE_MATCH=0)"))
        return "WARNING: not checked against the GitHub release (%s); only the hub's checksums were checked" % why
    files = manifest.get("files") or {}
    for name in names:
        want = str((files.get(name) or {}).get("sha256") or "").lower()
        if digests.get(name) != want:
            raise UpdateRefused("%s from the hub doesn't match release v%s on GitHub; not updating anything"
                                % (name, clean(manifest.get("version"))))
    return "matches release v%s on GitHub (%s)" % (clean(manifest.get("version")), why)


# -- apply, back up, roll back --------------------------------------------------------

def backup_dir() -> str:
    return os.path.join(state_dir(), "backup")


def _backup(name: str, path: str) -> None:
    """Keep the file being replaced, for `update --rollback` (one generation)."""
    try:
        with open(path, "rb") as fh:
            data = fh.read()
        mode = os.stat(path).st_mode & 0o777
    except OSError:
        return
    os.makedirs(backup_dir(), mode=0o700, exist_ok=True)
    _write_atomic(os.path.join(backup_dir(), name), data, 0o600)
    backups = _read_state().get("backups") or {}
    backups[name] = {"path": path, "mode": mode, "version": _stamp(path) if name != "needs-you" else VERSION}
    _write_state(backups=backups)


def _download_verified(hub: UpdateTarget, name: str, manifest: Dict[str, Any], timeout: float) -> bytes:
    entry = (manifest.get("files") or {}).get(name) or {}
    data = pinned_get(hub, "/dl/" + name, timeout)
    if hashlib.sha256(data).hexdigest() != str(entry.get("sha256") or "").lower():
        raise ValueError("%s doesn't match the hub's checksum" % name)
    if isinstance(entry.get("size"), int) and entry["size"] != len(data):
        raise ValueError("%s isn't the size the hub's manifest says" % name)
    return data


def _apply(hub: UpdateTarget, manifest: Dict[str, Any], change: Dict[str, Any], timeout: float) -> str:
    name = change["file"]
    if name == "hooks.json":
        import subprocess
        import tempfile
        with tempfile.TemporaryDirectory(prefix="needs-you-update-") as tmp:
            for f in ("install-hooks.sh", "needs-you-hook.sh", "hooks.json"):
                with open(os.path.join(tmp, f), "wb") as fh:
                    fh.write(_download_verified(hub, f, manifest, timeout))
            hook = _home(".claude", "hooks", "needs-you-hook.sh")
            if os.path.isfile(hook) and "needs-you-hook.sh" not in (_read_state().get("backups") or {}):
                _backup("needs-you-hook.sh", hook)
            r = subprocess.run(["bash", os.path.join(tmp, "install-hooks.sh"), "--user"], stdin=subprocess.DEVNULL,
                               capture_output=True, text=True, timeout=60,
                               env=dict(os.environ, NEEDS_YOU_INSTALLER="1"))
            if r.returncode != 0:
                raise ValueError("install-hooks.sh failed: %s" % clean((r.stderr or r.stdout).strip()[-200:]))
        _write_state(hooks_json_sha256=change["sha256"])
        return "re-merged the hook entries in ~/.claude/settings.json (it keeps a .bak)"
    if name == "codex-hooks.json":
        import subprocess
        import tempfile
        with tempfile.TemporaryDirectory(prefix="needs-you-update-") as tmp:
            for f in ("install-codex-hooks.sh", "needs-you-hook.sh", "codex-hooks.json"):
                with open(os.path.join(tmp, f), "wb") as fh:
                    fh.write(_download_verified(hub, f, manifest, timeout))
            hook = os.path.join(codex_home(), "hooks", "needs-you-hook.sh")
            if os.path.isfile(hook) and "codex-needs-you-hook.sh" not in (_read_state().get("backups") or {}):
                _backup("codex-needs-you-hook.sh", hook)
            r = subprocess.run(["bash", os.path.join(tmp, "install-codex-hooks.sh"), "--codex-home", codex_home()],
                               stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=60,
                               env=dict(os.environ, NEEDS_YOU_INSTALLER="1"))
            if r.returncode != 0:
                raise ValueError("install-codex-hooks.sh failed: %s" % clean((r.stderr or r.stdout).strip()[-200:]))
        _write_state(codex_hooks_json_sha256=change["sha256"])
        return "re-merged the hook entries in %s (it keeps a .bak)" % _tilde(change["path"])
    data = _download_verified(hub, name, manifest, timeout)
    path = change["path"]
    if name == "needs-you":
        if not _valid_cli(data):
            raise ValueError("the hub's needs-you isn't a working CLI")
        mode = 0o755
    else:
        try:
            mode = os.stat(path).st_mode & 0o777
        except OSError:
            mode = 0o644
    _backup(change.get("backup") or name, path)
    _write_atomic(path, data, mode)
    return "updated %s: %s -> %s" % (_tilde(path), change["from"] or "?", change["to"])


def rollback(quiet: bool, as_json: bool) -> int:
    """`needs-you update --rollback`: put back the files the last update replaced."""
    backups = _read_state().get("backups") or {}
    restored, errors = [], []
    for name, info in sorted(backups.items(), key=lambda kv: kv[0] == "needs-you"):
        src = os.path.join(backup_dir(), name)
        try:
            with open(src, "rb") as fh:
                data = fh.read()
            _write_atomic(info["path"], data, int(info.get("mode") or 0o644))
            restored.append(name)
            if not quiet and not as_json:
                print("restored %s (%s)" % (_tilde(info["path"]), info.get("version") or "?"))
        except (OSError, KeyError, ValueError) as e:
            errors.append("%s: %s" % (name, e))
    if restored:
        _write_state(backups={k: v for k, v in backups.items() if k not in restored},
                     auto_ok_at=int(time.time()))  # and don't auto-update straight back
    if as_json:
        print(json.dumps({"ok": not errors, "restored": restored, "errors": errors}, sort_keys=True))
    elif not restored and not quiet:
        print("needs-you update --rollback: nothing to roll back")
    for e in errors:
        warn("couldn't restore %s" % e)
    return 1 if errors else 0


def update(cfg: Config, check: bool = False, auto: bool = False, quiet: bool = False, as_json: bool = False,
           allow_downgrade: bool = False, from_flush: bool = False) -> int:
    """`needs-you update`. Exit 0 when up to date or updated (always with --auto); 1 when the
    update hub couldn't serve one, it was refused, or a file couldn't be replaced."""
    result: Dict[str, Any] = {"ok": False, "cli": VERSION, "hub": None, "hub_version": None,
                              "changes": [], "applied": [], "notes": [], "errors": []}
    say = (lambda msg: None) if quiet or as_json else print  # noqa: E731

    def finish(code: int) -> int:
        result["ok"] = code == 0
        if as_json:
            print(json.dumps(result, sort_keys=True))
        return 0 if auto else code

    errors: List[str] = []
    got = fetch_manifest(cfg, errors)
    if got is None:
        result["errors"] = errors
        if not quiet:
            warn("no update: %s" % "; ".join(errors))
        return finish(1)
    hub, manifest = got
    result["hub"], result["hub_version"] = hub.url, manifest.get("version")
    try:
        changes, notes = plan_update(manifest, allow_downgrade=allow_downgrade)
    except UpdateRefused as e:
        result["errors"].append(str(e))
        if not quiet:
            warn("update refused: %s" % e)
        return finish(1)
    result["notes"] = notes
    result["changes"] = [{k: c[k] for k in ("file", "from", "to")} for c in changes]
    for n in notes:
        say("needs-you update: %s" % n)
    if not changes:
        say("needs-you %s is already up to date (%s)" % (VERSION, hub.url))
        return finish(0)
    say("from %s (hub %s, %s):" % (hub.url, clean(manifest.get("version")), hub.why))
    for c in changes:
        say("  %s %s (%s -> %s)" % ("would update" if check else "update", c.get("label") or c["file"], c["from"] or "?", c["to"]))
    try:
        note = cross_check(cfg, manifest, changes, auto=auto or from_flush)
        result["notes"].append(note)
        if note.startswith("WARNING") and not quiet and not as_json:
            warn(note)
        else:
            say("  " + note)
    except UpdateRefused as e:
        result["errors"].append(str(e))
        if not quiet:
            warn("update refused: %s" % e)
        return finish(1)
    if check:
        return finish(0)
    failed = False
    timeout = max(cfg.timeout, 10)
    # The CLI last: if replacing it fails, the rest is already current.
    for c in sorted(changes, key=lambda c: c["file"] == "needs-you"):
        try:
            msg = _apply(hub, manifest, c, timeout)
            result["applied"].append(c["file"])
            say(msg + " (from %s)" % hub.url)
        except Exception as e:  # noqa: BLE001 - never a traceback for the caller
            failed = True
            result["errors"].append("%s: %s" % (c["file"], clean(getattr(e, "reason", e))))
            if not quiet:
                warn("couldn't update %s" % result["errors"][-1])
    _write_state(last_update_at=int(time.time()), last_update_hub=hub.url)
    if result["applied"]:
        say("needs-you update --rollback puts the previous files back")
    return finish(1 if failed else 0)


def auto_update(cfg: Config) -> None:
    """From `flush`, only with NEEDS_YOU_AUTO_UPDATE=1 (off by default): `update --auto` at
    most once a day (plus a per-host offset so a fleet doesn't hit the hub at once), retried
    hourly after a failure. Never raises, never prints."""
    try:
        if _setting(cfg, "NEEDS_YOU_AUTO_UPDATE").strip().lower() not in _ON or not cfg.ok:
            return
        st = _read_state()
        now = time.time()
        offset = int(hashlib.sha256(cfg.host.encode("utf-8")).hexdigest()[:4], 16) % 3600
        if now - float(st.get("auto_ok_at") or 0) < AUTO_UPDATE_EVERY + offset:
            return
        if now - float(st.get("auto_tried_at") or 0) < AUTO_UPDATE_RETRY:
            return
        _write_state(auto_tried_at=int(now))
        if update(cfg, quiet=True, from_flush=True) == 0:
            _write_state(auto_ok_at=int(now))
    except Exception:  # noqa: BLE001 - flush must never fail because of this
        pass


REQUESTED_UPDATE_RUN_EVERY = 6 * 3600     # a requested auto-update starts at most this often
REQUESTED_UPDATE_NOTE_EVERY = 24 * 3600   # the stderr line otherwise


def spawn_update() -> None:
    """Start this CLI's own `update --auto` detached: its own session, no terminal, output
    discarded, and never waited for. The command is fixed here; nothing in it comes from a hub."""
    import subprocess
    exe = [sys.executable] if sys.executable else []
    with open(os.devnull, "r+b") as devnull:
        subprocess.Popen(exe + [cli_path(), "update", "--auto"], stdin=devnull, stdout=devnull,
                         stderr=devnull, close_fds=True, start_new_session=True, cwd="/")


def _stderr_discarded() -> bool:
    try:
        a, b = os.fstat(2), os.stat(os.devnull)
    except OSError:
        return True
    return (a.st_dev, a.st_ino) == (b.st_dev, b.st_ino)


def on_update_requested(hub_url: str, quiet: bool) -> None:
    """A hub's response said the owner asked this machine to update. The flag is the only
    thing taken from the hub: with NEEDS_YOU_AUTO_UPDATE=1 this starts the same verified
    `needs-you update --auto` in the background (at most every 6 h); otherwise it prints one
    line to stderr at most once a day. Never raises, never changes the exit code."""
    try:
        cfg = Config()
        st = _read_state()
        now = time.time()
        if _setting(cfg, "NEEDS_YOU_AUTO_UPDATE").strip().lower() in _ON:
            if now - float(st.get("requested_update_run_at") or 0) < REQUESTED_UPDATE_RUN_EVERY:
                return
            _write_state(requested_update_run_at=int(now))
            spawn_update()
            return
        # Hooks and scripts that send stderr to /dev/null don't use up the day's reminder.
        if quiet or _stderr_discarded() or \
                now - float(st.get("requested_update_noted_at") or 0) < REQUESTED_UPDATE_NOTE_EVERY:
            return
        _write_state(requested_update_noted_at=int(now))
        import urllib.parse
        host = urllib.parse.urlsplit(hub_url).hostname or hub_url
        warn("%s asked this machine to update: run `needs-you update`" % clean(host))
    except Exception:  # noqa: BLE001 - never fail the caller's command over this
        pass


def health(cfg: Config, queued: int) -> int:
    if not cfg.urls:
        warn("NEEDS_YOU_URLS is not set (%s)" % config_path())
        return 1
    healthy = 0
    for url in cfg.urls:
        try:
            status, body = _call(url, cfg.token, "GET", "/v1/health", None, cfg.timeout)
        except (OSError, ValueError) as e:
            print("%s  DOWN  %s" % (url, getattr(e, "reason", e)))
            continue
        if status == 200 and body.get("token_error"):
            print("%s  UP    hub=%s but the token was rejected: %s" % (url, clean(body.get("hub_id")),
                                                                    clean(body["token_error"])))
        elif status == 200:
            tok = body.get("token") or {}
            print("%s  OK    hub=%s token=%s role=%s" % (url, clean(body.get("hub_id")), clean(tok.get("name", "-")),
                                                        clean(tok.get("role", "-"))))
            healthy += 1
        else:
            print("%s  HTTP %d  %s" % (url, status, clean(body.get("message") or body.get("error") or "")))
    print("outbox: %d queued" % queued)
    return 0 if healthy else 1


# ---------------------------------------------------------------------------
# doctor: read-only self-diagnosis. Never writes a file, never posts, never
# prints a token (only "set" and its length).
# ---------------------------------------------------------------------------

FLUSH_LABEL = "io.needs-you.flush"
CRON_TAG = "# needs-you-flush"
HOOK_MARKER = "orca terminal switch"  # present in every hook since agent cards name the Orca terminal
_ON = ("1", "true", "yes", "on")
_OFF = ("0", "false", "no", "off")


def _tilde(path: str) -> str:
    home = os.path.expanduser("~")
    if path == home or path.startswith(home + os.sep):
        return "~" + path[len(home):]
    return path


def _age(seconds: float) -> str:
    s = max(0, int(seconds))
    if s < 120:
        return "%ds" % s
    if s < 7200:
        return "%dm" % (s // 60)
    if s < 172800:
        return "%dh" % (s // 3600)
    return "%dd" % (s // 86400)


def _entry_time(d: str, name: str) -> Optional[float]:
    try:
        return int(name.split("-", 1)[0]) / 1e9
    except ValueError:
        try:
            return os.path.getmtime(os.path.join(d, name))
        except OSError:
            return None


def _list_json(d: str) -> List[str]:
    """Like pending(), but read-only: never creates the directory or prunes."""
    try:
        return sorted(n for n in os.listdir(d) if n.endswith(".json") and not n.startswith("."))
    except OSError:
        return []


def crontab_has_flush(text: str) -> bool:
    return any(CRON_TAG in line and not line.lstrip().startswith("#") for line in text.splitlines())


def _is_loopback(url: str) -> bool:
    import urllib.parse
    host = (urllib.parse.urlsplit(url).hostname or "").lower()
    return host in ("127.0.0.1", "localhost", "::1")


class Doctor:
    def __init__(self, cfg: Config) -> None:
        self.cfg = cfg
        self.checks: List[Dict[str, str]] = []
        self.home = os.path.expanduser("~")
        self.env_path = config_path()
        self.file = read_env_file(self.env_path)

    def add(self, check: str, status: str, detail: str, hint: str = "") -> None:
        self.checks.append({"check": check, "status": status, "detail": detail, "hint": hint})

    def setting(self, name: str) -> Tuple[str, str]:
        """(value, where): the environment wins over the env file, like the CLI and the hooks."""
        if os.environ.get(name):
            return os.environ[name], "env"
        if self.file.get(name):
            return self.file[name], "env file"
        return "", ""

    def run(self) -> List[Dict[str, str]]:
        for step in (self.config, self.path, self.hubs, self.outbox, self.hooks, self.codex_hooks, self.skill,
                     self.orca, self.schedule, self.update):
            try:
                step()
            except Exception as e:  # a broken check must not hide the others
                self.add(step.__name__, "WARN", "check crashed: %s" % type(e).__name__,
                         "report this as a needs-you bug")
        return self.checks

    # -- config ------------------------------------------------------------
    def config(self) -> None:
        p = self.env_path
        shown = _tilde(p)
        status, hint, parts = "OK", "", []
        try:
            st = os.stat(p)
        except OSError:
            st = None
        if st is None:
            parts.append("%s not found" % shown)
            if not self.cfg.ok:
                status, hint = "FAIL", "set this machine up with an invite link from the Mac app (or scripts/setup-sender.sh)"
            else:
                status = "WARN"
                hint = "the settings come from the environment only; cron, LaunchAgents and hooks won't see them"
        else:
            mode = st.st_mode & 0o777
            parts.append("%s (mode %o)" % (shown, mode))
            if mode & 0o077:
                status, hint = "WARN", "chmod 600 %s" % shown
        hooks_file = os.environ.get("NEEDS_YOU_ENV_FILE")
        if hooks_file and os.path.abspath(os.path.expanduser(hooks_file)) != os.path.abspath(p):
            parts.append("hooks read NEEDS_YOU_ENV_FILE=%s instead" % _tilde(hooks_file))
            if status == "OK":
                status, hint = "WARN", "point NEEDS_YOU_ENV_FILE and the CLI at the same file, or unset it"
        urls, where = self.setting("NEEDS_YOU_URLS")
        if not urls:
            urls, where = self.setting("NEEDS_YOU_URL")
            name = "NEEDS_YOU_URL"
        else:
            name = "NEEDS_YOU_URLS"
        if self.cfg.urls:
            parts.append("%s: %d hub URL%s (%s)" % (name, len(self.cfg.urls),
                                                    "" if len(self.cfg.urls) == 1 else "s", where))
        else:
            parts.append("NEEDS_YOU_URLS not set")
            status = "FAIL"
            hint = hint if st is None else "add NEEDS_YOU_URLS=<hub url>[,<hub url>...] to %s" % shown
        tok, where = self.setting("NEEDS_YOU_TOKEN")
        if tok:
            parts.append("NEEDS_YOU_TOKEN set (%d chars, %s)" % (len(tok), where))
        else:
            parts.append("NEEDS_YOU_TOKEN not set")
            status = "FAIL"
            if st is not None:
                hint = "re-run the invite installer with --force to get a token for this machine"
        self.add("config", status, "; ".join(parts), hint)

    # -- PATH --------------------------------------------------------------
    def path(self) -> None:
        import shutil
        local_bin = os.path.join(self.home, ".local", "bin")
        entries = [os.path.realpath(os.path.expanduser(e)) for e in os.environ.get("PATH", "").split(os.pathsep) if e]
        on_path = os.path.realpath(local_bin) in entries
        found = shutil.which("needs-you")
        installed = os.path.join(local_bin, "needs-you")
        hint_line = 'add export PATH="$HOME/.local/bin:$PATH" to your shell profile'
        if found:
            detail = "needs-you -> %s" % _tilde(found)
            me = os.path.realpath(sys.argv[0]) if sys.argv and sys.argv[0] else ""
            if me and os.path.realpath(found) != me:
                detail += " (this run: %s)" % _tilde(me)
            detail += "; ~/.local/bin %s PATH" % ("on" if on_path else "not on")
            self.add("path", "OK", detail)
        elif os.path.exists(installed):
            self.add("path", "WARN", "needs-you is not on PATH; ~/.local/bin/needs-you exists",
                     hint_line + "; until then call ~/.local/bin/needs-you by its full path")
        else:
            self.add("path", "WARN", "needs-you is not on PATH%s" % ("" if on_path else "; ~/.local/bin not on PATH"),
                     "install the CLI to ~/.local/bin (the invite installer does) and " + hint_line)

    # -- hubs --------------------------------------------------------------
    def hubs(self) -> None:
        urls = self.cfg.urls
        if not urls:
            self.add("hubs", "FAIL", "no hub URL configured", "set NEEDS_YOU_URLS in %s" % _tilde(self.env_path))
            return
        timeout = min(self.cfg.timeout, 3.0)
        answered: List[int] = []
        usable: List[int] = []
        for i, url in enumerate(urls):
            name = "hub %d" % (i + 1)
            try:
                status, body = _call(url, self.cfg.token, "GET", "/v1/health", None, timeout)
            except (OSError, ValueError) as e:
                self.add(name, "WARN", "%s unreachable (%s)" % (url, getattr(e, "reason", e)),
                         "is the hub up, and this machine on the tailnet? see docs/guides/troubleshooting.md")
                continue
            if status != 200:
                hint = ("the hub doesn't answer to this host name: use its public URL or tailnet IP, or add "
                        "the name to the hub's allowed_hosts" if status == 421 else "is that a needs-you hub URL?")
                self.add(name, "WARN", "%s answered HTTP %d" % (url, status), hint)
                continue
            answered.append(i)
            hub_v = clean(body.get("version") or "?")
            base = "%s hub=%s version %s" % (url, clean(body.get("hub_id", "?")), hub_v)
            vhint = ""
            if hub_v not in ("?", VERSION):
                vhint = "CLI is %s; needs-you update fetches the hub's copy" % VERSION
            tok = body.get("token")
            if body.get("token_error") or not isinstance(tok, dict):
                why = (clean(body["token_error"]) if body.get("token_error")
                       else "no token sent" if not self.cfg.token else "token not recognised")
                self.add(name, "FAIL", "%s; token rejected: %s" % (base, why),
                         "get a new invite link and re-run its installer with --force")
                continue
            role = clean(tok.get("role", "?"))
            detail = "%s token=%s role=%s" % (base, clean(tok.get("name", "?")), role)
            if role not in ("sender", "owner"):
                self.add(name, "WARN", detail + " (this role can't post)", "use a sender token on this machine")
                continue
            usable.append(i)
            self.add(name, "OK", detail, vhint)
        n = len(urls)
        summary = "%d configured, %d answered, %d accept the token" % (n, len(answered), len(usable))
        if not usable:
            self.add("hubs", "FAIL", summary,
                     "items will queue in the outbox until a hub accepts the token; see docs/guides/troubleshooting.md")
        elif 0 not in usable:
            self.add("hubs", "WARN", summary + "; only a fallback hub works (%s)" % urls[usable[0]],
                     "check the first hub %s; every post waits for it to time out first" % urls[0])
        else:
            self.add("hubs", "OK", summary)
        if sys.platform == "darwin":
            loop = [i for i, u in enumerate(urls) if _is_loopback(u)]
            if loop and loop[0] != 0:
                self.add("hub order", "WARN", "%s is #%d in NEEDS_YOU_URLS" % (urls[loop[0]], loop[0] + 1),
                         "on the Mac that runs the hub, list %s first so local agents don't depend on Tailscale"
                         % urls[loop[0]])

    # -- outbox ------------------------------------------------------------
    def outbox(self) -> None:
        d = outbox_dir()
        now = time.time()
        queued = _list_json(d)
        failed = _list_json(os.path.join(d, "failed"))
        parts = ["%d queued" % len(queued)]
        if queued:
            t = _entry_time(d, queued[0])
            if t is not None:
                parts[0] += ", oldest %s" % _age(now - t)
        parts.append("%d failed" % len(failed))
        status, hints = "OK", []
        if queued:
            status = "WARN"
            hints.append("needs-you flush (sends them once a hub answers)")
        if failed:
            status = "WARN"
            hints.append("a hub rejected the entries in %s; read them, then delete them"
                         % _tilde(os.path.join(d, "failed")))
        self.add("outbox", status, "%s (%s)" % (", ".join(parts), _tilde(d)), "; ".join(hints))

    # -- Claude Code hooks -------------------------------------------------
    def hooks(self) -> None:
        claude = os.path.join(self.home, ".claude")
        hook = os.path.join(claude, "hooks", "needs-you-hook.sh")
        settings = os.path.join(claude, "settings.json")
        installer = "integrations/claude-code/install-hooks.sh (or the invite installer with --claude-hooks user)"
        if not os.path.isdir(claude):
            self.add("claude hooks", "INFO", "~/.claude not found; Claude Code isn't set up for this user")
            return
        try:
            with open(settings, "r", encoding="utf-8") as fh:
                referenced = "needs-you-hook.sh" in fh.read()
        except OSError:
            referenced = False
        exists = os.path.isfile(hook)
        if not exists and not referenced:
            self.add("claude hooks", "INFO", "not installed (optional: cards when a session waits on you)",
                     "run " + installer)
            return
        problems, parts = [], []
        if not exists:
            problems.append("~/.claude/settings.json references the hook but %s is missing" % _tilde(hook))
        else:
            parts.append(_tilde(hook))
            if not os.access(hook, os.X_OK):
                problems.append("%s is not executable" % _tilde(hook))
            if not referenced:
                problems.append("~/.claude/settings.json doesn't reference it")
            try:
                with open(hook, "r", encoding="utf-8", errors="replace") as fh:
                    current = HOOK_MARKER in fh.read()
            except OSError:
                current = False
            if not current:
                problems.append("old hook")
        alerts, where = self.setting("NEEDS_YOU_AGENT_ALERTS")
        if alerts.lower() in _OFF:
            parts.append("alerts off (NEEDS_YOU_AGENT_ALERTS=%s in %s)" % (alerts, where))
        elif alerts.lower() in _ON:
            parts.append("alerts on (NEEDS_YOU_AGENT_ALERTS=%s in %s)" % (alerts, where))
        elif os.environ.get("ORCA_TERMINAL_HANDLE"):
            parts.append("alerts on (Orca session)")
        else:
            parts.append("alerts off until opted in")
        pct, where = self.setting("NEEDS_YOU_CONTEXT_ALERT_PCT")
        if pct in ("0", "off", "no", "false"):
            parts.append("context alert off")
        else:
            parts.append("context alert at %s%%%s" % (pct or "80", " (%s)" % where if pct else ""))
        alias, where = self.setting("NEEDS_YOU_SSH_ALIAS")
        if alias:
            parts.append("ssh alias %s (%s)" % (alias, where))
        link, where = self.setting("NEEDS_YOU_AGENT_LINK")
        if link:
            parts.append("agent link %s (%s)" % ("off" if link.strip().lower() == "none" else "template", where))
        if problems:
            hint = "re-run the installer: " + installer
            self.add("claude hooks", "WARN", "; ".join(problems + parts), hint)
        else:
            hint = ""
            if "alerts off until opted in" in parts:
                hint = "to get cards from every session here: echo 'NEEDS_YOU_AGENT_ALERTS=1' >> %s" % _tilde(self.env_path)
            self.add("claude hooks", "OK", "installed in ~/.claude/settings.json; " + "; ".join(parts), hint)

    # -- Codex CLI hooks ---------------------------------------------------
    def codex_hooks(self) -> None:
        import re
        import shutil
        home = os.environ.get("CODEX_HOME") or os.path.join(self.home, ".codex")
        hook = os.path.join(home, "hooks", "needs-you-hook.sh")
        hooks_json = os.path.join(home, "hooks.json")
        installer = ("integrations/codex/install-codex-hooks.sh (or the invite installer with "
                     "--codex-hooks user)")
        if not os.path.isdir(home):
            if shutil.which("codex"):
                self.add("codex hooks", "INFO", "%s not found; Codex hasn't run for this user yet" % _tilde(home),
                         "after a first Codex run: " + installer)
            return
        doc: Any = None
        try:
            with open(hooks_json, "r", encoding="utf-8") as fh:
                text = fh.read()
            referenced = "needs-you-hook.sh" in text
            try:
                doc = json.loads(text) if text.strip() else {}
            except ValueError:
                doc = None
        except OSError:
            text, referenced, doc = "", False, {}
        exists = os.path.isfile(hook)
        if not exists and not referenced:
            self.add("codex hooks", "INFO", "not installed (optional: cards when a Codex session waits on you)",
                     "run " + installer)
            return
        problems, parts, hints = [], [_tilde(hooks_json)], []
        if doc is None:
            problems.append("%s isn't valid JSON, so Codex loads none of its hooks" % _tilde(hooks_json))
        if not exists:
            problems.append("%s references the hook but %s is missing" % (_tilde(hooks_json), _tilde(hook)))
        else:
            if not os.access(hook, os.X_OK):
                problems.append("%s is not executable" % _tilde(hook))
            if not referenced:
                problems.append("%s doesn't reference it" % _tilde(hooks_json))
            try:
                with open(hook, "r", encoding="utf-8", errors="replace") as fh:
                    if "codex" not in fh.read():
                        problems.append("old hook (no Codex support)")
            except OSError:
                pass
        # [features] hooks = false turns every hook off.
        config_text = ""
        try:
            with open(os.path.join(home, "config.toml"), "r", encoding="utf-8") as fh:
                config_text = fh.read()
        except OSError:
            pass
        section = ""
        for line in config_text.splitlines():
            s = line.strip()
            if s.startswith("["):
                section = s
            elif section == "[features]" and re.match(r"^hooks\s*=\s*false\b", s):
                problems.append("hooks = false under [features] in %s" % _tilde(os.path.join(home, "config.toml")))
        # Codex runs a hook only once it's trusted (/hooks); it records that in config.toml as
        # [hooks.state."<hooks.json>:<event>:<group>:<handler>"]. Only claim "untrusted" when that
        # table exists for this file but not for our PermissionRequest entry.
        if isinstance(doc, dict) and isinstance(doc.get("hooks"), dict):
            groups = doc["hooks"].get("PermissionRequest")
            pos = None
            if isinstance(groups, list):
                for gi, g in enumerate(groups):
                    hs = g.get("hooks") if isinstance(g, dict) else None
                    for hi, h in enumerate(hs if isinstance(hs, list) else []):
                        if isinstance(h, dict) and "needs-you-hook.sh" in str(h.get("command", "")):
                            pos = (gi, hi)
            state_prefix = '[hooks.state."%s:' % hooks_json
            if pos is not None and state_prefix in config_text:
                if '%spermission_request:%d:%d"]' % (state_prefix, pos[0], pos[1]) not in config_text:
                    problems.append("Codex hasn't trusted them yet")
                    hints.append("start Codex, open /hooks and trust the needs-you entries")
        alerts, where = self.setting("NEEDS_YOU_AGENT_ALERTS")
        if alerts.lower() in _OFF:
            parts.append("alerts off (NEEDS_YOU_AGENT_ALERTS=%s in %s)" % (alerts, where))
        elif alerts.lower() in _ON:
            parts.append("alerts on (NEEDS_YOU_AGENT_ALERTS=%s in %s)" % (alerts, where))
        else:
            parts.append("alerts off until opted in")
        if problems:
            if not hints:
                hints.append("re-run the installer: " + installer)
            self.add("codex hooks", "WARN", "; ".join(problems + parts), "; ".join(hints))
            return
        hint = "Codex runs a new hook only after you trust it: open /hooks in Codex once"
        if "alerts off until opted in" in parts:
            hint += "; for cards from every session here: echo 'NEEDS_YOU_AGENT_ALERTS=1' >> %s" % _tilde(self.env_path)
        self.add("codex hooks", "OK", "installed in " + "; ".join(parts), hint)

    # -- skill -------------------------------------------------------------
    def skill(self) -> None:
        p = os.path.join(self.home, ".claude", "skills", "needs-you", "SKILL.md")
        if os.path.isfile(p):
            self.add("claude skill", "OK", _tilde(p))
        else:
            self.add("claude skill", "INFO", "%s not installed (optional)" % _tilde(p),
                     "copy integrations/claude-code/skill/needs-you to ~/.claude/skills/ (or the invite installer's --skill)")

    # -- Orca --------------------------------------------------------------
    def orca(self) -> None:
        import shutil
        handle = os.environ.get("ORCA_TERMINAL_HANDLE")
        if not handle and not shutil.which("orca"):
            return
        parts = ["ORCA_TERMINAL_HANDLE %s" % ("set" if handle else "not set (not an Orca terminal)"),
                 "ORCA_WORKTREE_ID %s" % ("set" if os.environ.get("ORCA_WORKTREE_ID") else "not set")]
        env_name, where = self.setting("NEEDS_YOU_ORCA_ENVIRONMENT")
        hint = ""
        if env_name:
            parts.append("NEEDS_YOU_ORCA_ENVIRONMENT=%s (%s)" % (env_name, where))
        else:
            parts.append("NEEDS_YOU_ORCA_ENVIRONMENT not set")
            hint = ("on a paired Orca server, set NEEDS_YOU_ORCA_ENVIRONMENT in %s to the name "
                    "`orca environment list` shows on the Mac" % _tilde(self.env_path))
