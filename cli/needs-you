    # -- Kimi Code CLI hooks -----------------------------------------------
    def kimi_hooks(self) -> None:
        import shutil
        home = os.environ.get("KIMI_CODE_HOME") or os.path.join(self.home, ".kimi-code")
        conf = os.path.join(home, "config.toml")
        hook = os.path.join(home, "hooks", "needs-you-hook.sh")
        installer = _rerun("--kimi-hooks user")
        if not os.path.isdir(home) and not shutil.which("kimi"):
            return
        try:
            with open(conf, "r", encoding="utf-8", errors="replace") as fh:
                lines = fh.read().splitlines()
        except OSError:
            lines = []
        starts = [i for i, l in enumerate(lines) if l.startswith(KIMI_BLOCK_START)]
        ends = [i for i, l in enumerate(lines) if l.rstrip() == KIMI_BLOCK_END]
        if not starts and not os.path.isfile(hook):
            self.add("kimi hooks", "INFO", "not installed (optional: cards when a Kimi Code session waits on you)",
                     "to install: " + _installer("--kimi-hooks user --alerts"))
            return
        problems, parts = [], [_tilde(conf)]
        if not starts:
            problems.append("%s has no needs-you block" % _tilde(conf))
        elif len(starts) > 1 or not ends or ends[-1] < starts[-1]:
            problems.append("the needs-you block in %s is cut short or repeated, so Kimi may refuse the file"
                            % _tilde(conf))
        if not os.path.isfile(hook):
            problems.append("%s is missing" % _tilde(hook))
        else:
            if not os.access(hook, os.X_OK):
                problems.append("%s is not executable" % _tilde(hook))
            try:
                with open(hook, "r", encoding="utf-8", errors="replace") as fh:
                    if "kimi_card" not in fh.read():
                        problems.append("old hook (no Kimi support)")
            except OSError:
                pass
        parts.append(self._alerts_part())
        if problems:
            self.add("kimi hooks", "WARN", "; ".join(problems + parts), installer)
            return
        hint = "restart Kimi Code after installing or updating them"
        if parts[-1] == "alerts off until opted in":
            hint += "; for cards from every session here: echo 'NEEDS_YOU_AGENT_ALERTS=1' >> %s" % _sh(self.env_path)
        self.add("kimi hooks", "OK", "installed in " + "; ".join(parts), hint)

    # -- Grok Build hooks --------------------------------------------------
    def grok_hooks(self) -> None:
        import shutil
        home = os.environ.get("GROK_HOME") or os.path.join(self.home, ".grok")
        conf = os.path.join(home, "hooks", "needs-you.json")
        hook = os.path.join(home, "hooks", "needs-you-hook.sh")
        installer = _rerun("--grok-hooks user")
        if not os.path.isdir(home) and not shutil.which("grok"):
            return
        if not os.path.isfile(conf) and not os.path.isfile(hook):
            # Grok runs the Claude Code hooks too (on by default): those post as Grok.
            if _references_hook(os.path.join(self.home, ".claude", "settings.json")):
                self.add("grok hooks", "INFO", "not installed; Grok runs the Claude Code hooks instead, and "
                         "their cards say Grok", "optional, for Grok's own hooks: " + _installer("--grok-hooks user"))
            else:
                self.add("grok hooks", "INFO", "not installed (optional: cards when a Grok session waits on you)",
                         "to install: " + _installer("--grok-hooks user --alerts"))
            return
        problems, parts = [], [_tilde(conf)]
        if not os.path.isfile(conf):
            problems.append("%s is missing" % _tilde(conf))
        else:
            try:
                with open(conf, "r", encoding="utf-8") as fh:
                    doc = json.load(fh)
                if not (isinstance(doc, dict) and isinstance(doc.get("hooks"), dict)):
                    raise ValueError("no hooks object")
            except (OSError, ValueError):
                problems.append("%s isn't a valid hooks file, so Grok ignores it" % _tilde(conf))
        if not os.path.isfile(hook):
            problems.append("%s is missing" % _tilde(hook))
        else:
            if not os.access(hook, os.X_OK):
                problems.append("%s is not executable" % _tilde(hook))
            try:
                with open(hook, "r", encoding="utf-8", errors="replace") as fh:
                    if "subagentType" not in fh.read():
                        problems.append("old hook (no Grok Build support)")
            except OSError:
                pass
        # Settings the installer can't change: an organization's managed-hooks-only policy, and
        # needs-you's hooks switched off in /hooks (~/.grok/disabled-hooks).
        policy = []
        for f in (os.path.join(home, "requirements.toml"), os.path.join(home, "managed_config.toml"),
                  "/etc/grok/requirements.toml", "/etc/grok/managed_config.toml"):
            try:
                with open(f, "r", encoding="utf-8", errors="replace") as fh:
                    text = fh.read(1024 * 1024)
            except OSError:
                continue
            if re.search(r"(?m)^\s*(allow_managed_hooks_only|allowManagedHooksOnly)\s*=\s*true", text):
                policy.append("allow_managed_hooks_only in %s turns them off" % _tilde(f))
        try:
            with open(os.path.join(home, "disabled-hooks"), "r", encoding="utf-8", errors="replace") as fh:
                if "needs-you" in fh.read(1024 * 1024):
                    policy.append("switched off in %s" % _tilde(os.path.join(home, "disabled-hooks")))
        except OSError:
            pass
        parts.append(self._alerts_part())
        if problems or policy:
            if problems:
                hint = installer
            elif any("disabled-hooks" in p for p in policy):
                hint = "turn them back on in Grok: /hooks, select the needs-you entries, Space"
            else:
                hint = "tell the person: their organization's Grok policy allows only managed hooks"
            self.add("grok hooks", "WARN", "; ".join(problems + policy + parts), hint)
            return
        hint = "restart Grok after installing or updating them"
        if parts[-1] == "alerts off until opted in":
            hint += "; for cards from every session here: echo 'NEEDS_YOU_AGENT_ALERTS=1' >> %s" % _sh(self.env_path)
        self.add("grok hooks", "OK", "installed in " + "; ".join(parts), hint)

    def project_hooks(self) -> None:
