# Claude Code settings files that can hold the hook entries, user level (~/.claude) or per
# project (<repo>/.claude, written by install-hooks.sh --project [--local]).
HOOK_FILE = "needs-you-hook.sh"
SETTINGS_NAMES = ("settings.json", "settings.local.json")


def _references_hook(path: str) -> bool:
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            return HOOK_FILE in fh.read()
    except OSError:
        return False


def project_claude_dir(start: Optional[str] = None) -> Optional[str]:
    """The project-level .claude directory with needs-you hooks that covers `start` (default:
    the current directory): the nearest one at or above it whose settings.json or
    settings.local.json references the hook. ~/.claude is the user level, never a project, and
    so is the .claude of any directory holding $HOME (a temp HOME made under a real home: the
    real ~/.claude above it) and of the account's own home directory."""
    user = os.path.realpath(_home(".claude"))
    homes = {os.path.realpath(os.path.expanduser("~"))}
    try:
        import pwd
        homes.add(os.path.realpath(pwd.getpwuid(os.getuid()).pw_dir))
    except (ImportError, KeyError, OSError):
        pass
    try:
        d = os.path.realpath(start or os.getcwd())
    except OSError:
        return None
    while True:
        c = os.path.join(d, ".claude")
        holds_home = any(h == d or h.startswith(d.rstrip("/") + "/") for h in homes)
        if (not holds_home and os.path.realpath(c) != user and plain_project_dir(c)
                and any(_references_hook(os.path.join(c, n)) for n in SETTINGS_NAMES)):
            return c
        parent = os.path.dirname(d)
        if parent == d:
            return None
        d = parent


def plain_project_dir(claude_dir: str) -> bool:
    """A project's .claude is the repo's, so untrusted (a clone can ship any files): it is
    only treated as a needs-you install when nothing on the paths needs-you reads, writes or
    deletes there is a symlink (.claude, .claude/hooks, the settings files, the hook), so
    acting on it can never touch a file outside that directory. Settings are read as data
    only; no command or path is ever taken from them."""
    paths = [claude_dir, os.path.join(claude_dir, "hooks"), os.path.join(claude_dir, "hooks", HOOK_FILE)]
    paths += [os.path.join(claude_dir, n) for n in SETTINGS_NAMES]
    return os.path.isdir(claude_dir) and not any(os.path.islink(x) for x in paths)


def hook_settings(claude_dir: str) -> List[str]:
    """The settings files in a .claude directory that reference the hook."""
    return [os.path.join(claude_dir, n) for n in SETTINGS_NAMES if _references_hook(os.path.join(claude_dir, n))]


def claude_projects() -> Dict[str, Any]:
    """Project installs install-hooks.sh recorded: {settings path: {"hooks_json_sha256": ...}}.
    Only entries shaped like <absolute dir>/.claude/settings[.local].json count."""
    try:
        with open(os.path.join(state_dir(), "claude-projects.json"), "r", encoding="utf-8") as fh:
            data = json.load(fh)
