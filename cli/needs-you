# Outbox
# ---------------------------------------------------------------------------

def queue(method: str, path: str, body: Optional[Dict[str, Any]]) -> str:
    d = outbox_dir()
    os.makedirs(d, mode=0o700, exist_ok=True)
    name = "%020d-%05d.json" % (time.time_ns(), os.getpid() % 100000)
    tmp = os.path.join(d, "." + name + ".tmp")
    entry = {"method": method, "path": path, "body": body,
             "queued_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump(entry, fh)
    final = os.path.join(d, name)
    os.replace(tmp, final)
    prune()
    return final


def _env_number(name: str, default: float) -> float:
    try:
        return float(os.environ.get(name) or default)
    except ValueError:
        return default


def _prune_dir(d: str, max_files: int, max_age_s: float) -> int:
    """Drop entries older than max_age_s, then the oldest beyond max_files. Names start
    with time_ns, so sorting by name is oldest first. Returns how many were dropped."""
    try:
        names = sorted(n for n in os.listdir(d) if n.endswith(".json") and not n.startswith("."))
    except OSError:
        return 0
    cutoff_ns = (time.time() - max_age_s) * 1e9
    drop = []
    keep = []
    for n in names:
        try:
            ts = int(n.split("-", 1)[0])
        except ValueError:  # not our naming: judge it by its mtime instead
            try:
                ts = int(os.path.getmtime(os.path.join(d, n)) * 1e9)
            except OSError:
                continue
        (drop if ts < cutoff_ns else keep).append(n)
    if len(keep) > max_files:
        drop += keep[:len(keep) - max_files]
    for n in drop:
        try:
            os.remove(os.path.join(d, n))
        except OSError:
            pass
    return len(drop)


def prune() -> int:
    # At least the request just queued, which goes out next: a cap of 0 (or less) meant every
    # post was dropped before it was sent, with the hub up.
    max_files = max(1, int(_env_number("NEEDS_YOU_OUTBOX_MAX", 500)))
    max_age = max(60.0, _env_number("NEEDS_YOU_OUTBOX_MAX_DAYS", 7) * 86400)
    d = outbox_dir()
    dropped = _prune_dir(d, max_files, max_age)
    _prune_dir(os.path.join(d, "failed"), min(max_files, 100), max_age)
    if dropped:
        warn("outbox over its cap (%d requests / %g days): dropped the %d oldest"
             % (max_files, max_age / 86400, dropped))
    return dropped


def pending() -> List[str]:
    d = outbox_dir()
    try:
        names = sorted(n for n in os.listdir(d) if n.endswith(".json") and not n.startswith("."))
    except OSError:
        return []
    return [os.path.join(d, n) for n in names]


# How long a request waits for another run that is sending the outbox before it queues
# behind it instead (rule: never hang the caller). Once one wait timed out, this process
# doesn't wait again (a `flush` resolving many ended sessions stays quick).
LOCK_WAIT_SECONDS = 2.0
_LOCK_GAVE_UP = False


def _lock(wait: float = 0.0):  # type: ignore[no-untyped-def]
    """Exclusive lock on the outbox, so two invocations don't double-send or overtake each
    other. Waits up to `wait` seconds for it; None if it's still held (or can't be taken)."""
    global _LOCK_GAVE_UP
    d = outbox_dir()
    try:
        os.makedirs(d, mode=0o700, exist_ok=True)
        import fcntl
        fd = os.open(os.path.join(d, ".lock"), os.O_WRONLY | os.O_CREAT | os.O_APPEND
                     | getattr(os, "O_NOFOLLOW", 0), 0o600)
        fh = os.fdopen(fd, "a")
        deadline = time.monotonic() + (0.0 if _LOCK_GAVE_UP else wait)
        while True:
            try:
                fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                return fh
            except OSError:
                if time.monotonic() >= deadline:
                    fh.close()
                    if wait > 0:
                        _LOCK_GAVE_UP = True
                    return None
                time.sleep(0.05)
    except (OSError, ImportError):
        return None


QUEUED_PATHS = ("/v1/items", "/v1/items/resolve")  # the only requests the CLI queues


def _remove(path: str) -> None:
    """Delete a sent entry. Another invocation's prune() (which runs without the lock) may
    have dropped it already; that's fine. An outbox this user can't change (a chmod, a
    read-only mount) leaves the entry to be sent again: say so once, never crash."""
    global _REMOVE_WARNED
    try:
        os.remove(path)
    except FileNotFoundError:
        pass
    except OSError as e:
        if not _REMOVE_WARNED:
            _REMOVE_WARNED = True
            warn("can't delete sent entries from the outbox (%s); fix its permissions (%s)"
                 % (type(e).__name__, os.path.dirname(path)))


_REMOVE_WARNED = False


class _Flush:
    """One pass over the outbox, under its lock. `results` has the outcome for each entry
    sent or refused: (url, status, response) or a Rejected."""

    def __init__(self) -> None:
        self.sent = self.dropped = 0
        self.unreachable: Optional[Unreachable] = None
        self.results: Dict[str, Any] = {}
        self.tried: set = set()


def _flush_locked(cfg: Config, verbose: bool = False, mine: Optional[str] = None) -> _Flush:
    """Send queued entries oldest first; the caller holds the lock. Stops at the first
    unreachable attempt. Entries queued meanwhile (by runs that gave up waiting for the lock)
    are sent too, in order.

    `429 too_many_open` (the volume guard) on a queued add keeps it queued for a later run,
    and the entries behind it still go (a resolve among them may be what lowers the count).
    So per-key order holds: a later resolve of that key makes the held add moot (it's
    deleted), and a later add of the key replaces it (a re-post is the full current view).
    `mine` is the caller's own entry: a refusal deletes it (the caller reports it) instead of
    moving it to outbox/failed/ or holding it."""
    out = _Flush()
    held: Dict[str, List[str]] = {}  # key -> queued adds kept back by 429

    def drop_held(key: Optional[str]) -> None:
        if key:
            for p in held.pop(key, []):
                _remove(p)

    while out.unreachable is None:
        fresh = [p for p in pending() if p not in out.tried]
        if not fresh:
            break
        for path in fresh:
            out.tried.add(path)
            try:
                with open(path, "r", encoding="utf-8") as fh:
                    entry = json.load(fh)
            except (OSError, ValueError):
                entry = None
            # Replayed with this machine's token, so only what queue() ever writes: a planted
            # path such as "@other.host/x" would turn url + path into another host.
            if not (isinstance(entry, dict) and entry.get("method") == "POST"
                    and entry.get("path") in QUEUED_PATHS and isinstance(entry.get("body"), dict)):
                _move_failed(path)  # unreadable, or not an entry this CLI wrote
                out.dropped += 1
                continue
            is_resolve = entry["path"].endswith("/resolve")
            key = entry["body"].get("key")
            key = key if isinstance(key, str) and key else None
            try:
                result = send(cfg, entry["method"], entry["path"], entry.get("body"))
                _remove(path)
                out.sent += 1
                out.results[path] = result
                _after_sent(entry["path"], entry["body"], result[2])
                drop_held(key)  # resolved, or re-posted in full: the held add is moot
                if verbose and path != mine:
                    warn("sent queued %s %s via %s" % (entry["method"], entry["path"], result[0]))
            except Rejected as e:
                out.results[path] = e
                if path == mine:
                    _remove(path)
                    continue
                if e.status == 429 and not is_resolve:
                    if key:
                        drop_held(key)
                        held[key] = [path]
                    if verbose:
                        warn("hub refused a queued item for now (%s); kept it queued" % e)
                    continue
                warn("hub rejected a queued request (%s); moved it to outbox/failed/" % e)
                _move_failed(path)
                out.dropped += 1
            except Unreachable as e:
                out.unreachable = e
                break
    return out


def flush(cfg: Config, verbose: bool = False) -> Tuple[int, int, int]:
    """Send queued entries oldest first, if no other run is doing it right now. Stops at the
    first unreachable attempt. Returns (sent, dropped, remaining)."""
    files = pending()
    if files:
        prune()
        files = pending()
    if not files or not cfg.ok:
        return 0, 0, len(files)
    lock = _lock()
    if lock is None:
        return 0, 0, len(pending())
    try:
        out = _flush_locked(cfg, verbose)
    finally:
        lock.close()
    _catch_stragglers(cfg, out)
    return out.sent, out.dropped, len(pending())


def _catch_stragglers(cfg: Config, done: _Flush) -> None:
    """An entry queued by a run that gave up waiting just as we released the lock would sit
    until the next run: send it now (if the hub was reachable and nobody else has the lock)."""
    if done.unreachable is not None or not [p for p in pending() if p not in done.tried]:
        return
    lock = _lock()
    if lock is None:
        return  # the run that has it sends them
    try:
        _flush_locked(cfg)
    finally:
        lock.close()


