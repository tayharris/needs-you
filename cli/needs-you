            and os.path.basename(k) in SETTINGS_NAMES and os.path.basename(os.path.dirname(k)) == ".claude"
            and isinstance(v, dict)}


def _without_hook_entries(settings: Dict[str, Any]) -> Dict[str, Any]:
    """settings with every needs-you hook entry removed (the same rule as install-hooks.sh:
    a command naming needs-you-hook.sh), other hooks and their groups untouched."""
    hooks = settings.get("hooks")
    if not isinstance(hooks, dict):
        return settings
    out: Dict[str, Any] = {}
    for event, groups in hooks.items():
        if not isinstance(groups, list):
            out[event] = groups
            continue
        kept_groups = []
        for group in groups:
            # Cursor's entries are flat ({"command": ...}), not groups of hooks.
            if (isinstance(group, dict) and not isinstance(group.get("hooks"), list)
                    and HOOK_FILE in str(group.get("command", ""))):
                continue
            if isinstance(group, dict) and isinstance(group.get("hooks"), list):
                kept = [h for h in group["hooks"]
                        if not (isinstance(h, dict) and HOOK_FILE in str(h.get("command", "")))]
                if len(kept) != len(group["hooks"]):
                    if not kept:
                        continue
                    group = dict(group, hooks=kept)
            kept_groups.append(group)
        if kept_groups:
            out[event] = kept_groups
    new = dict(settings)
    if out:
        new["hooks"] = out
    else:
        new.pop("hooks", None)
    return new


def _strip_hook_file(path: str, follow: bool, dry_run: bool, say: Any) -> Optional[bool]:
    """Take the needs-you entries out of one JSON config file (Claude settings, Codex
    hooks.json, Gemini settings.json: all keep hooks as {event: [{hooks: [...]}]}). True when
    it removed (or would remove) some, False when there were none, None when it couldn't.
    follow: write through a symlink (only the user's own ~/.claude settings)."""
    try:
        with open(path, "r", encoding="utf-8") as fh:
            text = fh.read()
        settings = json.loads(text)
        if not isinstance(settings, dict):
            raise ValueError("not a JSON object")
    except (OSError, ValueError) as e:
        warn("%s: can't read it (%s); fix it first, nothing was changed" % (_tilde(path), e))
        return None
    new = _without_hook_entries(settings)
    if new == settings:  # mentioned somewhere other than a hook command; leave it
        return False
    if dry_run:
        say("would remove the needs-you hooks from %s" % _tilde(path))
        return True
    try:
        target = os.path.realpath(path) if follow else path
        mode = os.stat(target).st_mode & 0o777
        bak = "%s.bak-%s-%d" % (target, time.strftime("%Y%m%d-%H%M%S"), os.getpid())
        fd = os.open(bak, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(text)
        _write_atomic(target, (json.dumps(new, indent=2, ensure_ascii=False) + "\n").encode("utf-8"), mode)
    except OSError as e:
        warn("%s: couldn't write it (%s)" % (_tilde(path), e))
        return None
    say("removed the needs-you hooks from %s (backup: %s.bak-*)" % (_tilde(path), _tilde(path)))
    return True


# Kimi Code's config.toml holds needs-you's [[hooks]] as one block between these comment lines
# (integrations/kimi/install-kimi-hooks.sh, which edits it as text: no TOML parser in 3.9).
KIMI_BLOCK_START = "# needs-you (managed by install-kimi-hooks.sh"
KIMI_BLOCK_END = "# end needs-you"


def _strip_kimi_block(path: str, dry_run: bool, say: Any) -> Optional[bool]:
    """Take the needs-you block out of Kimi Code's config.toml, the rest byte for byte (as
    install-kimi-hooks.sh --uninstall does). True when it removed (or would remove) it, False
    when there was none, None when it couldn't."""
    try:
        with open(path, "r", encoding="utf-8", newline="") as fh:
            text = fh.read()
    except (OSError, UnicodeDecodeError) as e:
        warn("%s: can't read it (%s); nothing was changed" % (_tilde(path), e))
        return None
    lines = text.splitlines(True)
    kept: List[str] = []
    i, found = 0, False
    while i < len(lines):
        if lines[i].startswith(KIMI_BLOCK_START):
            j = i
            while j < len(lines) and lines[j].rstrip("\r\n") != KIMI_BLOCK_END:
                j += 1
            if j == len(lines):
                warn("%s: a needs-you block with no '%s' line; fix it by hand, nothing was changed"
                     % (_tilde(path), KIMI_BLOCK_END))
                return None
            if kept and kept[-1].strip() == "":
                kept.pop()
            found, i = True, j + 1
            continue
        kept.append(lines[i])
        i += 1
    if not found:
        return False
    if dry_run:
        say("would remove the needs-you hooks from %s" % _tilde(path))
        return True
    try:
        mode = os.stat(path).st_mode & 0o777
        bak = "%s.bak-%s-%d" % (path, time.strftime("%Y%m%d-%H%M%S"), os.getpid())
        fd = os.open(bak, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0), 0o600)
        with os.fdopen(fd, "w", encoding="utf-8", newline="") as fh:
            fh.write(text)
        _write_atomic(path, "".join(kept).encode("utf-8"), mode)
    except OSError as e:
        warn("%s: couldn't write it (%s)" % (_tilde(path), e))
        return None
    say("removed the needs-you hooks from %s (backup: %s.bak-*)" % (_tilde(path), _tilde(path)))
    return True


def _delete_files(paths: List[str], dry_run: bool, say: Any) -> None:
    """Delete our copied files (never through a symlink: callers check) and their dirs once empty."""
    for p in paths:
        if not os.path.isfile(p) or os.path.islink(p):
            continue
        if dry_run:
            say("would delete %s" % _tilde(p))
            continue
        try:
            os.remove(p)
            say("deleted %s" % _tilde(p))
            os.rmdir(os.path.dirname(p))
        except OSError:
            pass


UNINSTALL_AGENTS = ("codex", "gemini", "opencode", "copilot", "cursor", "cline", "aider", "kimi", "grok")


def uninstall_hooks(user: bool, project: Optional[str], agents: Sequence[str], dry_run: bool,
                    quiet: bool) -> int:
    """`needs-you uninstall-hooks`: take the needs-you entries out of the agents' config
    files and delete the copied hook script (and the opencode plugin), with no hub and no
    download. With no scope: Claude Code's user level, the project covering the current
    directory, every recorded project install, and the Codex, Gemini CLI, opencode, Copilot
    CLI, Cursor, Cline, Aider, Kimi Code and Grok Build installs. --user, --project and one
    flag per agent pick some. Exit 1 if a file couldn't be changed (unreadable JSON, a symlink
    where needs-you would write)."""
    say = (lambda msg: None) if quiet else print  # noqa: E731
    everything = not (user or project is not None or agents)
    dirs: List[str] = []
    if user or everything:
        dirs.append(_home(".claude"))
    if project is not None:
        start = os.path.abspath(os.path.expanduser(project))
        found = project_claude_dir(start)
        dirs.append(found or os.path.join(start, ".claude"))
    if everything:
        found = project_claude_dir()
        if found:
            dirs.append(found)
        dirs.extend(os.path.dirname(p) for p in sorted(claude_projects()))
    seen, failed, removed = set(), False, 0
    forget: List[str] = []
    user_dir = os.path.realpath(_home(".claude"))
    for d in dirs:
        real = os.path.realpath(d)
        if real in seen:
            continue
        seen.add(real)
        is_user = real == user_dir
        if not is_user and os.path.lexists(d) and not plain_project_dir(d):
            warn("%s: a symlink where needs-you writes; not touching it (remove the hooks there by hand)"
                 % _tilde(d))
            failed = True
            continue
        for name in SETTINGS_NAMES:
            path = os.path.join(d, name)
            if not _references_hook(path):
                forget.append(os.path.realpath(path))
                continue
            # The user's own settings may be a symlink (dotfile managers), written through as
            # install-hooks.sh does; a project's never is (plain_project_dir above).
            done = _strip_hook_file(path, is_user, dry_run, say)
            if done is None:
                failed = True
                continue
            if done and not dry_run:
                removed += 1
            if not dry_run:
                forget.append(os.path.realpath(path))
        if not hook_settings(d):  # (in a dry run the entries are still there: kept)
            _delete_files([os.path.join(d, "hooks", HOOK_FILE)], dry_run, say)
    # Codex and Gemini CLI: their own config file and hook copy (the same entry rule as
    # their installers; those come from the hub, so they may not be on this machine).
    # Like the installers, never through a symlink: those files could point anywhere.
    for agent, label, home_fn, conf_name, *_rest in OTHER_AGENTS:
        if not (everything or agent in agents):
            continue
        d = home_fn()
        conf, hook = os.path.join(d, conf_name), os.path.join(d, "hooks", HOOK_FILE)
        if not os.path.lexists(conf) and not os.path.lexists(hook):
            continue
        links = [p for p in (conf, os.path.join(d, "hooks"), hook) if os.path.islink(p)]
        if links:
            warn("%s is a symlink; not touching the %s hooks (remove them by hand)" % (_tilde(links[0]), label))
            failed = True
            continue
        done = False
        if _references_hook(conf):
            if conf_name.endswith(".toml"):  # Kimi Code: its marked block
                done = _strip_kimi_block(conf, dry_run, say)
            else:
                done = _strip_hook_file(conf, False, dry_run, say)
            if done is None:
                failed = True
                continue
            if done and not dry_run:
                removed += 1
        if not _references_hook(conf) or (dry_run and done):
            _delete_files([hook], dry_run, say)
    # opencode: the plugin and its hook copy are ours; no config file to edit.
    if everything or "opencode" in agents:
        d = opencode_dir()
        files = [os.path.join(d, "plugins", "needs-you.js"), os.path.join(d, "hooks", HOOK_FILE)]
        links = [p for p in files + [os.path.dirname(f) for f in files] if os.path.islink(p)]
        if links:
            warn("%s is a symlink; not touching the opencode plugin (remove it by hand)" % _tilde(links[0]))
            failed = True
        elif any(os.path.isfile(f) for f in files):
            if not dry_run and os.path.isfile(files[0]):
                removed += 1
            _delete_files(files, dry_run, say)
    # Copilot CLI and Grok Build: hooks/needs-you.json and the hook copy next to it are both ours.
    for agent, label, home_fn in (("copilot", "Copilot CLI", copilot_home), ("grok", "Grok Build", grok_home)):
        if not (everything or agent in agents):
            continue
        d = os.path.join(home_fn(), "hooks")
        files = [os.path.join(d, "needs-you.json"), os.path.join(d, HOOK_FILE)]
        links = [p for p in [d] + files if os.path.islink(p)]
        if links:
            warn("%s is a symlink; not touching the %s hooks (remove them by hand)" % (_tilde(links[0]), label))
            failed = True
        elif any(os.path.isfile(f) for f in files):
            if not dry_run and os.path.isfile(files[0]):
                removed += 1
            _delete_files(files, dry_run, say)
    # Cline: the hook files it wrote (marked) in Cline's hooks directory, and its hook copy.
    if everything or "cline" in agents:
        d = cline_hooks_dir()
        hook = os.path.join(cline_home(), "hooks", HOOK_FILE)
        stubs = [os.path.join(d, e) for e in CLINE_EVENTS]
        links = [x for x in [d, os.path.dirname(hook), hook] + stubs if os.path.islink(x)]
        if links:
            warn("%s is a symlink; not touching the Cline hooks (remove them by hand)" % _tilde(links[0]))
            failed = True
        else:
            mine = [f for f in stubs if _cline_stub(f)]
            if mine and not dry_run:
                removed += 1
            _delete_files(mine + [hook], dry_run, say)
            _rmdir_quiet(cline_home(), dry_run)
    # Aider: the marked block in ~/.aider.conf.yml, and its hook copy.
    if everything or "aider" in agents:
        conf, hook = aider_conf(), os.path.join(aider_home(), "hooks", HOOK_FILE)
        links = [x for x in (conf, os.path.dirname(hook), hook) if os.path.islink(x)]
        if links:
            warn("%s is a symlink; not touching the Aider setup (remove the needs-you lines by hand)"
                 % _tilde(links[0]))
            failed = True
        else:
            done = _strip_aider_block(conf, dry_run, say)
            if done is None:
                failed = True
            else:
                if done and not dry_run:
                    removed += 1
                _delete_files([hook], dry_run, say)
                _rmdir_quiet(aider_home(), dry_run)
    # The MCP server and the instruction blocks (--mcp, --instructions).
    if everything or "mcp" in agents or "instructions" in agents:
        n, bad = uninstall_extras(everything or "mcp" in agents, everything or "instructions" in agents, dry_run, say)
        removed += n if not dry_run else 0
        failed = failed or bad
    if not dry_run:
        projects = claude_projects()
        left = {k: v for k, v in projects.items() if k not in forget}
        if left != projects:
            try:
                _write_atomic(os.path.join(state_dir(), "claude-projects.json"),
                              json.dumps(left, indent=1, sort_keys=True).encode("utf-8"), 0o600)
            except OSError:
                pass
    if removed:
        say("Restart open agent sessions to drop the hooks (in Claude Code, opening /hooks is enough).")
    elif not failed and not dry_run:
        say("no needs-you hooks found%s" % (" (a project elsewhere: run this inside it, or with --project DIR)"
                                           if everything else ""))
    return 1 if failed else 0


