    # -- Codex CLI hooks ---------------------------------------------------
    def codex_hooks(self) -> None:
        import re
        import shutil
        home = os.environ.get("CODEX_HOME") or os.path.join(self.home, ".codex")
        hook = os.path.join(home, "hooks", "needs-you-hook.sh")
        hooks_json = os.path.join(home, "hooks.json")
        installer = _rerun("--codex-hooks user")
        if not os.path.isdir(home):
            if shutil.which("codex"):
                self.add("codex hooks", "INFO", "%s not found; Codex hasn't run for this user yet" % _tilde(home),
                         "after a first Codex run: " + _installer("--codex-hooks user --alerts"))
            return
        doc: Any = None
        try:
            with open(hooks_json, "r", encoding="utf-8", errors="replace") as fh:
                text = fh.read()
            referenced = "needs-you-hook.sh" in text
            try:
                doc = json.loads(text) if text.strip() else {}
            except ValueError:
                doc = None
        except OSError:
            text, referenced, doc = "", False, {}
        exists = os.path.isfile(hook)
        if not exists and not referenced:
            self.add("codex hooks", "INFO", "not installed (optional: cards when a Codex session waits on you)",
                     "to install: " + _installer("--codex-hooks user --alerts"))
            return
        problems, parts, hints = [], [_tilde(hooks_json)], []
        if doc is None:
            problems.append("%s isn't valid JSON, so Codex loads none of its hooks" % _tilde(hooks_json))
        if not exists:
            problems.append("%s references the hook but %s is missing" % (_tilde(hooks_json), _tilde(hook)))
        else:
            if not os.access(hook, os.X_OK):
                problems.append("%s is not executable" % _tilde(hook))
            if not referenced:
                problems.append("%s doesn't reference it" % _tilde(hooks_json))
            try:
                with open(hook, "r", encoding="utf-8", errors="replace") as fh:
                    if "codex" not in fh.read():
                        problems.append("old hook (no Codex support)")
            except OSError:
                pass
        # [features] hooks = false turns every hook off.
        config_text = ""
        try:
            with open(os.path.join(home, "config.toml"), "r", encoding="utf-8", errors="replace") as fh:
                config_text = fh.read()
        except OSError:
            pass
        section = ""
        for line in config_text.splitlines():
            s = line.strip()
            if s.startswith("["):
                section = s
            elif section == "[features]" and re.match(r"^hooks\s*=\s*false\b", s):
                problems.append("hooks = false under [features] in %s" % _tilde(os.path.join(home, "config.toml")))
        # Codex runs a hook only once it's trusted (/hooks); it records that in config.toml as
        # [hooks.state."<hooks.json>:<event>:<group>:<handler>"]. Only claim "untrusted" when that
        # table exists for this file but not for our PermissionRequest entry.
        if isinstance(doc, dict) and isinstance(doc.get("hooks"), dict):
            groups = doc["hooks"].get("PermissionRequest")
            pos = None
            if isinstance(groups, list):
                for gi, g in enumerate(groups):
                    hs = g.get("hooks") if isinstance(g, dict) else None
                    for hi, h in enumerate(hs if isinstance(hs, list) else []):
                        if isinstance(h, dict) and "needs-you-hook.sh" in str(h.get("command", "")):
                            pos = (gi, hi)
            state_prefix = '[hooks.state."%s:' % hooks_json
            if pos is not None and state_prefix in config_text:
                if '%spermission_request:%d:%d"]' % (state_prefix, pos[0], pos[1]) not in config_text:
                    problems.append("Codex hasn't trusted them yet")
                    hints.append("start Codex, open /hooks and trust the needs-you entries")
        alerts, where = self.setting("NEEDS_YOU_AGENT_ALERTS")
        if alerts.lower() in _OFF:
            parts.append("alerts off (NEEDS_YOU_AGENT_ALERTS=%s in %s)" % (alerts, where))
        elif alerts.lower() in _ON:
            parts.append("alerts on (NEEDS_YOU_AGENT_ALERTS=%s in %s)" % (alerts, where))
        else:
            parts.append("alerts off until opted in")
        if problems:
            if not hints:
                hints.append(installer)
            self.add("codex hooks", "WARN", "; ".join(problems + parts), "; ".join(hints))
            return
        hint = "Codex runs a new hook only after you trust it: open /hooks in Codex once"
        if "alerts off until opted in" in parts:
            hint += "; for cards from every session here: echo 'NEEDS_YOU_AGENT_ALERTS=1' >> %s" % _sh(self.env_path)
        self.add("codex hooks", "OK", "installed in " + "; ".join(parts), hint)

