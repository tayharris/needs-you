        except OSError:
            text = ""
        block = AIDER_BEGIN in text
        if not block and not os.path.isfile(hook):
            if shutil.which("aider") or os.path.isfile(conf):
                self.add("aider notifications", "INFO",
                         "not installed (optional: a card when Aider waits for you)",
                         "to install: " + _installer("--aider --alerts"))
            return
        problems = []
        if not block and "needs-you-hook.sh" not in text:  # (set by hand is fine)
            problems.append("%s doesn't run the hook (no notifications-command for it)" % _tilde(conf))
        problems += self._hook_copy_problems(hook, "aider_card", "Aider")
        parts = [_tilde(conf), self._alerts_part()]
