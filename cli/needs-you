        problems += self._hook_copy_problems(hook, "cline_card", "Cline")
        parts = [_tilde(d), self._alerts_part()]
        if problems:
            self.add("cline hooks", "WARN", "; ".join(problems + parts), installer)
            return
        hint = "Cline has no approval hook: cards come when a task finishes, not when it asks"
        if parts[-1] == "alerts off until opted in":
            hint += "; for cards from every session here: echo 'NEEDS_YOU_AGENT_ALERTS=1' >> %s" % _sh(self.env_path)
        self.add("cline hooks", "OK", "installed in " + "; ".join(parts), hint)

    # -- Aider notifications -----------------------------------------------
    def aider_notifications(self) -> None:
        import shutil
        conf = os.path.join(self.home, ".aider.conf.yml")
