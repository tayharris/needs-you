        if not handle and not shutil.which("orca"):
            return
        parts = ["ORCA_TERMINAL_HANDLE %s" % ("set" if handle else "not set (not an Orca terminal)"),
                 "ORCA_WORKTREE_ID %s" % ("set" if os.environ.get("ORCA_WORKTREE_ID") else "not set")]
        env_name, where = self.setting("NEEDS_YOU_ORCA_ENVIRONMENT")
        hint = ""
        if env_name:
            parts.append("NEEDS_YOU_ORCA_ENVIRONMENT=%s (%s)" % (env_name, where))
        else:
