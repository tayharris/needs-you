def leases_dir() -> str:
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
    return os.path.join(base, "needs-you", "claude-hooks")


def _read_lease(path: str) -> Dict[str, str]:
    out: Dict[str, str] = {}
    try:
        with open(path, "r", encoding="utf-8") as fh:
            for line in fh:
                k, sep, v = line.rstrip("\n").partition("=")
                if sep:
                    out[k] = v
    except (OSError, UnicodeDecodeError):
        pass
    return out


def _process_start(pid: int, utc: bool = False) -> Optional[str]:
    """The process's start time as `ps -o lstart=` prints it (the hook records the
    same), in local time or (utc) in UTC, "" if there is no such process, None if we
    can't tell."""
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return ""
    except PermissionError:
        pass  # alive, owned by someone else
    except OSError:
        return None
    import subprocess
    try:
        r = subprocess.run(["ps", "-o", "lstart=", "-p", str(pid)], stdin=subprocess.DEVNULL,
                           capture_output=True, text=True, timeout=5,
                           env=dict(os.environ, LC_ALL="C", **({"TZ": "UTC0"} if utc else {})))
    except (OSError, subprocess.SubprocessError):
        return None
    start = " ".join(r.stdout.split())
    if not start:
        # ps printed nothing: the process exited just now, or ps itself failed (kill 0 said
        # it was alive a moment ago). Only the former means "gone".
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            return ""
        except OSError:
            pass
        return None
    return start


def reap_leases(cfg: Config, verbose: bool = False) -> int:
    """Resolve the card of every hook lease whose Claude process is gone (or whose pid
    now belongs to a newer process). The hook writes one marker per session:
    key=, pid=, start=. Markers without a pid (older hooks) are left alone."""
    d = leases_dir()
    try:
        names = sorted(n for n in os.listdir(d) if not n.startswith("."))
    except OSError:
        return 0
    reaped = 0
    for name in names:
        path = os.path.join(d, name)
        lease = _read_lease(path)
        key, pid, start = lease.get("key", ""), lease.get("pid", ""), lease.get("start", "")
        if not key.startswith("agent:") or not pid.isdigit() or not start:
            continue
        # ps prints local time and this may run in another TZ than the hook did (cron's):
        # compare in UTC when the hook recorded it (start_utc, hooks after 0.1.3).
        utc = bool(lease.get("start_utc"))
        start = lease["start_utc"] if utc else start
        now_start = _process_start(int(pid), utc=utc)
        if now_start is None or now_start == " ".join(start.split()):
            continue  # alive, or unknown: leave it
        if _read_lease(path) != lease:
            continue  # the hook just re-posted from a new session
        try:
            os.remove(path)
        except OSError:
            continue
        deliver(cfg, "POST", "/v1/items/resolve", {"key": key}, True, False)
        reaped += 1
        if verbose:
            warn("session %s ended; resolved %s" % (pid, key))
    return reaped


# The agent's own open items, per agent session. When an agent in a session posts a `needs`
# item (the skill), the hook skips its generic "waiting for you" / "turn ended" card for
# that session while the item is open: one card for one wait. The session is named as the
# hook names it (agent_session below): $ORCA_TERMINAL_HANDLE in Orca (any agent), else the
# agent's session id as its commands see it and its hooks get it as session_id. Gemini CLI
# gives its commands no session id, so there it's the Gemini process: "pid-<pid>", which the
# hook matches against its lease (the same process, by pid and start time).
SESSION_ITEM_MAX_HOURS = 48.0
# What the hook's lease search skips on the way up to the agent process (keep in step).
_LEASE_SKIP = ("sh", "-sh", "bash", "-bash", "dash", "zsh", "-zsh", "env", "timeout", "nohup")


def session_items_dir() -> str:
    return os.path.join(state_dir(), "session-items")


def _session_name(raw: str) -> str:
    """An id sanitized like the hook's (A-Za-z0-9._- kept, 80 chars); never "." or ".."."""
    sess = re.sub(rb"[^A-Za-z0-9._-]", b"_", raw.encode("utf-8"))[:80].decode("ascii")
    return sess if sess.strip(".") else ""


def _agent_process(want: str = "") -> Tuple[int, str]:
    """(pid, start) of the agent that ran this command, found as the hook finds its lease: the
    first ancestor that isn't a shell. (0, "") when it can't be told, or (with `want`) when that
    ancestor's command name isn't `want`."""
    import subprocess

    def ps(field: str, pid: int) -> str:
        r = subprocess.run(["ps", "-o", field + "=", "-p", str(pid)], stdin=subprocess.DEVNULL,
                           capture_output=True, text=True, timeout=5, env=dict(os.environ, LC_ALL="C"))
        return r.stdout.strip()

    pid, hops = os.getppid(), 0
    while hops < 8 and pid > 1:
        try:
            comm, ppid = os.path.basename(ps("comm", pid)), ps("ppid", pid)
        except (OSError, subprocess.SubprocessError):
            return 0, ""
        if not comm or not ppid.isdigit():
            return 0, ""
        if comm not in _LEASE_SKIP:
            if want and comm != want:
                return 0, ""
            start = _process_start(pid)
            return (pid, start) if start else (0, "")
        pid, hops = int(ppid), hops + 1
    return 0, ""


def agent_session() -> Tuple[str, str]:
    """(session, start) for this command's agent session as the hook names it: the Orca
    terminal handle; else Claude Code's $CLAUDE_CODE_SESSION_ID; Codex's $CODEX_SESSION_ID
    (the root session, which its hooks get; before Codex had it, $CODEX_THREAD_ID);
    $NEEDS_YOU_AGENT_SESSION, which any connector can set for its agent's commands (the
    needs-you opencode plugin does, through shell.env); or, in Gemini CLI
    ($GEMINI_CLI=1), "pid-<pid>" of the Gemini process with its start time; the same for Kimi
    Code, whose Bash tool gives its commands no session id either, only TERM=dumb (the hook's
    lease names the kimi process). ("", "") outside any of these."""
    env = os.environ
    raw = env.get("ORCA_TERMINAL_HANDLE") or ""
    if not raw and env.get("CLAUDECODE"):
        raw = env.get("CLAUDE_CODE_SESSION_ID") or ""
    raw = raw or env.get("CODEX_SESSION_ID") or env.get("CODEX_THREAD_ID") or env.get("NEEDS_YOU_AGENT_SESSION") or ""
    if raw:
        return _session_name(raw), ""
    if env.get("GEMINI_CLI") == "1" or env.get("TERM") == "dumb":
        pid, start = _agent_process("" if env.get("GEMINI_CLI") == "1" else "kimi")
        if pid:
            return "pid-%d" % pid, start
    return "", ""


def _prune_session_items(base: str) -> None:
    """Drop expired records, and session directories left empty (sessions that ended)."""
    now = time.time()
    for sess in os.listdir(base):
        d = os.path.join(base, sess)
        if os.path.islink(d) or not os.path.isdir(d):
            continue
        for name in os.listdir(d):
            p = os.path.join(d, name)
            try:
                exp = float(_read_lease(p).get("expires") or 0)
            except ValueError:
                exp = 0
            if exp < now:
                try:
                    os.remove(p)
                except OSError:
                    pass
        try:
            os.rmdir(d)  # only when empty
        except OSError:
            pass


# key -> the id the hub gave it, for the items this run sent (an add sent from the outbox
# learns its id only then): the note keeps it, so `resolve --id` can find the note.
_SENT_IDS: Dict[str, str] = {}


def _note_name(key: str) -> str:
    return hashlib.sha256(key.encode("utf-8")).hexdigest()[:32]


def _session_notes(name: Optional[str] = None) -> List[str]:
    """Every note file (or every one named `name`) across the sessions."""
    base = session_items_dir()
    out: List[str] = []
    try:
        sessions = os.listdir(base)
    except OSError:
        return out
    for sess in sessions:
        d = os.path.join(base, sess)
        if os.path.islink(d) or not os.path.isdir(d):
            continue
        try:
            names = [name] if name else os.listdir(d)
        except OSError:
            continue
        out.extend(os.path.join(d, n) for n in names if os.path.isfile(os.path.join(d, n)))
    return out


def forget_session_item_id(item_id: str) -> None:
    """`resolve --id`: forget the notes of the item with that id. Never raises."""
    if not item_id:
        return
    for path in _session_notes():
        if _read_lease(path).get("id") == item_id:
            try:
                os.remove(path)
            except OSError:
                pass


def _after_sent(path: str, body: Dict[str, Any], resp: Dict[str, Any]) -> None:
    """Keep the session notes in step with what the hub said. A resolve (by key or id) names
    the items it closed; an add of a `needs` item names its id, which its note keeps."""
    try:
        if path == "/v1/items/resolve":
            for item in resp.get("items") or []:
                if isinstance(item, dict) and isinstance(item.get("key"), str):
                    note_session_item(item["key"], open_=False)
            return
        key, item_id = body.get("key"), resp.get("id")
        if not (isinstance(key, str) and isinstance(item_id, str) and body.get("kind", "needs") == "needs"):
            return
        _SENT_IDS[key] = item_id
        for note in _session_notes(_note_name(key)):
            lease = _read_lease(note)
            if lease.get("key") == clean(key) and lease.get("id") != item_id:
                lease["id"] = item_id
                _write_atomic(note, "".join("%s=%s\n" % kv for kv in lease.items()).encode("utf-8"), 0o600)
    except (OSError, ValueError, AttributeError):
        pass


def note_session_item(key: str, open_: bool, expires_in: Optional[float] = None) -> None:
    """Record (open_) or forget an item key for the hook. Never raises."""
    try:
        name = _note_name(key)
        base = session_items_dir()
        if expires_in is not None and expires_in <= 0:
            open_ = False  # posted already expired: nothing waits on it
        if not open_:  # resolved, or now done/info: no session waits on it any more
            for note in _session_notes(name):
                try:
                    os.remove(note)
                except OSError:
                    pass
            return
        sess, start = agent_session()
        if not sess:
            return
        hours = expires_in if expires_in is not None and 0 < expires_in < SESSION_ITEM_MAX_HOURS \
            else SESSION_ITEM_MAX_HOURS
        if os.path.isdir(base):
            _prune_session_items(base)
        d = os.path.join(base, sess)
        os.makedirs(d, mode=0o700, exist_ok=True)
        text = "key=%s\nexpires=%d\n" % (clean(key), time.time() + hours * 3600)
        if start:  # a process, not a session id: the hook also checks it's the same process
            text += "start=%s\n" % start
        if key in _SENT_IDS:
            text += "id=%s\n" % clean(_SENT_IDS[key])
        _write_atomic(os.path.join(d, name), text.encode("utf-8"), 0o600)
    except (OSError, ValueError):
        pass


def _move_failed(path: str) -> None:
    """Keep a refused entry in outbox/failed/ for a person to look at. Never through a
    symlink out of the outbox: then the entry is just deleted."""
    d = os.path.join(os.path.dirname(path), "failed")
    try:
        os.makedirs(d, mode=0o700, exist_ok=True)
        if os.path.islink(d) or not os.path.isdir(d):
            raise OSError("outbox/failed is not a plain directory")
        os.replace(path, os.path.join(d, os.path.basename(path)))
    except OSError:
        try:
            os.remove(path)
        except OSError:
            pass


