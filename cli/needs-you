    # -- flush schedule ----------------------------------------------------
    def schedule(self) -> None:
        if sys.platform == "darwin":
            plist = os.path.join(self.home, "Library", "LaunchAgents", FLUSH_LABEL + ".plist")
            try:
                import plistlib
                with open(plist, "rb") as fh:
                    data = plistlib.load(fh)
            except OSError:
                self.add("flush schedule", "WARN", "no LaunchAgent %s, so queued items wait for the next post"
                         % _tilde(plist), _rerun(""))
                return
            except Exception:
                self.add("flush schedule", "WARN", "%s is not a valid plist" % _tilde(plist), _rerun(""))
                return
            args = data.get("ProgramArguments") or []
            prog = args[0] if args else ""
            if prog and not os.path.exists(prog):
                self.add("flush schedule", "WARN", "%s runs %s, which doesn't exist" % (_tilde(plist), _tilde(prog)),
                         _rerun(""))
                return
            self.add("flush schedule", "OK", "LaunchAgent %s (every %ss)" % (FLUSH_LABEL, data.get("StartInterval", "?")))
            return
        import shutil
        import subprocess
        if not shutil.which("crontab"):
            self.add("flush schedule", "WARN", "no crontab on this machine, so queued items wait for the next post",
                     "run `%s -q flush` every 5 minutes some other way (a systemd timer)" % _sh(cli_path()))
            return
        try:
            r = subprocess.run(["crontab", "-l"], capture_output=True, text=True, timeout=5)
            text = r.stdout if r.returncode == 0 else ""
        except (OSError, subprocess.SubprocessError):
            text = ""
        if crontab_has_flush(text):
            self.add("flush schedule", "OK", "crontab line tagged %s" % CRON_TAG)
        else:
            self.add("flush schedule", "WARN", "no crontab line tagged %s, so queued items wait for the next post"
                     % CRON_TAG, "run: (crontab -l 2>/dev/null; echo %s) | crontab -"
                     % shlex.quote("*/5 * * * * %s -q flush >/dev/null 2>&1 %s" % (shlex.quote(cli_path()), CRON_TAG)))


def _doctor_update(self: "Doctor") -> None:
    """Local versions against the first hub's /dl/manifest.json (read-only)."""
    paths = installed_paths()
    local = "CLI %s; hook %s; skill %s; orca %s" % (
        VERSION, _stamp(paths["needs-you-hook.sh"]) or "none", _stamp(paths["SKILL.md"]) or "none",
        _stamp(paths["orca-snippet.md"]) or "none")
    auto = _setting(self.cfg, "NEEDS_YOU_AUTO_UPDATE").strip().lower() in _ON
    st = _read_state()
    when = st.get("auto_ok_at") or st.get("last_update_at")
    tail = "; daily auto-update %s" % ("on (NEEDS_YOU_AUTO_UPDATE=1)" if auto else "off")
    if when:
        tail += ", last %s ago" % _age(time.time() - float(when))
    if not self.cfg.urls:
        self.add("update", "INFO", local + tail)
        return
    errors: List[str] = []
    got = fetch_manifest(self.cfg, errors)
    if got is None:
        self.add("update", "INFO", local + tail + "; no hub served /dl/manifest.json (%s)" % "; ".join(errors)[:200])
        return
    hub, manifest = got
    try:
        changes, notes = plan_update(manifest)
    except UpdateRefused as e:
        self.add("update", "WARN", local + tail + "; the hub's manifest is refused: %s" % e,
                 "tell the person, and don't force it; needs-you update --check shows the details")
        return
    detail = "%s; hub %s serves %s%s" % (local, hub.url, clean(manifest.get("version")), tail)
    if changes:
        self.add("update", "WARN", detail + "; newer on the hub: " + ", ".join(c.get("label") or c["file"] for c in changes),
                 "run: needs-you update")
    else:
        self.add("update", "OK", detail + ("; " + "; ".join(notes) if notes else ""))


Doctor.update = _doctor_update  # type: ignore[attr-defined]


# ---------------------------------------------------------------------------
# The MCP server and the agent instructions (the invite installer's --mcp and
# --agent-instructions). Same rules as the hooks: never write through a symlink, back up a
# file before changing it, change nothing when it is already right, skip one agent with a
# warning and go on, and `uninstall-hooks` takes out exactly what was put in.
# ---------------------------------------------------------------------------

MCP_NAME = "needs-you"      # the server's name in every client's config (Gemini: no "_" in it)
MCP_FILE = "needs-you-mcp"  # /dl/needs_you_mcp.py, installed next to the CLI
MCP_DL = "needs_you_mcp.py"
USAGE_FILE = "needs-you-usage"  # /dl/needs-you-usage, installed next to the CLI (--usage)
MCP_AGENTS = ("claude", "codex", "gemini", "opencode", "copilot", "cursor")
AGENT_LABELS = {"claude": "Claude Code", "codex": "Codex", "gemini": "Gemini CLI", "opencode": "opencode",
                "copilot": "Copilot CLI", "cursor": "Cursor"}
CODEX_MCP_BEGIN = "# >>> needs-you MCP server"
CODEX_MCP_END = "# <<< needs-you MCP server"
INSTR_DL = "agent-instructions.md"
INSTR_AGENTS = ("codex", "gemini", "opencode")
INSTR_BEGIN = "<!-- needs-you:begin"
INSTR_END = "<!-- needs-you:end"


def mcp_server_path() -> str:
