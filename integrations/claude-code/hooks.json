{
  "_needs_you_version": "0.2.1",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input|quota_auto_resume_disabled",
        "hooks": [
          { "type": "command", "command": "\"$HOME/.claude/hooks/needs-you-hook.sh\" notify", "async": true, "timeout": 30 }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "^(?!AskUserQuestion$)",
        "hooks": [
          { "type": "command", "command": "\"$HOME/.claude/hooks/needs-you-hook.sh\" notify", "async": true, "timeout": 30 }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          { "type": "command", "command": "\"$HOME/.claude/hooks/needs-you-hook.sh\" ask", "timeout": 3660 }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          { "type": "command", "command": "\"$HOME/.claude/hooks/needs-you-hook.sh\" notify", "async": true, "timeout": 30 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "\"$HOME/.claude/hooks/needs-you-hook.sh\" resolve", "async": true, "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "\"$HOME/.claude/hooks/needs-you-hook.sh\" resolve", "async": true, "timeout": 30 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$HOME/.claude/hooks/needs-you-hook.sh\" stop", "async": true, "timeout": 30 }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"$HOME/.claude/hooks/needs-you-hook.sh\" start", "async": true, "timeout": 30 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "\"$HOME/.claude/hooks/needs-you-hook.sh\" end", "async": true, "timeout": 30 }
        ]
      }
    ]
  }
}
