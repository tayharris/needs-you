<?xml version="1.0" encoding="UTF-8"?>
<!-- LaunchAgent for needs-you-expiry on a Mac: once a day at 09:17 (or at the next wake).
     Replace /Users/me with your home directory, then:
       cp io.needs-you.expiry.plist ~/Library/LaunchAgents/
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/io.needs-you.expiry.plist
     Stop it: launchctl bootout gui/$(id -u)/io.needs-you.expiry -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.needs-you.expiry</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/me/.local/bin/needs-you-expiry</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/me/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>17</integer>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardErrorPath</key>
  <string>/Users/me/Library/Logs/needs-you-expiry.log</string>
</dict>
</plist>
