# Cards
# ---------------------------------------------------------------------------

def _title(prefix: str, subject: str) -> str:
    room = TITLE_MAX - len(prefix) - 2
    return prefix + (": " + safe_text(subject, min(SUBJECT_MAX, room)) if subject and room > 10 else "")


def card(cfg: Config, repo: str, key_rest: str, title: str, priority: str, src: str,
         links: List[Tuple[str, str]], steps: Optional[List[Dict[str, Any]]] = None,
         body: str = "") -> Dict[str, Any]:
    ctx = cfg.context(repo)
    c: Dict[str, Any] = {"key": KEY_SAFE.sub("-", "%s:gh:%s" % (ctx, key_rest))[:200], "title": title[:TITLE_MAX],
                         "priority": priority, "context": ctx, "project": repo, "src": src,
                         "links": [[label, url] for label, url in links if https(url)][:6]}
    if steps:
        c["steps"] = steps
    if body:
        c["body"] = body
    return c


def step(text: str, label: str = "", url: str = "") -> Dict[str, Any]:
    s: Dict[str, Any] = {"text": text}
    if label and https(url):
        s["link"] = {"label": label, "url": url}
    return s


_CI_TITLE = re.compile(r"\bfor (?P<branch>\S+) branch\s*$", re.I)


def notification_cards(cfg: Config, threads: List[Dict[str, Any]], review_set: Optional[Set[Tuple[str, int]]],
                       my_heads: Set[Tuple[str, str]]) -> List[Dict[str, Any]]:
    out: List[Dict[str, Any]] = []
    latest_ci: Dict[str, Dict[str, Any]] = {}
    for t in threads:
        repo, reason = t["repo"], t["reason"]
        if not cfg.watched(repo):
            continue
        n = t.get("number")
        ref = "%s#%s" % (repo, n)
        page = "%s/%s/%s" % (t["repo_url"], t.get("path", "pull"), n) if n else t["repo_url"]
        if reason == "review_requested" and "review" in cfg.reasons and n and t.get("path") == "pull":
            if review_set is not None and (repo.lower(), n) not in review_set:
                continue  # already reviewed, or the PR closed
            out.append(card(cfg, repo, "%s:review" % ref, _title("Review %s" % ref, t["title"]), "normal",
                            "both", [("PR", page)],
                            [step("Read the diff", "Files", page + "/files"),
                             step("Approve, or request changes", "Review", page + "/files")]))
        elif reason == "approval_requested" and "deploy" in cfg.reasons:
            rid = t.get("run_id") or t["id"]
            run = "%s/actions/runs/%s" % (t["repo_url"], t["run_id"]) if t.get("run_id") else t["repo_url"] + "/actions"
            out.append(card(cfg, repo, "deploy:%s:%s" % (repo, rid), _title("Approve the deploy: %s" % repo, t["title"]),
                            "urgent", "notif", [("Run", run)],
                            [step("Open the run and choose **Review deployments**", "Run", run),
                             step("Approve or reject the deployment")]))
        elif reason == "ci_activity" and "ci" in cfg.reasons:
            m = _CI_TITLE.search(t["title"])
            if not m:
                continue
            branch = m.group("branch")
            if "checks" in cfg.reasons and (repo.lower(), branch) in my_heads:
                continue  # the PR's own "Fix failing checks" card covers it
            key = "%s:ci:%s" % (repo, branch)
            prev = latest_ci.get(key)
            if prev is None or t["updated_at"] >= prev["updated_at"]:
                latest_ci[key] = dict(t, branch=branch)
        elif reason in ("mention", "team_mention") and "mention" in cfg.reasons and n:
            out.append(card(cfg, repo, "%s:mention" % ref, _title("You were mentioned in %s" % ref, t["title"]),
                            "low", "notif", [("Open", page)]))
        elif reason == "assign" and "assign" in cfg.reasons and n:
            out.append(card(cfg, repo, "%s:assign" % ref, _title("Assigned to you: %s" % ref, t["title"]),
                            "low", "notif", [("Open", page)]))
    for key, t in sorted(latest_ci.items()):
        if not re.search(r"\bfailed\b", t["title"], re.I):
            continue  # the latest run on that branch didn't fail
        branch = safe_text(t["branch"], 60)
        runs = "%s/actions?query=%s" % (t["repo_url"], urllib.parse.quote("branch:" + t["branch"], safe=""))
        out.append(card(cfg, t["repo"], key, _title("CI failed on %s: %s" % (branch, t["repo"]), t["title"]),
                        "normal", "both", [("Runs", runs)]))
    return out


def _rollup(pr: Dict[str, Any]) -> Tuple[Optional[str], List[Tuple[str, str]]]:
    try:
        roll = pr["commits"]["nodes"][0]["commit"]["statusCheckRollup"]
    except (KeyError, IndexError, TypeError):
        roll = None
    if not roll:
        return None, []
    failing = []
    for c in ((roll.get("contexts") or {}).get("nodes") or []):
        if not isinstance(c, dict):
            continue
        if c.get("__typename") == "CheckRun" and c.get("conclusion") in FAILING_CHECK:
            failing.append((safe_text(c.get("name"), 60), https(c.get("detailsUrl"))))
        elif c.get("__typename") == "StatusContext" and c.get("state") in FAILING_CHECK:
            failing.append((safe_text(c.get("context"), 60), https(c.get("targetUrl"))))
    return roll.get("state"), failing


def pr_cards(cfg: Config, prs: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    out: List[Dict[str, Any]] = []
    for pr in prs:
        repo = str((pr.get("repository") or {}).get("nameWithOwner") or "")
        if not repo or pr.get("isDraft") or not cfg.watched(repo):
            continue
        n = pr["number"]
        ref = "%s#%s" % (repo, n)
        url = https(pr.get("url")) or "https://github.com/%s/pull/%s" % (repo, n)
        title = pr.get("title")
        state, failing = _rollup(pr)
        decision, mergeable = pr.get("reviewDecision"), pr.get("mergeable")
        if mergeable == "CONFLICTING" and "conflict" in cfg.reasons:
            out.append(card(cfg, repo, "%s:conflict" % ref, _title("Resolve conflicts in %s" % ref, title), "normal",
                            "pr", [("Conflicts", url + "/conflicts"), ("PR", url)],
                            [step("Resolve the conflicts (on GitHub or locally)", "Conflicts", url + "/conflicts"),
                             step("Push, and wait for the checks")]))
        if state in ("FAILURE", "ERROR") and "checks" in cfg.reasons:
            steps = [step("Read **%s**" % md_escape(name), "Logs", link or url + "/checks")
                     for name, link in failing[:3]]
            if len(failing) > 3:
                steps.append(step("%d more failing" % (len(failing) - 3), "Checks", url + "/checks"))
            steps.append(step("Push a fix, or re-run a flaky check"))
            out.append(card(cfg, repo, "%s:checks" % ref, _title("Fix failing checks on %s" % ref, title), "normal",
                            "pr", [("Checks", url + "/checks"), ("PR", url)], steps))
        if decision == "CHANGES_REQUESTED" and "changes" in cfg.reasons:
            out.append(card(cfg, repo, "%s:changes" % ref, _title("Changes requested on %s" % ref, title), "normal",
                            "pr", [("PR", url)],
                            [step("Read the review", "Review", url), step("Push the changes"),
                             step("Re-request review", "PR", url)]))
        if (decision == "APPROVED" and state in (None, "SUCCESS") and mergeable == "MERGEABLE"
                and "merge" in cfg.reasons):
            out.append(card(cfg, repo, "%s:merge" % ref, _title("Merge %s" % ref, title), "normal", "pr",
                            [("PR", url)], body="Approved, and every check is green."))
    return out


# ---------------------------------------------------------------------------
# Posting through the CLI
# ---------------------------------------------------------------------------

def track_mine(cfg: Config, tracked: Dict[str, Any], prs: List[Dict[str, Any]], now: float) -> Set[str]:
    """Remember each of your open PRs (title, URL, when last seen open). Returns the refs
    that were tracked but aren't in this run's open list: the ones to look up."""
    listed: Set[str] = set()
    for pr in prs:
        repo = str((pr.get("repository") or {}).get("nameWithOwner") or "")
        owner, _, name = repo.partition("/")
        if not (REPO_PART.match(owner) and REPO_PART.match(name)) or not cfg.watched(repo):
            continue
        if not isinstance(pr.get("number"), int):
            continue
        ref = "%s#%d" % (repo, pr["number"])
        listed.add(ref)
        tracked[ref] = {"t": safe_text(pr.get("title"), 200), "u": https(pr.get("url")), "seen": now}
    return {ref for ref in tracked if ref not in listed}


def merged_card(cfg: Config, ref: str, info: Dict[str, Any], pr: Dict[str, Any]) -> Dict[str, Any]:
    repo = ref.rpartition("#")[0]
    url = https(pr.get("url")) or info.get("u") or "https://github.com/%s/pull/%s" % (repo, ref.rpartition("#")[2])
    return card(cfg, repo, "%s:merged" % ref, _title("Merged %s" % ref, pr.get("title") or info.get("t") or ""),
                "low", "merged", [("PR", url)])


def check_merged(cfg: Config, state: Dict[str, Any], prs: List[Dict[str, Any]], now: float,
                 verbose: bool) -> List[Dict[str, Any]]:
    """Done cards for your PRs that left the open list because they merged. A PR that
    closed unmerged, or that GitHub no longer shows us, is forgotten; one still open (it
    went quiet for NEEDS_YOU_GITHUB_PR_DAYS, or is past the 50 the search returns) is kept
    until it hasn't been seen open for that long."""
    tracked = state.get("mine") if isinstance(state.get("mine"), dict) else {}
    tracked = {k: v for k, v in tracked.items() if isinstance(v, dict)}
    gone = sorted(track_mine(cfg, tracked, prs, now), key=lambda r: -float(tracked[r].get("seen") or 0))
    out: List[Dict[str, Any]] = []
    if gone:
        batch = gone[:MERGED_LOOKUPS]
        try:
            states = fetch_pr_states(cfg, batch)
        except GhError as e:
            warn("merged lookup: %s" % e)  # keep tracking; try again next run
            states = {}
        for ref, pr in states.items():
            if pr is None or pr.get("state") == "CLOSED":
                tracked.pop(ref, None)
            elif pr.get("merged") or pr.get("state") == "MERGED":
                if cfg.watched(ref.rpartition("#")[0]):
                    out.append(merged_card(cfg, ref, tracked[ref], pr))
                tracked.pop(ref, None)
            elif now - float(tracked[ref].get("seen") or 0) > cfg.pr_days * 86400:
                tracked.pop(ref, None)
        if verbose:
            warn("merged: %d PRs left the open list, %d merged" % (len(gone), len(out)))
    state["mine"] = tracked
    return out


def card_hash(c: Dict[str, Any]) -> str:
    keep = {k: c.get(k) for k in ("title", "priority", "context", "links", "steps", "body", "project")}
    return hashlib.sha256(json.dumps(keep, sort_keys=True).encode("utf-8")).hexdigest()[:16]


def post(cfg: Config, c: Dict[str, Any], expires_h: Optional[float]) -> bool:
    argv = [cfg.cli, "-q", "add", "--key=" + c["key"], "--title=" + c["title"], "--priority=" + c["priority"],
            "--context=" + c["context"], "--agent=github", "--project=" + c["project"]]
    if expires_h:
        argv.append("--expires-in=%.3f" % expires_h)
    for label, url in c.get("links") or []:
        argv.append("--link=%s=%s" % (label, url))
    if c.get("steps"):
        argv.append("--steps-json=" + json.dumps(c["steps"]))
    if c.get("body"):
        argv.append("--body=" + c["body"])
    return _cli(argv)


def post_done(cfg: Config, c: Dict[str, Any]) -> bool:
    argv = [cfg.cli, "-q", "done", "--key=" + c["key"], "--title=" + c["title"], "--priority=" + c["priority"],
            "--context=" + c["context"], "--agent=github", "--project=" + c["project"]]
    for label, url in c.get("links") or []:
        argv.append("--link=%s=%s" % (label, url))
    return _cli(argv)


def resolve(cfg: Config, key: str) -> bool:
    return _cli([cfg.cli, "-q", "resolve", "--key=" + key])


def _cli(argv: List[str]) -> bool:
    try:
        r = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.SubprocessError) as e:
        warn("cannot run needs-you: %s" % type(e).__name__)
        return False
    if r.returncode != 0:
        warn("needs-you %s exited %d: %s" % (argv[2], r.returncode, safe_text(r.stderr, 300)))
        return False
    return True


# ---------------------------------------------------------------------------
# One run
# ---------------------------------------------------------------------------

def run_once(cfg: Config, state_path: str, dry_run: bool, verbose: bool) -> None:
    state = load_state(state_path)
    now = time.time()
    failed: Set[str] = set()
    errors: List[str] = []

    # 1. Notifications (conditional, at most once per X-Poll-Interval).
    threads = state.get("threads") if isinstance(state.get("threads"), list) else []
    poll = max(MIN_POLL, int(state.get("poll_interval") or MIN_POLL))
    if now - float(state.get("notif_at") or 0) >= poll - 5:
        full = now - float(state.get("full_at") or 0) >= FULL_REFRESH_S
        try:
            status, headers, body = fetch_notifications(cfg, "" if full else str(state.get("last_modified") or ""))
            state["notif_at"] = now
            try:
                state["poll_interval"] = max(MIN_POLL, int(headers.get("x-poll-interval") or MIN_POLL))
            except ValueError:
                pass
            if status == 200:
                threads = [r for r in (thread_record(t) for t in body if isinstance(t, dict)) if r]
                state["threads"] = threads
                state["full_at"] = now if full else state.get("full_at", now)
                if headers.get("last-modified"):
                    state["last_modified"] = headers["last-modified"]
            if verbose:
                warn("notifications: HTTP %d, %d unread threads" % (status, len(threads)))
        except GhError as e:
            failed.add("notif")
            errors.append(str(e))
    elif verbose:
        warn("notifications: skipped (X-Poll-Interval %ds)" % poll)

    # 2. My PRs and the PRs waiting on my review.
    prs: List[Dict[str, Any]] = []
    review_set: Optional[Set[Tuple[str, int]]] = None
    if cfg.reasons & {"merge", "changes", "conflict", "checks", "review", "ci", "merged"}:
        try:
            data = fetch_prs(cfg)
            prs = data["mine"]
            review_set = {(str((n.get("repository") or {}).get("nameWithOwner") or "").lower(), n["number"])
                          for n in data["review"]}
            if verbose:
                warn("PRs: %d open by you, %d waiting on your review" % (len(prs), len(review_set)))
        except GhError as e:
            failed.add("pr")
            if str(e) not in errors:
                errors.append(str(e))
    if failed & {"notif", "pr"}:
        failed.add("both")  # cards that need both lists (review filter, CI dedupe)

    my_heads = {(str((p.get("repository") or {}).get("nameWithOwner") or "").lower(), str(p.get("headRefName") or ""))
                for p in prs}
    posted: Dict[str, Any] = state.get("posted") if isinstance(state.get("posted"), dict) else {}
    cards = (notification_cards(cfg, threads, review_set, my_heads) if "notif" not in failed else []) \
        + (pr_cards(cfg, prs) if "pr" not in failed else [])
    # Urgent first, then what's already on the panel, so the cap never churns cards.
    rank = {"urgent": 0, "normal": 1, "low": 2}
    cards = sorted((c for c in cards if c["src"] not in failed),
                   key=lambda c: (rank.get(c["priority"], 3), c["key"] not in posted, c["key"]))
    desired: Dict[str, Dict[str, Any]] = {}
    for c in cards:
        if c["key"] in desired:
            continue
        if len(desired) >= cfg.max_cards:
            if verbose:
                warn("over NEEDS_YOU_GITHUB_MAX_CARDS=%d: skipped %s" % (cfg.max_cards, c["key"]))
            continue
        desired[c["key"]] = c

    # 3. One card if gh keeps failing (one stable key, posted once, never one per run).
    fails = int(state.get("fails") or 0) + 1 if errors else 0
    state["fails"] = fails
    health_key = "%s:gh:%s:poller-failing" % (cfg.default_context, KEY_SAFE.sub("-", cfg.host))
    if errors:
        warn("; ".join(errors))
        if fails >= FAILS_BEFORE_CARD:
            desired[health_key] = {
                "key": health_key, "title": "GitHub alerts stopped on %s: check gh" % cfg.host, "priority": "low",
                "context": cfg.default_context, "project": "github", "src": "health", "links": [],
                "body": "`needs-you-github` on `%s` can't read GitHub through `gh` (the error is in its log). "
                        "Run `gh auth status` there." % cfg.host}

    # 4. Post new/changed/renewed, resolve cleared.
    if not dry_run and not cfg.cli:
        warn("needs-you CLI not found (set NEEDS_YOU_BIN); nothing posted")
        return
    # Your PRs that merged since the last run: one done card each, posted once and never
    # tracked in `posted` (it expires on its own after 24 h; nothing resolves it).
    if "merged" in cfg.reasons and "pr" not in failed:
        for c in check_merged(cfg, state, prs, now, verbose):
            if dry_run:
                print("done %s [%s] %s" % (c["key"], c["priority"], c["title"]))
            elif not post_done(cfg, c):
                warn("could not post %s" % c["key"])
    elif "merged" not in cfg.reasons:
        state.pop("mine", None)
    expires_h = 3 * cfg.interval_min / 60.0
    backlog = outbox_has_backlog()
    for key, c in sorted(desired.items()):
        h = card_hash(c)
        prev = posted.get(key) or {}
        changed = prev.get("h") != h
        if not changed and (backlog or (c["src"] == "health" and prev)):
            continue  # hub unreachable: don't fill the outbox with renewals
        if dry_run:
            print("%s %s [%s] %s" % ("post" if changed else "renew", key, c["priority"], c["title"]))
            continue
        if post(cfg, c, None if c["src"] == "health" else expires_h):
            posted[key] = {"h": h, "t": now, "src": c["src"]}
    for key in sorted(set(posted) - set(desired)):
        if (posted[key] or {}).get("src") in failed:
            continue  # couldn't look: leave it to its expiry
        if dry_run:
            print("resolve %s" % key)
            continue
        if resolve(cfg, key):
            del posted[key]
    if not dry_run:
        state["posted"] = posted
        save_state(state_path, state)


def main(argv: Optional[List[str]] = None) -> int:
    p = argparse.ArgumentParser(prog="needs-you-github", description=__doc__.split("\n")[0])
    p.add_argument("--dry-run", action="store_true", help="print what would be posted; change nothing")
    p.add_argument("-v", "--verbose", action="store_true")
    p.add_argument("--state", help="state file (default ~/.local/state/needs-you/github.json)")
    args = p.parse_args(argv)
    path = args.state or os.path.join(state_base(), "needs-you", "github.json")
    try:
        run_once(Config(), path, args.dry_run, args.verbose)
    except Exception as e:  # never fail the scheduler: one line, exit 0
        warn("unexpected error: %s: %s" % (type(e).__name__, safe_text(e, 200)))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
