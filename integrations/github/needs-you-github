ALL_REASONS = ("review", "deploy", "ci", "mention", "assign", "merge", "changes", "conflict", "checks", "merged")
MERGED_LOOKUPS = 30  # PRs looked up per run (one GraphQL call); the rest wait for the next run
MIN_POLL = 60
FULL_REFRESH_S = 30 * 60
FAILS_BEFORE_CARD = 3
TITLE_MAX = 100
SUBJECT_MAX = 70
KEY_SAFE = re.compile(r"[^A-Za-z0-9._:/@#+=-]")
FAILING_CHECK = ("FAILURE", "TIMED_OUT", "STARTUP_FAILURE", "ACTION_REQUIRED", "ERROR")

GRAPHQL = """
query($mine: String!, $review: String!) {
  mine: search(query: $mine, type: ISSUE, first: 50) {
    nodes { ... on PullRequest {
      number title url isDraft reviewDecision mergeable headRefName
      repository { nameWithOwner url }
      commits(last: 1) { nodes { commit { statusCheckRollup { state
        contexts(first: 50) { nodes { __typename
          ... on CheckRun { name conclusion status detailsUrl }
          ... on StatusContext { context state targetUrl } } } } } } }
    } }
  }
  review: search(query: $review, type: ISSUE, first: 100) {
    nodes { ... on PullRequest { number repository { nameWithOwner } } }
  }
}
"""
MINE_Q = "is:pr is:open author:@me archived:false updated:>=%s"
REPO_PART = re.compile(r"^[A-Za-z0-9_.-]+$")
REVIEW_Q = "is:pr is:open review-requested:@me archived:false"


