def warn(msg: str) -> None:
    sys.stderr.write("needs-you-github: %s\n" % msg)


def read_env_file(path: str) -> Dict[str, str]:
    out: Dict[str, str] = {}
    try:
        with open(path, "r", encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                if line.startswith("export "):
                    line = line[len("export "):].strip()
                k, v = line.split("=", 1)
                v = v.strip()
                if len(v) >= 2 and v[0] == v[-1] and v[0] in "'\"":
                    v = v[1:-1]
                out[k.strip()] = v
    except OSError:
        pass
    return out


def state_base() -> str:
    return os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")


def outbox_has_backlog() -> bool:
    d = os.environ.get("NEEDS_YOU_OUTBOX") or os.path.join(state_base(), "needs-you", "outbox")
    try:
        return any(n.endswith(".json") and not n.startswith(".") for n in os.listdir(d))
    except OSError:
        return False


def _csv(value: str) -> List[str]:
    return [p.strip() for p in (value or "").split(",") if p.strip()]


class Config:
    def __init__(self) -> None:
        if os.environ.get("NEEDS_YOU_CONFIG"):
            path = os.environ["NEEDS_YOU_CONFIG"]
        else:
            base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
            path = os.path.join(base, "needs-you", "env")
        f = read_env_file(path)
        get = lambda k, d="": os.environ.get(k) or f.get(k) or d  # noqa: E731
        self.include = [s.lower() for s in _csv(get("NEEDS_YOU_GITHUB_INCLUDE"))]
        self.exclude = [s.lower() for s in _csv(get("NEEDS_YOU_GITHUB_EXCLUDE"))]
        ctx = get("NEEDS_YOU_DEFAULT_CONTEXT", "work").strip().lower()
        self.default_context = ctx if ctx in ("work", "personal") else "work"
        self.contexts: Dict[str, str] = {}
        for pair in _csv(get("NEEDS_YOU_GITHUB_CONTEXTS")):
            owner, _, c = pair.partition("=")
            if c.strip().lower() in ("work", "personal"):
                self.contexts[owner.strip().lower()] = c.strip().lower()
        raw = _csv(get("NEEDS_YOU_GITHUB_REASONS"))
        if raw and all(r.startswith("-") for r in raw):
            off = {r[1:].lower() for r in raw}
            self.reasons = {r for r in ALL_REASONS if r not in off}
        elif raw:
            self.reasons = {r.lower() for r in raw if r.lower() in ALL_REASONS}
        else:
            self.reasons = set(ALL_REASONS)
        try:
            self.interval_min = max(1.0, float(get("NEEDS_YOU_GITHUB_INTERVAL", "5")))
        except ValueError:
            self.interval_min = 5.0
        try:
            self.pr_days = max(1, int(get("NEEDS_YOU_GITHUB_PR_DAYS", "14")))
        except ValueError:
            self.pr_days = 14
        try:
            self.max_cards = max(1, int(get("NEEDS_YOU_GITHUB_MAX_CARDS", "20")))
        except ValueError:
            self.max_cards = 20
        self.gh = get("NEEDS_YOU_GITHUB_GH") or shutil.which("gh") or ""
        local = os.path.join(os.path.expanduser("~"), ".local", "bin", "needs-you")
        self.cli = get("NEEDS_YOU_BIN") or shutil.which("needs-you") or (local if os.path.exists(local) else "")
        self.host = get("NEEDS_YOU_HOST") or socket.gethostname().split(".")[0]

    def watched(self, repo: str) -> bool:
        repo = repo.lower()
        owner = repo.split("/", 1)[0]
        if repo in self.exclude or owner in self.exclude:
            return False
        return not self.include or repo in self.include or owner in self.include

    def context(self, repo: str) -> str:
        return self.contexts.get(repo.split("/", 1)[0].lower(), self.default_context)


_STRIP = re.compile("[\u0000-\u001f\u007f-\u009f​-‏‪-‮⁠-⁩﻿]")


# --- needs-you redaction (begin) ---
# Token-shaped text in anything untrusted that reaches a card becomes "[redacted]". The same
# block, byte for byte, is in integrations/claude-code/needs-you-hook.sh, cli/needs-you,
# integrations/mcp/needs_you_mcp.py and integrations/github/needs-you-github
# (tests/test_redaction.py checks). Best effort: a secret that looks like a word isn't caught.
# Every pattern runs in linear time on any input (tests/test_redaction.py times them): each one
# starts on a literal and never backtracks over a run it has to give back.
REDACTED = "[redacted]"
# A %XX escape before a key (x%3Dghp_..., %22ghp_...) counts as a word's start.
_SECRET_RAW = re.compile(r"(?:\b|(?<=%[0-9A-Fa-f]{2}))"
                         r"(?:gh[pousr]_[A-Za-z0-9]{16,}|github_pat_\w{16,}|sk-[A-Za-z0-9_-]{16,}"
                         r"|xox[abpr]-[\w-]{10,}|(?:AKIA|ASIA)[0-9A-Z]{16}|ny[ip]?_[A-Za-z0-9_-]{8,}"
                         r"|glpat-[\w-]{16,}|AIza[\w-]{30,}|[sr]k_(?:live|test)_\w{16,}|npm_\w{30,}"
                         r"|hf_\w{30,}|glptt-[\w-]{16,}|xapp-[\w-]{10,}|ya29\.[\w-]{20,})")
# A webhook URL whose path is its secret: the host and the path's start stay.
_WEBHOOK = re.compile(r"(hooks\.slack\.com/(?:services|workflows|triggers)/"
                      r"|discord(?:app)?\.com/api/(?:v\d+/)?webhooks/)[\w/-]+")
# A JWT: the whole run is taken greedily, then checked (a failed match never rescans the run).
_JWT_RUN = re.compile(r"\beyJ[\w.-]+")
_JWT = re.compile(r"eyJ[\w-]{10,}\.[\w-]{10,}\.[\w-]*")
# A name ending in a secret's keyword, then its value (`:`, `=`, `=>`, or URL-encoded %3A/%3D).
# Only the keyword is matched, never the name's prefix (PGPASSWORD, X_API_KEY, client_secret).
# Keywords other than "password" start a word or follow _ or - (DB_PASS, not bypass).
_SECRET_KV = re.compile(r"(?i)(password|(?<![a-z0-9])(?:passwd|pwd|pw|pass(?:phrase)?|token|secret"
                        r"|(?:api|access|secret|private)[_-]?key|auth|credentials?|sig(?:nature)?))"
                        r"([\"']?\s*(?:=>|[:=]|%3[ad])\s*)(\"[^\"]*\"|'[^']*'|\S+)")
# A command line's --password VALUE (with a space): _flag() checks the keyword ends a --flag.
_SECRET_FLAG = re.compile(r"(?i)(?<=-)(password|passwd|token|secret|api-key)([ \t]+)(?!-)(\S+)")
_SECRET_AUTH = re.compile(r"(?i)\b(bearer|basic|token)(\s+)[A-Za-z0-9._~+/=-]{8,}")
_PEM = re.compile(r"-----BEGIN [A-Z0-9 ]*PRIVATE KEY(?: BLOCK)?-----.*?"
                  r"(?:-----END [A-Z0-9 ]*PRIVATE KEY(?: BLOCK)?-----|\Z)", re.S)
_LONG_HEX = re.compile(r"\b[0-9A-Fa-f]{32,}\b")
_LONG_RUN = re.compile(r"[A-Za-z0-9+/_=-]{40,}")
_SPACES = re.compile(r"(\s+)")


def _long_run(m):
    s = m.group(0)
    # base64-ish: digits and both cases, few separators (not a path or a branch name)
    if (len(re.findall(r"[-_/]", s)) <= 3 and re.search(r"[0-9]", s) and re.search(r"[a-z]", s)
            and re.search(r"[A-Z]", s)):
        return REDACTED
    return s


def _jwt(m):
    j = _JWT.match(m.group(0))
    return REDACTED + m.group(0)[j.end():] if j else m.group(0)


def _flag(m):
    i = m.start()
    while i > 0 and (m.string[i - 1].isalnum() or m.string[i - 1] in "-_"):
        i -= 1
    if m.string.startswith("--", i):
        return m.group(1) + m.group(2) + REDACTED
    return m.group(0)


def _url_creds(word):
    """scheme://user:<password>@host in one whitespace-free word: the password runs to the last
    "@" before the query, so one holding "/" or "@" goes whole (a path's "@" may go with it)."""
    parts = word.split("://")
    for i in range(1, len(parts)):
        seg = parts[i]
        end = len(seg)
        for c in "?#":
            k = seg.find(c)
            if 0 <= k < end:
                end = k
        at = seg.rfind("@", 0, end)
        colon = seg.find(":", 0, at)
        if at > 0 and 0 <= colon < at - 1 and "/" not in seg[:colon]:
            parts[i] = seg[:colon + 1] + REDACTED + seg[at:]
    return "://".join(parts)


def redact(text):
    text = _PEM.sub(REDACTED, text)
    if "://" in text:
        text = "".join(_url_creds(w) if "://" in w else w for w in _SPACES.split(text))
    text = _WEBHOOK.sub(lambda m: m.group(1) + REDACTED, text)
    text = _SECRET_RAW.sub(REDACTED, text)
    text = _JWT_RUN.sub(_jwt, text)
    text = _SECRET_KV.sub(lambda m: m.group(1) + m.group(2) + REDACTED, text)
    text = _SECRET_FLAG.sub(_flag, text)
    text = _SECRET_AUTH.sub(lambda m: m.group(1) + m.group(2) + REDACTED, text)
    text = _LONG_HEX.sub(REDACTED, text)
    return _LONG_RUN.sub(_long_run, text)
# --- needs-you redaction (end) ---


def safe_text(value: Any, limit: int) -> str:
    """Untrusted GitHub text, made fit for a card title: no control, bidi or zero-width
    characters, token-shaped text redacted, whitespace collapsed, truncated with an ellipsis."""
    s = " ".join(redact(_STRIP.sub(" ", str(value or ""))).split())
    return s if len(s) <= limit else s[:limit - 1].rstrip() + "…"


def md_escape(s: str) -> str:
    """Step text is inline markdown: an untrusted name must not become a link or emphasis."""
    return re.sub(r"([\\`*_\[\]()<>#!|~])", r"\\\1", s)


def https(url: Any) -> str:
    u = str(url or "")
    return u if u.startswith("https://") and not _STRIP.search(u) and " " not in u else ""


def load_state(path: str) -> Dict[str, Any]:
    try:
        with open(path, "r", encoding="utf-8") as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save_state(path: str, state: Dict[str, Any]) -> None:
    d = os.path.dirname(path)
    os.makedirs(d, mode=0o700, exist_ok=True)
    tmp = path + ".%d.tmp" % os.getpid()
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump(state, fh, indent=1, sort_keys=True)
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


# ---------------------------------------------------------------------------
# gh
# ---------------------------------------------------------------------------

class GhError(Exception):
    pass


def gh(cfg: Config, args: List[str]) -> subprocess.CompletedProcess:  # type: ignore[type-arg]
    if not cfg.gh:
        raise GhError("gh not found (install GitHub CLI and run `gh auth login`)")
    try:
        return subprocess.run([cfg.gh] + args, stdin=subprocess.DEVNULL, capture_output=True,
                              text=True, timeout=60)
    except (OSError, subprocess.SubprocessError) as e:
        raise GhError("cannot run gh: %s" % type(e).__name__)


def gh_error(r: subprocess.CompletedProcess) -> GhError:  # type: ignore[type-arg]
    first = (r.stderr or "").strip().splitlines()
    return GhError("gh exited %d%s" % (r.returncode, ": " + safe_text(first[0], 160) if first else ""))


def fetch_notifications(cfg: Config, since: str) -> Tuple[int, Dict[str, str], Any]:
    """(status, headers, parsed body). 304 has no body."""
    args = ["api", "-i", "/notifications?per_page=50"]
    if since:
        args[2:2] = ["-H", "If-Modified-Since: " + since]
    r = gh(cfg, args)
    out = r.stdout or ""
    head, _, body = out.replace("\r\n", "\n").partition("\n\n")
    lines = head.split("\n")
    m = re.match(r"HTTP/\S+\s+(\d{3})", lines[0]) if lines else None
    if not m:
        raise gh_error(r)
    status = int(m.group(1))
    headers = {}
    for line in lines[1:]:
        k, sep, v = line.partition(":")
        if sep:
            headers[k.strip().lower()] = v.strip()
    if status == 304:
        return status, headers, None
    if status != 200 or r.returncode != 0:
        raise gh_error(r)
    try:
        parsed = json.loads(body or "[]")
    except ValueError:
        raise GhError("gh returned notifications that aren't JSON")
    if not isinstance(parsed, list):
        raise GhError("unexpected notifications shape")
    return status, headers, parsed


def fetch_prs(cfg: Config) -> Dict[str, Any]:
    since = time.strftime("%Y-%m-%d", time.gmtime(time.time() - cfg.pr_days * 86400))
    r = gh(cfg, ["api", "graphql", "-f", "query=" + GRAPHQL, "-f", "mine=" + MINE_Q % since,
                 "-f", "review=" + REVIEW_Q])
    if r.returncode != 0:
        raise gh_error(r)
    try:
        data = json.loads(r.stdout or "{}")["data"]
        mine = data["mine"]["nodes"]
        review = data["review"]["nodes"]
    except (ValueError, KeyError, TypeError):
        raise GhError("unexpected GraphQL response")
    return {"mine": [n for n in mine if isinstance(n, dict) and n.get("number")],
            "review": [n for n in review if isinstance(n, dict) and n.get("number")]}


def fetch_pr_states(cfg: Config, refs: List[str]) -> Dict[str, Optional[Dict[str, Any]]]:
    """One GraphQL call: {ref: {"merged", "state", "title", "url"}} for each "owner/repo#N",
    or None when GitHub has no such PR for us (deleted, renamed, access lost)."""
    params, fields, args = [], [], []
    for i, ref in enumerate(refs):
        repo, _, num = ref.rpartition("#")
        owner, _, name = repo.partition("/")
        params.append("$o%d: String!, $n%d: String!, $r%d: Int!" % (i, i, i))
        fields.append("p%d: repository(owner: $o%d, name: $n%d) { pullRequest(number: $r%d) "
                      "{ merged state title url } }" % (i, i, i, i))
        args += ["-f", "o%d=%s" % (i, owner), "-f", "n%d=%s" % (i, name), "-F", "r%d=%s" % (i, num)]
    query = "query(%s) { %s }" % (", ".join(params), " ".join(fields))
    r = gh(cfg, ["api", "graphql", "-f", "query=" + query] + args)
    try:
        data = json.loads(r.stdout or "{}").get("data")
    except ValueError:
        data = None
    if not isinstance(data, dict):
        # A missing repository makes GraphQL answer with errors and a partial `data`; no
        # `data` at all is a real failure.
        raise gh_error(r) if r.returncode != 0 else GhError("unexpected GraphQL response")
    out: Dict[str, Optional[Dict[str, Any]]] = {}
    for i, ref in enumerate(refs):
        node = data.get("p%d" % i)
        pr = node.get("pullRequest") if isinstance(node, dict) else None
        out[ref] = pr if isinstance(pr, dict) else None
    return out


# ---------------------------------------------------------------------------
# Notifications -> thread records (only the fields we use, already cleaned)
# ---------------------------------------------------------------------------

_SUBJECT_URL = re.compile(r"/repos/[^/]+/[^/]+/(pulls|issues)/(\d+)$")
_RUN_URL = re.compile(r"/actions/runs/(\d+)")


def thread_record(t: Dict[str, Any]) -> Optional[Dict[str, Any]]:
    repo = t.get("repository") or {}
    subject = t.get("subject") or {}
    full = str(repo.get("full_name") or "")
    if not re.match(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", full):
        return None
    html = https(repo.get("html_url")) or "https://github.com/" + full
    rec: Dict[str, Any] = {"id": safe_text(t.get("id"), 40), "reason": safe_text(t.get("reason"), 40),
                           "type": safe_text(subject.get("type"), 40), "repo": full, "repo_url": html,
                           "title": safe_text(subject.get("title"), 200),
                           "updated_at": safe_text(t.get("updated_at"), 40)}
    url = str(subject.get("url") or "")
    m = _SUBJECT_URL.search(url)
    if m:
        rec["number"] = int(m.group(2))
        rec["path"] = "pull" if m.group(1) == "pulls" else "issues"
    m = _RUN_URL.search(url)
    if m:
        rec["run_id"] = m.group(1)
    return rec


