# systemd user service for needs-you-github; started by needs-you-github.timer.
#   mkdir -p ~/.config/systemd/user
#   cp needs-you-github.service needs-you-github.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now needs-you-github.timer
#   loginctl enable-linger "$USER"     # keep it running while you're logged out
# Logs: journalctl --user -u needs-you-github

[Unit]
Description=needs-you: GitHub notifications and my PRs

[Service]
Type=oneshot
# %h is your home directory. Add the directory holding gh if it isn't /usr/bin.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/needs-you-github
