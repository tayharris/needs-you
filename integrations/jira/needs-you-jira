def warn(msg: str) -> None:
    sys.stderr.write("needs-you-jira: %s\n" % msg)


def read_env_file(path: str) -> Dict[str, str]:
    out: Dict[str, str] = {}
    try:
        with open(path, "r", encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                if line.startswith("export "):
                    line = line[len("export "):].strip()
                k, v = line.split("=", 1)
                v = v.strip()
                if len(v) >= 2 and v[0] == v[-1] and v[0] in "'\"":
                    v = v[1:-1]
                out[k.strip()] = v
    except OSError:
        pass
    return out


def config_base() -> str:
    return os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")


def state_base() -> str:
    return os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")


def outbox_has_backlog() -> bool:
    d = os.environ.get("NEEDS_YOU_OUTBOX") or os.path.join(state_base(), "needs-you", "outbox")
    try:
        return any(n.endswith(".json") and not n.startswith(".") for n in os.listdir(d))
    except OSError:
        return False


def _csv(value: str) -> List[str]:
    return [p.strip() for p in (value or "").split(",") if p.strip()]


class ConfigError(Exception):
    pass


def check_jql_extra(raw: str) -> str:
    """NEEDS_YOU_JIRA_JQL_EXTRA, made safe to AND onto the poller's own JQL: returned in
    parentheses, so it can only narrow the search (an "OR ..." in it can't widen the
    assignee clause). A leading "AND" is dropped. Refused (ConfigError) when it has control
    characters, unbalanced quotes or parentheses (which could close ours), or ORDER BY."""
    s = (raw or "").strip()
    if re.match(r"(?i)and\s", s):
        s = s[3:].strip()
    if not s:
        return ""
    if len(s) > 500:
        raise ConfigError("NEEDS_YOU_JIRA_JQL_EXTRA is longer than 500 characters")
    if re.search(r"[\x00-\x1f\x7f]", s):
        raise ConfigError("NEEDS_YOU_JIRA_JQL_EXTRA has a control character or a line break")
    depth, quote, esc, outside = 0, "", False, []
    for ch in s:
        if quote:
            if esc:
                esc = False
            elif ch == "\\":
                esc = True
            elif ch == quote:
                quote = ""
            outside.append(" ")
            continue
        if ch in "\"'":
            quote = ch
            outside.append(" ")
            continue
        if ch == "(":
            depth += 1
        elif ch == ")":
            depth -= 1
            if depth < 0:
                raise ConfigError("NEEDS_YOU_JIRA_JQL_EXTRA closes a parenthesis it didn't open")
        outside.append(ch)
    if quote:
        raise ConfigError("NEEDS_YOU_JIRA_JQL_EXTRA has an unclosed quote")
    if depth:
        raise ConfigError("NEEDS_YOU_JIRA_JQL_EXTRA has an unclosed parenthesis")
    if re.search(r"(?i)\border\s+by\b", "".join(outside)):
        raise ConfigError("NEEDS_YOU_JIRA_JQL_EXTRA can't have ORDER BY")
    return "(" + s + ")"


def site_slug(host: str) -> str:
    """acme.atlassian.net -> acme; a Data Center host stays whole (jira.acme.example)."""
    host = host.lower().rstrip(".")
    if host.endswith(".atlassian.net") and host.count(".") == 2:
        host = host.split(".", 1)[0]
    return KEY_SAFE.sub("-", host)[:60] or "jira"


class Config:
    def __init__(self) -> None:
        if os.environ.get("NEEDS_YOU_CONFIG"):
            path = os.environ["NEEDS_YOU_CONFIG"]
        else:
            path = os.path.join(config_base(), "needs-you", "env")
        f = read_env_file(path)
        get = lambda k, d="": os.environ.get(k) or f.get(k) or d  # noqa: E731
        self.errors: List[str] = []
        ctx = get("NEEDS_YOU_DEFAULT_CONTEXT", "work").strip().lower()
        self.default_context = ctx if ctx in ("work", "personal") else "work"
        self.host = get("NEEDS_YOU_HOST") or socket.gethostname().split(".")[0]
        local = os.path.join(os.path.expanduser("~"), ".local", "bin", "needs-you")
        self.cli = get("NEEDS_YOU_BIN") or shutil.which("needs-you") or (local if os.path.exists(local) else "")

        # Site: https only, no credentials, query or fragment. Opt-in: unset means off.
        self.site_raw = get("NEEDS_YOU_JIRA_SITE").strip()
        self.enabled = bool(self.site_raw)
        self.base = ""
        self.slug = "jira"
        u = urllib.parse.urlsplit(self.site_raw) if self.site_raw else None
        if u is not None:
            try:
                hostname = u.hostname or ""
                u.port  # noqa: B018 (raises on a bad port)
            except ValueError:
                hostname = ""
            if hostname:
                self.slug = site_slug(hostname)
            if u.scheme != "https" or not hostname:
                self.errors.append("NEEDS_YOU_JIRA_SITE must be an https:// URL")
            elif u.username or u.password or u.query or u.fragment or re.search(r"[\s\x00-\x1f\x7f]", self.site_raw):
                self.errors.append("NEEDS_YOU_JIRA_SITE must be a plain https://host[/path] URL")
            else:
                self.base = "https://%s%s" % (u.netloc.lower(), u.path.rstrip("/"))

        auth = get("NEEDS_YOU_JIRA_AUTH").strip().lower()
        if not auth:
            auth = "cloud" if u is not None and (u.hostname or "").lower().endswith(".atlassian.net") else "dc"
        if auth not in ("cloud", "dc"):
            self.errors.append("NEEDS_YOU_JIRA_AUTH must be cloud or dc")
        self.auth = auth
        self.email = get("NEEDS_YOU_JIRA_EMAIL").strip()
        if self.enabled and auth == "cloud" and not self.email:
            self.errors.append("NEEDS_YOU_JIRA_EMAIL is needed for Jira Cloud (your Atlassian account email)")
        self.token_file = os.path.expanduser(get("NEEDS_YOU_JIRA_TOKEN_FILE") or
                                             os.path.join(config_base(), "needs-you", "jira-token"))
        ca = get("NEEDS_YOU_JIRA_CA_FILE").strip()
        self.ca_file = os.path.expanduser(ca) if ca else None
        if self.ca_file and not os.path.isfile(self.ca_file):
            self.errors.append("NEEDS_YOU_JIRA_CA_FILE is not a file: %s" % self.ca_file)

        raw = [EVENT_ALIASES.get(e.lower(), e.lower()) for e in _csv(get("NEEDS_YOU_JIRA_EVENTS"))]
        if raw and all(e.startswith("-") for e in raw):
            off = {EVENT_ALIASES.get(e[1:], e[1:]) for e in raw}
            self.events = {e for e in ALL_EVENTS if e not in off}
        elif raw:
            self.events = {e for e in raw if e in ALL_EVENTS}
        else:
            self.events = set(ALL_EVENTS)

        # Statuses: name (case-insensitive) -> priority or "off"; None: every status, low.
        self.statuses: Optional[Dict[str, str]] = None
        if get("NEEDS_YOU_JIRA_STATUSES"):
            self.statuses = {}
            for pair in _csv(get("NEEDS_YOU_JIRA_STATUSES")):
                name, sep, prio = pair.rpartition("=")
                prio = prio.strip().lower()
                if not sep or not name.strip() or prio not in PRIORITIES + ("off",):
                    self.errors.append("NEEDS_YOU_JIRA_STATUSES: %r isn't Name=urgent|normal|low|off"
                                       % safe_text(pair, 40))
                    continue
                self.statuses[name.strip().lower()] = prio

        # Projects: KEY -> (context, base priority); empty: every project.
        self.projects: Dict[str, Tuple[str, str]] = {}
        for pair in _csv(get("NEEDS_YOU_JIRA_PROJECTS")):
            key, _, rest = pair.partition("=")
            key = key.strip().upper()
            c, _, prio = rest.strip().lower().partition(":")
            c = c or self.default_context
            prio = prio or "low"
            if not PROJECT_KEY.match(key) or c not in ("work", "personal") or prio not in PRIORITIES:
                self.errors.append("NEEDS_YOU_JIRA_PROJECTS: %r isn't KEY=work|personal:low|normal|urgent"
                                   % safe_text(pair, 40))
                continue
            self.projects[key] = (c, prio)

        try:
            self.jql_extra = check_jql_extra(get("NEEDS_YOU_JIRA_JQL_EXTRA"))
        except ConfigError as e:
            self.jql_extra = ""
            self.errors.append(str(e))
        self.watching = get("NEEDS_YOU_JIRA_WATCHING", "0").strip().lower() in ("1", "true", "yes", "on")
        try:
            self.interval_min = max(1.0, float(get("NEEDS_YOU_JIRA_INTERVAL", "5")))
        except ValueError:
            self.interval_min = 5.0
        try:
            self.max_cards = max(1, int(get("NEEDS_YOU_JIRA_MAX_CARDS", "20")))
        except ValueError:
            self.max_cards = 20

    def scope(self) -> str:
        """What decides which issues are tracked: when it changes, new issues are taken in
        silently once instead of as "assigned" cards."""
        s = json.dumps([self.base, self.auth, sorted(self.projects), self.jql_extra, self.watching])
        return hashlib.sha256(s.encode("utf-8")).hexdigest()[:16]

    def project_rule(self, project: str) -> Tuple[str, str]:
        return self.projects.get(project, (self.default_context, "low"))

    def status_rule(self, status: str) -> Optional[str]:
        """The priority for an issue in this status, or None for no status card."""
        if self.statuses is None:
            return "low"
        rule = self.statuses.get(status.lower(), self.statuses.get("*"))
        return None if rule in (None, "off") else rule

    def jql(self, kind: str, window_min: int = MIN_WINDOW_MIN) -> str:
        who = "assignee = currentUser()"
        if self.watching:
            who = "(assignee = currentUser() OR watcher = currentUser())"
        parts = [who]
        if self.projects:
            parts.append("project in (%s)" % ", ".join(sorted(self.projects)))
        if kind == "changed":
            parts.append('updated >= "-%dm"' % window_min)
        else:
            parts.append("statusCategory != Done")
        if self.jql_extra:
            parts.append(self.jql_extra)
        return " AND ".join(parts) + " ORDER BY updated DESC"


_STRIP = re.compile("[\u0000-\u001f\u007f-\u009f​-‏‪-‮⁠-⁩﻿]")


# --- needs-you redaction (begin) ---
# Token-shaped text in anything untrusted that reaches a card becomes "[redacted]". The same
# block, byte for byte, is in integrations/claude-code/needs-you-hook.sh, cli/needs-you,
# integrations/mcp/needs_you_mcp.py, integrations/github/needs-you-github,
# integrations/linear/needs-you-linear and integrations/jira/needs-you-jira
# (tests/test_redaction.py checks). Best effort: a secret that looks like a word isn't caught.
# Every pattern runs in linear time on any input (tests/test_redaction.py times them): each one
# starts on a literal and never backtracks over a run it has to give back.
REDACTED = "[redacted]"
# A %XX escape before a key (x%3Dghp_..., %22ghp_...) counts as a word's start.
_SECRET_RAW = re.compile(r"(?:\b|(?<=%[0-9A-Fa-f]{2}))"
                         r"(?:gh[pousr]_[A-Za-z0-9]{16,}|github_pat_\w{16,}|sk-[A-Za-z0-9_-]{16,}"
                         r"|xox[abpr]-[\w-]{10,}|(?:AKIA|ASIA)[0-9A-Z]{16}|ny[ip]?_[A-Za-z0-9_-]{8,}"
                         r"|glpat-[\w-]{16,}|AIza[\w-]{30,}|[sr]k_(?:live|test)_\w{16,}|npm_\w{30,}"
                         r"|hf_\w{30,}|glptt-[\w-]{16,}|xapp-[\w-]{10,}|ya29\.[\w-]{20,}|lin_(?:api|oauth)_\w{16,})")
# A webhook URL whose path is its secret: the host and the path's start stay.
_WEBHOOK = re.compile(r"(hooks\.slack\.com/(?:services|workflows|triggers)/"
                      r"|discord(?:app)?\.com/api/(?:v\d+/)?webhooks/)[\w/-]+")
# A JWT: the whole run is taken greedily, then checked (a failed match never rescans the run).
_JWT_RUN = re.compile(r"\beyJ[\w.-]+")
_JWT = re.compile(r"eyJ[\w-]{10,}\.[\w-]{10,}\.[\w-]*")
# A name ending in a secret's keyword, then its value (`:`, `=`, `=>`, or URL-encoded %3A/%3D).
# Only the keyword is matched, never the name's prefix (PGPASSWORD, X_API_KEY, client_secret).
# Keywords other than "password" start a word or follow _ or - (DB_PASS, not bypass).
_SECRET_KV = re.compile(r"(?i)(password|(?<![a-z0-9])(?:passwd|pwd|pw|pass(?:phrase)?|token|secret"
                        r"|(?:api|access|secret|private)[_-]?key|auth|credentials?|sig(?:nature)?))"
                        r"([\"']?\s*(?:=>|[:=]|%3[ad])\s*)(\"[^\"]*\"|'[^']*'|\S+)")
# A command line's --password VALUE (with a space): _flag() checks the keyword ends a --flag.
_SECRET_FLAG = re.compile(r"(?i)(?<=-)(password|passwd|token|secret|api-key)([ \t]+)(?!-)(\S+)")
_SECRET_AUTH = re.compile(r"(?i)\b(bearer|basic|token)(\s+)[A-Za-z0-9._~+/=-]{8,}")
_PEM = re.compile(r"-----BEGIN [A-Z0-9 ]*PRIVATE KEY(?: BLOCK)?-----.*?"
                  r"(?:-----END [A-Z0-9 ]*PRIVATE KEY(?: BLOCK)?-----|\Z)", re.S)
_LONG_HEX = re.compile(r"\b[0-9A-Fa-f]{32,}\b")
_LONG_RUN = re.compile(r"[A-Za-z0-9+/_=-]{40,}")
_SPACES = re.compile(r"(\s+)")


def _long_run(m):
    s = m.group(0)
    # base64-ish: digits and both cases, few separators (not a path or a branch name)
    if (len(re.findall(r"[-_/]", s)) <= 3 and re.search(r"[0-9]", s) and re.search(r"[a-z]", s)
            and re.search(r"[A-Z]", s)):
        return REDACTED
    return s


def _jwt(m):
    j = _JWT.match(m.group(0))
    return REDACTED + m.group(0)[j.end():] if j else m.group(0)


def _flag(m):
    i = m.start()
    while i > 0 and (m.string[i - 1].isalnum() or m.string[i - 1] in "-_"):
        i -= 1
    if m.string.startswith("--", i):
        return m.group(1) + m.group(2) + REDACTED
    return m.group(0)


def _url_creds(word):
    """scheme://user:<password>@host in one whitespace-free word: the password runs to the last
    "@" before the query, so one holding "/" or "@" goes whole (a path's "@" may go with it)."""
    parts = word.split("://")
    for i in range(1, len(parts)):
        seg = parts[i]
        end = len(seg)
        for c in "?#":
            k = seg.find(c)
            if 0 <= k < end:
                end = k
        at = seg.rfind("@", 0, end)
        colon = seg.find(":", 0, at)
        if at > 0 and 0 <= colon < at - 1 and "/" not in seg[:colon]:
            parts[i] = seg[:colon + 1] + REDACTED + seg[at:]
    return "://".join(parts)


def redact(text):
    text = _PEM.sub(REDACTED, text)
    if "://" in text:
        text = "".join(_url_creds(w) if "://" in w else w for w in _SPACES.split(text))
    text = _WEBHOOK.sub(lambda m: m.group(1) + REDACTED, text)
    text = _SECRET_RAW.sub(REDACTED, text)
    text = _JWT_RUN.sub(_jwt, text)
    text = _SECRET_KV.sub(lambda m: m.group(1) + m.group(2) + REDACTED, text)
    text = _SECRET_FLAG.sub(_flag, text)
    text = _SECRET_AUTH.sub(lambda m: m.group(1) + m.group(2) + REDACTED, text)
    text = _LONG_HEX.sub(REDACTED, text)
    return _LONG_RUN.sub(_long_run, text)
# --- needs-you redaction (end) ---


def safe_text(value: Any, limit: int) -> str:
    """Untrusted Jira text, made fit for a card: no control, bidi or zero-width characters,
    token-shaped text redacted, whitespace collapsed, truncated with an ellipsis."""
    s = " ".join(redact(_STRIP.sub(" ", str(value or ""))).split())
    return s if len(s) <= limit else s[:limit - 1].rstrip() + "…"


def md_escape(s: str) -> str:
    """Body text is markdown: an untrusted status name must not become a link or emphasis."""
    return re.sub(r"([\\`*_\[\]()<>#!|~])", r"\\\1", s)


def load_state(path: str) -> Dict[str, Any]:
    try:
        with open(path, "r", encoding="utf-8") as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save_state(path: str, state: Dict[str, Any]) -> None:
    d = os.path.dirname(path)
    os.makedirs(d, mode=0o700, exist_ok=True)
    tmp = path + ".%d.tmp" % os.getpid()
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        json.dump(state, fh, indent=1, sort_keys=True)
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)


def parse_time(value: Any) -> float:
    """Jira's 2026-10-09T10:15:30.123+0000 (or +00:00, or Z) to epoch seconds; 0 if unparseable."""
    s = str(value or "").strip()
    if not s:
        return 0.0
    if s.endswith("Z"):
        s = s[:-1] + "+0000"
    m = re.match(r"^(.*[+-]\d\d):(\d\d)$", s)
    if m:
        s = m.group(1) + m.group(2)
    for fmt in ("%Y-%m-%dT%H:%M:%S.%f%z", "%Y-%m-%dT%H:%M:%S%z"):
        try:
            return datetime.datetime.strptime(s, fmt).timestamp()
        except ValueError:
            continue
    return 0.0


