# needs-you-jira every 5 minutes. Install with `crontab -e` as the user who ran the needs-you
# invite installer (~/.config/needs-you/env holds NEEDS_YOU_JIRA_SITE and friends) and who
# owns the token file (mode 600). The poller finds the CLI in ~/.local/bin by itself.
# Errors go to cron mail; the poller always exits 0.
*/5 * * * *  $HOME/.local/bin/needs-you-jira >/dev/null  # needs-you-jira
