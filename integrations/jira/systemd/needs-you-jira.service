# systemd user service for needs-you-jira; started by needs-you-jira.timer.
#   mkdir -p ~/.config/systemd/user
#   cp needs-you-jira.service needs-you-jira.timer ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now needs-you-jira.timer
#   loginctl enable-linger "$USER"     # keep it running while you're logged out
# Logs: journalctl --user -u needs-you-jira

[Unit]
Description=needs-you: changes on my Jira issues

[Service]
Type=oneshot
# %h is your home directory.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/needs-you-jira
