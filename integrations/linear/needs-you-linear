API_URL = "https://api.linear.app/graphql"
EVENTS = ("assigned", "status", "comment", "mention")
CATEGORY_EVENT = {"assignments": "assigned", "statuschanges": "status", "commentsandreplies": "comment",
                  "mentions": "mention"}
EVENT_ALIASES = dict(CATEGORY_EVENT, assigned="assigned", assign="assigned", status="status",
                     comment="comment", comments="comment", mention="mention")
# Used only when a notification has no category (older API answers).
TYPE_EVENT = {"issueassignedtoyou": "assigned", "issuestatuschanged": "status", "issuenewcomment": "comment",
              "issuemention": "mention", "issuecommentmention": "mention"}
EVENT_FLOOR = {"assigned": "low", "status": "low", "comment": "normal", "mention": "normal"}
PRIORITIES = ("low", "normal", "urgent")
DONE_TYPES = ("completed", "canceled")
FAILS_BEFORE_CARD = 3
TITLE_MAX = 100
SUBJECT_MAX = 70
PAGE = 50
MAX_PAGES = 5
TRACKED_MAX = 100
ASSIGNED_MAX = 250
OVERLAP_S = 300  # re-read this much before the last run, against clock skew
MAX_RESPONSE = 4 * 1024 * 1024
KEY_SAFE = re.compile(r"[^A-Za-z0-9._:/@#+=-]")
IDENT = re.compile(r"^[A-Za-z0-9]{1,10}-\d{1,9}$")
NOTIF_ID = re.compile(r"^[A-Za-z0-9-]{1,64}$")
