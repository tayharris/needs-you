API_KEY = re.compile(r"^[A-Za-z0-9_-]{8,200}$")
LINEAR_URL = re.compile(r"^https://linear\.app/[A-Za-z0-9][A-Za-z0-9_-]{0,63}/issue/(?P<ident>[A-Za-z0-9]{1,10}-\d{1,9})"
                        r"(?:/[A-Za-z0-9._~%-]{0,200})?(?:#[A-Za-z0-9_-]{1,100})?$")

